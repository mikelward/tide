#!/bin/bash
# Tests for tide-setup: the tidewm build, with --tidewm
#
# The harness, its fixtures and mocks are in tide-setup_testlib.

# shellcheck source=tide-setup_testlib
. "$(dirname "$0")/tide-setup_testlib"

set -e

# The commit the fake git says tidewm's main is at, and another it moves to.
main=71de000000000000000000000000000000000001
moved=71de000000000000000000000000000000000002
build() { printf '%s\n' "$T"/opt/tidewm/main-"${1:-${main:0:12}}"-*; }
ask="git ls-remote https://github.com/mikelward/tidewm.git refs/heads/main"
# The clone, which a test of a run that builds nothing checks is absent.
clone="git clone -c advice.detachedHead=false --quiet --filter=blob:none --branch main https://github.com/mikelward/tidewm.git"
# old_build NAME: an earlier finished build, current and linked.
old_build() {
    mkdir -p "$T/opt/tidewm/$1/bin"
    printf '#!/bin/sh\n' > "$T/opt/tidewm/$1/bin/tidewm"
    chmod +x "$T/opt/tidewm/$1/bin/tidewm"
    echo "old build" > "$T/opt/tidewm/$1/setup-tide-build"
    ln -sfn "$1" "$T/opt/tidewm/current"
    ln -sfn "$T/opt/tidewm/current/bin/tidewm" "$T/usr-local-bin/tidewm"
}

# deps.lock pins no tidewm.
check "deps.lock has no tidewm pin" test -z "$(awk '!/^[ \t]*(#|$)/ && $2 == "tidewm"' "$SCRIPT_DIR/../deps.lock")"

# By default tidewm is built, and its session installed beside Hyprland's.
setup; ARGS=(); run
check "by default, tidewm is built" has "$calls" "tidewm.git"
check "by default, it's linked" test -L "$T/usr-local-bin/tidewm"
check "by default, both sessions are installed" has "$calls" "install-session PREFIX=/usr SESSIONS=tide tide-tidewm"
teardown

# With --no-tidewm, nothing of tidewm's is touched.
setup; ARGS=(--no-tidewm); run
check "without --tidewm, setup succeeds" test "$status" -eq 0
# Its session's target is only asked about, as tide's other one is.
check "without --tidewm, tidewm isn't cloned" lacks "$calls" "tidewm.git"
check "without --tidewm, tidewm isn't built" lacks "$calls" "tidewm-build"
check "without --tidewm, nothing of it is installed" lacks "$calls" "libwlroots"
check "without --tidewm, nothing is linked" test ! -e "$T/usr-local-bin/tidewm"
teardown

# With --tidewm on Debian testing, which packages wlroots 0.20: build main.
setup; ARGS=(--tidewm); run
check "--tidewm succeeds" test "$status" -eq 0
check "--tidewm installs tidewm's build dependencies, wlroots 0.20 among them" \
    has "$calls" "apt-get install -y --no-upgrade build-essential pkgconf git libwlroots-0.20-dev libwayland-dev"
check "and PCRE2, for its window rules, and Xwayland, for X11 apps" has "$calls" "libjson-c-dev libpcre2-dev xwayland"
check "and wlroots' portal, for sharing a screen or window" has "$calls" "xwayland xdg-desktop-portal-wlr"
# git is one of them, so GitHub is asked about main only once they're in:
# a machine without git would otherwise look offline.
deps_line=$(printf '%s\n' "$calls" | grep -n "apt-get install -y --no-upgrade build-essential pkgconf git" | head -n1 | cut -d: -f1)
ask_line=$(printf '%s\n' "$calls" | grep -nF "$ask" | head -n1 | cut -d: -f1)
check "main's commit is asked for after the build dependencies, git among them, are installed" \
    test -n "$deps_line" -a -n "$ask_line" -a "${deps_line:-0}" -lt "${ask_line:-0}"
check "--tidewm asks GitHub which commit main is at" has "$calls" "$ask"
check "--tidewm clones main" has "$calls" "$clone $T/src/tidewm-build/tidewm"
check "and checks the clone is at that commit" has "$calls" "git -C $T/src/tidewm-build/tidewm rev-parse HEAD"
check "and, being there, checks out nothing else" lacks "$calls" "git -C $T/src/tidewm-build/tidewm checkout"
check "and says which commit it builds" has "$output" "Building tidewm's main, at ${main:0:12}, from source"
check "--tidewm builds it with XWayland" has "$calls" "make -C $T/src/tidewm-build/tidewm XWAYLAND=-DXWAYLAND XLIBS=xcb xcb-icccm"
check "--tidewm installs it under its prefix, by main's commit" has "$calls" "make -C $T/src/tidewm-build/tidewm install PREFIX=$T/opt/tidewm/main-${main:0:12}-"
check "the build never uses sudo to install" lacks "$calls" "sudo make -C $T/src/tidewm-build"
check "the build is marked complete" test -f "$(build)/setup-tide-build"
check "the build records the commit" has "$(cat "$(build)/setup-tide-build")" "https://github.com/mikelward/tidewm.git main $main"
check "the build is current" test "$(readlink -f "$T/opt/tidewm/current")" = "$(build)"
check "tidewm is linked onto PATH, through current" \
    test "$(readlink "$T/usr-local-bin/tidewm")" = "$T/opt/tidewm/current/bin/tidewm"
check "the build is root's once it's linked" has "$calls" "sudo chown -R 0:0 $(build)"
check "its build dependencies are a package step" has "$output" "Installing tidewm's build dependencies
Installed: "
check "its build's output isn't shown" lacks "$output" "install -m 644"
# Real git, given the tidewm clone's own options, clones main without a
# word about detached HEADs, and with the tags behind it, so `git describe
# --tags`, which is what `tidewm -v` says, names the last release tag even
# before main's newest commit is tagged.
g init -q -b main "$T/git/tidewm"
g -C "$T/git/tidewm" commit -q --allow-empty -m one
g -C "$T/git/tidewm" tag v0.0.1
g -C "$T/git/tidewm" commit -q --allow-empty -m two
opts=$(printf '%s\n' "$calls" | sed -n 's/^git clone \(.*\) https:[^ ]*\/tidewm\.git .*/\1/p')
clone_status=0
# shellcheck disable=SC2086  # word-split the logged options
clone_output=$(g clone $opts "file://$T/git/tidewm" "$T/git/tidewm-clone" 2>&1) || clone_status=$?
check "the tidewm clone's own options clone main" test "$clone_status" -eq 0
check "without a word about a detached HEAD" lacks "$clone_output" "detached HEAD"
check "at main's newest commit" test "$(g -C "$T/git/tidewm-clone" rev-parse HEAD)" = "$(g -C "$T/git/tidewm" rev-parse HEAD)"
described=$(g -C "$T/git/tidewm-clone" describe --tags 2>&1) || true
check "and tidewm -v names the release tag it follows" has "$described" "v0.0.1-1-g"
# A second run with main where it was doesn't rebuild.
: > "$CALLS"
run
check "an unmoved main is still asked about" has "$calls" "$ask"
check "an unmoved main isn't cloned again" lacks "$calls" "$clone"
check "an unmoved main doesn't rebuild" lacks "$calls" "make -C $T/src/tidewm-build"
check "an unmoved main says so only with --verbose" lacks "$output" "is already built"
check "an unmoved main still links" test "$(readlink "$T/usr-local-bin/tidewm")" = "$T/opt/tidewm/current/bin/tidewm"
# A moved main builds afresh, and the old build goes once current moves.
first=$(build)
: > "$CALLS"
run FAKE_TIDEWM_MAIN=$moved
check "a moved main builds" has "$calls" "make -C $T/src/tidewm-build/tidewm install PREFIX=$T/opt/tidewm/main-${moved:0:12}-"
check "a moved main's build is current" test "$(readlink -f "$T/opt/tidewm/current")" = "$(build "${moved:0:12}")"
check "the old main's build is removed" test ! -e "$first"
teardown

# Builds of the tags setup used to pin go once main's is current.
setup; ARGS=(--tidewm)
old_build v0.0.1474-1234
run
check "with a tag's build, main builds" has "$calls" "make -C $T/src/tidewm-build/tidewm install"
check "main's build is current" test "$(readlink -f "$T/opt/tidewm/current")" = "$(build)"
check "the tag's build is removed" test ! -e "$T/opt/tidewm/v0.0.1474-1234"
teardown

# Another branch, by $TIDEWM_BRANCH, a slash in its name kept out of the path.
setup; ARGS=(--tidewm); run TIDEWM_BRANCH=fix/thing
check "another branch is asked about" has "$calls" "git ls-remote https://github.com/mikelward/tidewm.git refs/heads/fix/thing"
check "another branch is cloned" has "$calls" "--filter=blob:none --branch fix/thing https://github.com/mikelward/tidewm.git"
check "another branch builds in a directory of its own" test -f "$(printf '%s\n' "$T"/opt/tidewm/fix-thing-"${main:0:12}"-*/setup-tide-build)"
teardown

# Main moved between asking and cloning: the commit asked about is built.
setup; ARGS=(--tidewm); run FAKE_TIDEWM_CLONED=$moved
check "a clone past the commit fetches it" has "$calls" "git -C $T/src/tidewm-build/tidewm fetch --quiet origin $main"
check "and checks it out" has "$calls" "git -C $T/src/tidewm-build/tidewm checkout --quiet $main"
check "and builds it" has "$calls" "make -C $T/src/tidewm-build/tidewm install PREFIX=$T/opt/tidewm/main-${main:0:12}-"
check "and it's current" test "$(readlink -f "$T/opt/tidewm/current")" = "$(build)"
teardown

# A commit that can't be checked out isn't built.
setup; ARGS=(--tidewm); run FAKE_TIDEWM_CLONED=$moved FAKE_CHECKOUT_FAILS=1
check "an unreachable commit isn't built" lacks "$calls" "make -C $T/src/tidewm-build"
check "an unreachable commit says so" has "$output" "couldn't check out tidewm's $main, the commit its main was at"
check "a failed tidewm build is a warning, not a failure" test "$status" -eq 0
check "and says what it costs" has "$output" "tidewm couldn't be built; rerun setup to retry"
check "nothing is linked" test ! -e "$T/usr-local-bin/tidewm"
teardown

# Without GitHub, a build that's there is kept.
setup; ARGS=(--tidewm)
old_build main-${main:0:12}-1234
run FAKE_LS_REMOTE_FAILS=1
check "offline, a build is kept" test "$status" -eq 0
check "offline, nothing is cloned" lacks "$calls" "$clone"
check "offline, nothing is built" lacks "$calls" "make -C $T/src/tidewm-build"
check "offline, it says why" has "$output" "couldn't ask GitHub which commit tidewm's main is at"
check "offline, it says which build it keeps" has "$output" "keeping the tidewm build in $T/opt/tidewm/main-${main:0:12}-1234"
check "offline, the build stays current" test "$(readlink "$T/opt/tidewm/current")" = "main-${main:0:12}-1234"
check "offline, the build stays" test -f "$T/opt/tidewm/main-${main:0:12}-1234/setup-tide-build"
check "offline, it's still linked" test "$(readlink "$T/usr-local-bin/tidewm")" = "$T/opt/tidewm/current/bin/tidewm"
teardown
setup; ARGS=(); old_build main-${main:0:12}-1234
run TIDE_SETUP_ONLY=tidewm FAKE_LS_REMOTE_FAILS=1
check "only-tidewm offline, a build is kept" test "$status" -eq 0
check "only-tidewm offline, and named" has "$output" "Built tidewm in $T/opt/tidewm/main-${main:0:12}-1234"
teardown

# Without GitHub or a build, it fails as a failed build does.
setup; ARGS=(--tidewm); run FAKE_LS_REMOTE_FAILS=1
check "offline with no build, setup still succeeds" test "$status" -eq 0
check "offline with no build, nothing is cloned" lacks "$calls" "$clone"
check "offline with no build, it says so" has "$output" "there's no build of tidewm to keep"
check "offline with no build, and what it costs" has "$output" "tidewm couldn't be built; rerun setup to retry"
check "offline with no build, nothing is linked" test ! -e "$T/usr-local-bin/tidewm"
teardown
setup; ARGS=(); run TIDE_SETUP_ONLY=tidewm FAKE_LS_REMOTE_FAILS=1
check "only-tidewm offline with no build fails" test "$status" -ne 0
check "only-tidewm offline with no build, saying so" has "$output" "building tidewm failed"
teardown

# CI's prebuilt workflow builds only tidewm.
setup; ARGS=(); run TIDE_SETUP_ONLY=tidewm
check "only-tidewm: builds tidewm's main" has "$calls" "$clone"
check "only-tidewm: and says where" has "$output" "Built tidewm in $(build)"
check "only-tidewm: and nothing of tide's own" lacks "$calls" "make -C $T/src/tide install"
check "only-tidewm: and no Hyprland" lacks "$calls" "apt-get install -y --no-upgrade hyprland"
check "only-tidewm: succeeds" test "$status" -eq 0
teardown
setup; ARGS=(); run TIDE_SETUP_ONLY=tidewm FAKE_MAKE_FAILS="$T/src/tidewm-build/tidewm"
check "only-tidewm: a failed build fails" test "$status" -ne 0
check "only-tidewm: saying so" has "$output" "building tidewm failed"
teardown

setup; ARGS=(--tidewm); run FAKE_MAKE_FAILS="$T/src/tidewm-build/tidewm"
check "a failed make doesn't fail setup" test "$status" -eq 0
check "a failed make is reported" has "$output" "building tidewm failed"
check "a failed make leaves nothing linked" test ! -e "$T/usr-local-bin/tidewm"
check "a failed make leaves no marker" test -z "$(find "$T/opt/tidewm" -name setup-tide-build 2>/dev/null)"
teardown

# Build dependencies that won't install are named, and nothing is built.
setup; ARGS=(--tidewm); run FAKE_APT_GET_FAILS=1
check "failed build dependencies are named" \
    has "$output" "could not install tidewm's build dependencies: build-essential pkgconf git libwlroots-0.20-dev"
check "and tidewm isn't built" lacks "$calls" "$clone"
teardown

# Debian testing's wlroots is used as it is.
setup; ARGS=(--tidewm); run
check "with the distro's wlroots 0.20, wlroots isn't built" lacks "$calls" "wlroots.git"
check "and tidewm links with no run path of its own" lacks "$calls" "make env:"
teardown

# Ubuntu 26.04 and Debian 13 have no wlroots 0.20: it's built from its pin
# into tidewm's build, and tidewm against it.
wl_tag=$("$SCRIPT_DIR/pins" --env wlroots | sed -n 's/^PIN_TAG=//p')
# line_of TEXT: the first line of $calls that has TEXT, or 0.
line_of() { printf '%s\n' "$calls" | grep -nF -e "$1" | head -n 1 | cut -d: -f1 | grep . || echo 0; }
setup; ARGS=(--tidewm); run FAKE_MISSING=libwlroots-0.20-dev
check "without wlroots 0.20, setup succeeds" test "$status" -eq 0
check "the pin is a 0.20 release" has "$wl_tag" "0.20."
check "the build doesn't ask apt for wlroots" lacks "$calls" "libwlroots-0.20-dev"
check "it installs wlroots' build dependencies with tidewm's" \
    has "$calls" "apt-get install -y --no-upgrade build-essential pkgconf git libwayland-dev wayland-protocols"
check "among them meson, and Xwayland's xcb libraries" has "$calls" "meson ninja-build bison"
check "and the xcb libraries Xwayland needs" has "$calls" "libxcb-res0-dev libxcb-xfixes0-dev libxcb-errors-dev xwayland"
check "it asks pkg-config whether the distro has wlroots 0.20" has "$calls" "pkg-config --modversion wlroots-0.20"
check "it clones the pinned wlroots tag" \
    has "$calls" "git clone -c advice.detachedHead=false --quiet --depth 1 --branch $wl_tag https://gitlab.freedesktop.org/wlroots/wlroots.git $T/src/tidewm-build/wlroots"
check "and checks the tag names the pinned commit" has "$calls" "git -C $T/src/tidewm-build/wlroots rev-parse HEAD"
check "it builds wlroots with meson into tidewm's build" \
    has "$calls" "meson setup $T/src/tidewm-build/wlroots/build $T/src/tidewm-build/wlroots --prefix=$(build) --libdir=lib --buildtype=release --wrap-mode=nodownload -Dexamples=false -Dxwayland=enabled"
check "with a run path to its lib" has "$calls" "meson env: PKG_CONFIG_PATH=$(build)/lib/pkgconfig:$(build)/share/pkgconfig"
check "and installs it there" has "$calls" "meson install -C $T/src/tidewm-build/wlroots/build"
check "with the distro's new enough, nothing else of the group is built" lacks "$calls" "wayland.git"
check "tidewm builds against it, with a run path to it" \
    has "$calls" "make env: PKG_CONFIG_PATH=$(build)/lib/pkgconfig:$(build)/share/pkgconfig"
check "the run path is to the build's own lib" has "$calls" "LDFLAGS=-Wl,-rpath,$(build)/lib"
w=$(line_of "meson install -C $T/src/tidewm-build/wlroots/build")
m=$(line_of "make -C $T/src/tidewm-build/tidewm XWAYLAND")
check "wlroots is installed before tidewm is built" test "$w" -gt 0 -a "$w" -lt "$m"
check "tidewm is linked" test "$(readlink "$T/usr-local-bin/tidewm")" = "$T/opt/tidewm/current/bin/tidewm"
check "the build records wlroots' pins" has "$(cat "$(build)/setup-tide-build")" "wlroots $(sed -n 's/^wlroots wlroots //p' "$SCRIPT_DIR/../deps.lock" | cut -d' ' -f1)"
# A second run doesn't rebuild either.
: > "$CALLS"
run FAKE_MISSING=libwlroots-0.20-dev
check "the same pins don't rebuild wlroots" lacks "$calls" "meson setup"
check "nor tidewm" lacks "$calls" "make -C $T/src/tidewm-build"
teardown

# Debian 13's wayland, libdrm, xkbcommon and pixman are older than wlroots
# 0.20 needs: they build first, in deps.lock's order, then wlroots.
setup; ARGS=(--tidewm); run FAKE_MISSING=libwlroots-0.20-dev FAKE_PKG_OLD="wayland-server libdrm xkbcommon pixman-1"
check "old dependencies, setup succeeds" test "$status" -eq 0
check "it asks pkg-config for wlroots' least versions" has "$calls" "pkg-config --atleast-version=1.24.0 wayland-server wayland-scanner"
for dep in wayland libdrm libxkbcommon pixman; do
    check "an old $dep is built" has "$calls" "meson install -C $T/src/tidewm-build/$dep/build"
done
check "a new enough wayland-protocols isn't" lacks "$calls" "$T/src/tidewm-build/wayland-protocols"
check "xkbcommon reads the system's keymaps" has "$calls" "-Dxkb-config-root=/usr/share/X11/xkb -Dx-locale-root=/usr/share/X11/locale"
order=
for dep in wayland libdrm libxkbcommon pixman wlroots; do
    order="$order $(line_of "meson setup $T/src/tidewm-build/$dep/build")"
done
check "they build in deps.lock's order, wlroots last" test "$(printf '%s\n' $order | sort -n | tr '\n' ' ')" = "${order# } "
teardown

# A moved wlroots tag isn't built, and nor is tidewm.
setup; ARGS=(--tidewm); run FAKE_MISSING=libwlroots-0.20-dev FAKE_MOVED_PIN=wlroots
check "a moved wlroots tag doesn't fail setup" test "$status" -eq 0
check "a moved wlroots tag says so" has "$output" "wlroots's $wl_tag tag is commit 0000000000000000000000000000000000000000"
check "a moved wlroots tag isn't built" lacks "$calls" "meson setup $T/src/tidewm-build/wlroots"
check "and nor is tidewm" lacks "$calls" "make -C $T/src/tidewm-build/tidewm"
check "nothing is linked" test ! -e "$T/usr-local-bin/tidewm"
teardown

# A failed wlroots build leaves tidewm unbuilt, and nothing linked.
setup; ARGS=(--tidewm); run FAKE_MISSING=libwlroots-0.20-dev FAKE_MESON_FAILS=wlroots
check "a failed wlroots build doesn't fail setup" test "$status" -eq 0
check "a failed wlroots build is reported" has "$output" "building wlroots failed, so tidewm isn't built"
check "and tidewm isn't built" lacks "$calls" "make -C $T/src/tidewm-build/tidewm"
check "a failed wlroots build leaves no marker" test -z "$(find "$T/opt/tidewm" -name setup-tide-build 2>/dev/null)"
teardown

# Arch packages wlroots 0.20.
setup; ARGS=(--tidewm); run SETUP_OS=arch
check "on Arch, tidewm's dependencies come from pacman" has "$calls" "pacman -S --needed --noconfirm base-devel git wlroots0.20"
check "on Arch, wlroots' portal is installed, for screen sharing" has "$calls" "xorg-xwayland xdg-desktop-portal-wlr"
check "on Arch, tidewm is built" has "$calls" "make -C $T/src/tidewm-build/tidewm install PREFIX="
check "on Arch, wlroots isn't built" lacks "$calls" "wlroots.git"
teardown

# On Fedora, from dnf, with the package that has wlroots 0.20.
setup; ARGS=(--tidewm); run SETUP_OS=redhat FAKE_DNF_WLROOTS=wlroots0.20-devel
check "on Fedora, tidewm's dependencies come from dnf" has "$calls" "dnf install -y --setopt=best=False gcc make pkgconf-pkg-config git wayland-devel"
check "on Fedora, with the package that has wlroots 0.20" has "$calls" "xdg-desktop-portal-wlr wlroots0.20-devel"
check "on Fedora, tidewm is built" has "$calls" "make -C $T/src/tidewm-build/tidewm install PREFIX="
check "on Fedora, wlroots isn't built" lacks "$calls" "wlroots.git"
check "on Fedora, it succeeds" test "$status" -eq 0
teardown
# pkg-config can't find it either: the stub reads it off apt's package name.
setup; ARGS=(--tidewm); run SETUP_OS=redhat FAKE_MISSING="wlroots libwlroots-0.20-dev"
check "on a Fedora without wlroots 0.20, with wlroots' build dependencies from dnf, by pkg-config name" has "$calls" "meson ninja-build bison xkeyboard-config glslang hwdata pkgconfig(expat)"
check "wlroots is built" has "$calls" "wlroots.git"
check "then tidewm" has "$calls" "make -C $T/src/tidewm-build/tidewm install PREFIX="
check "and it succeeds" test "$status" -eq 0
teardown

# A tidewm on PATH that setup didn't link is left alone.
setup; ARGS=(--tidewm)
printf '#!/bin/sh\n' > "$T/usr-local-bin/tidewm"
chmod +x "$T/usr-local-bin/tidewm"
run
check "someone else's tidewm isn't replaced" test ! -L "$T/usr-local-bin/tidewm"
check "and setup says so" has "$output" "NOT LINKING tidewm: $T/usr-local-bin/tidewm is already there"
teardown

# A tidewm that's there but can't run, as one whose wlroots an upgrade took
# away, would log in to nothing, and the greeter would offer it again. Its
# session comes off the login screen, and Hyprland's stays.
setup; ARGS=(--tidewm)
mkdir -p "$T/share/wayland-sessions"
echo "an earlier run's" > "$T/share/wayland-sessions/tide-tidewm.desktop"
run FAKE_TIDEWM_BROKEN=yes
check "a tidewm that can't run is only a warning beside Hyprland" test "$status" -eq 0
check "a tidewm that can't run is asked its version" test -x "$T/usr-local-bin/tidewm"
check "a tidewm that can't run is named, with the last line of why" has "$output" \
    "the tide (tidewm) session won't show at the login screen: its tidewm ($T/usr-local-bin/tidewm) can't run: 'tidewm -v' exited 127, saying 'tidewm: error while loading shared libraries: libwlroots-0.20.so: cannot open shared object file: No such file or directory'"
check "and not the lines before it" lacks "$output" "symbol lookup warning"
check "its session isn't installed" has "$calls" "install-session PREFIX=/usr SESSIONS=tide"
check "only Hyprland's is" lacks "$calls" "SESSIONS=tide tide-tidewm"
check "its entry comes off the login screen" test ! -e "$T/share/wayland-sessions/tide-tidewm.desktop"
check "which is said" has "$output" "Took $T/share/wayland-sessions/tide-tidewm.desktop off the login screen"
check "Hyprland's entry stays" test -e "$T/share/wayland-sessions/tide.desktop"
teardown
# With no Hyprland either, there's no session at all.
setup; ARGS=(--tidewm); rm "$T/usr-bin/Hyprland"; run FAKE_TIDEWM_BROKEN=yes
check "a tidewm that can't run, with no Hyprland, ends the run" test "$status" -ne 0
check "and says there's no session" has "$output" "so tide has no session to log in to"
teardown
# One that runs keeps its entry: `tidewm -v` names its version and exits 1.
setup; ARGS=(--tidewm); run
check "a tidewm that runs keeps its session" test -e "$T/share/wayland-sessions/tide-tidewm.desktop"
check "and nothing is said of it" lacks "$output" "can't run"
teardown
# tide (tidesway) is installed where a tidesway is on the session's PATH,
# which setup doesn't build yet, and comes off the login screen where it's
# gone.
setup; ARGS=(--tidewm)
printf '#!/bin/sh\n' > "$T/usr-local-bin/tidesway"
chmod +x "$T/usr-local-bin/tidesway"
run
check "with a tidesway installed, its session is too" has "$calls" "install-session PREFIX=/usr SESSIONS=tide tide-tidewm tide-tidesway"
teardown
setup; ARGS=(--tidewm)
mkdir -p "$T/share/wayland-sessions"
echo "an earlier run's" > "$T/share/wayland-sessions/tide-tidesway.desktop"
run
check "with no tidesway, its session isn't installed" lacks "$calls" "SESSIONS=tide tide-tidewm tide-tidesway"
check "and an earlier run's entry comes off the login screen" test ! -e "$T/share/wayland-sessions/tide-tidesway.desktop"
check "with nothing said of a tidesway that's missing" lacks "$output" "tidesway isn't installed"
teardown
# With tidesway alone, no Hyprland and no tidewm, its session is the one to
# log in to, and the one the last check asks for.
setup; ARGS=(--no-tidewm); rm "$T/usr-bin/Hyprland"
printf '#!/bin/sh\n' > "$T/usr-local-bin/tidesway"
chmod +x "$T/usr-local-bin/tidesway"
run
check "with tidesway alone, setup ends well" test "$status" -eq 0
check "with tidesway alone, its session is installed" has "$calls" "install-session PREFIX=/usr SESSIONS=tide-tidesway"
check "and tidewm's entry isn't asked for" lacks "$output" "tide (tidewm) session won't show"
teardown
setup; ARGS=(--no-tidewm); rm "$T/usr-bin/Hyprland"
printf '#!/bin/sh\n' > "$T/usr-local-bin/tidesway"
chmod +x "$T/usr-local-bin/tidesway"
run FAKE_NO_TIDESWAY_ENTRY=yes
check "with tidesway alone, a missing entry ends the run" test "$status" -ne 0
check "and is named, with the command that installs it" has "$output" \
    "the tide (tidesway) session won't show at the login screen: there's no $T/share/wayland-sessions/tide-tidesway.desktop; run 'sudo make -C"
check "which installs tidesway's" has "$output" "install-session PREFIX=/usr SESSIONS=tide-tidesway'"
teardown
# Under its own name too, and one that exits 0 without a word.
for says in 'echo "tidewm v0.2.0" >&2; exit 1' 'exit 0'; do
    setup; ARGS=(--tidewm)
    printf '#!/bin/sh\n%s\n' "$says" > "$T/usr-local-bin/tidewm"
    chmod +x "$T/usr-local-bin/tidewm"
    run
    check "a tidewm that ends '$says' keeps its session" has "$calls" "SESSIONS=tide tide-tidewm"
    teardown
done
# One that fails with anything else can't run, whatever its status.
setup; ARGS=(--tidewm)
printf '#!/bin/sh\necho "tidewm: /lib/libc.so.6: version GLIBC_2.99 not found" >&2\nexit 1\n' > "$T/usr-local-bin/tidewm"
chmod +x "$T/usr-local-bin/tidewm"
run
check "a tidewm that fails with status 1 and no version can't run" has "$output" \
    "'tidewm -v' exited 1, saying 'tidewm: /lib/libc.so.6: version GLIBC_2.99 not found'"
check "and its session isn't installed" lacks "$calls" "SESSIONS=tide tide-tidewm"
teardown

# With both sessions, both entries are checked: tidewm's too, not only
# when Hyprland's session is absent.
setup; ARGS=(--tidewm); run FAKE_NO_TIDEWM_ENTRY=yes
check "with both sessions, a missing tidewm entry ends the run" test "$status" -ne 0
check "and is named" has "$output" \
    "the tide (tidewm) session won't show at the login screen: there's no $T/share/wayland-sessions/tide-tidewm.desktop"
check "and Hyprland's, which is there, isn't" lacks "$output" "there's no $T/share/wayland-sessions/tide.desktop"
teardown

finish
