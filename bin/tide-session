#!/bin/sh
#
# What a tide session entry runs (SPEC.md §5.3): `tide-session hyprland`,
# `tide-session tidewm` or `tide-session tidesway`. It starts the session through uwsm, and says in
# the journal (`journalctl -b -t tide-session`) what it ran, what uwsm
# printed, and how it ended. A login that goes straight back to the login
# screen leaves nothing of its own, so this is where to look.
#
# The entries' Exec is plain words for that reason too: GDM puts Exec
# inside double quotes of its own, unescaped, and SDDM splits it on spaces
# with no quoting at all, so a quote in Exec breaks the command before
# anything runs. Every argument with a space in it is here instead.
#
# Before uwsm, it has the user manager forget the failures of tide's units.
# A manager that outlived the last login (lingering, a logout and straight
# back in, a compositor that crashed) still holds them, and a shell that
# hit its start limit there is refused its start here, so the new session
# would go straight to the fallback terminal.

# say MESSAGE: to stderr, which the login screen keeps, and to the journal,
# for what went wrong. Under greetd, stderr is the text console the session
# starts on, so only a problem is said there.
say() {
    echo "tide-session: $*" >&2
    # The journal is the log: a logger that fails has nowhere to say so.
    logger -t tide-session -- "$*" 2>/dev/null || :
}

case ${1:-} in
    hyprland) desktops=tide:Hyprland name="tide (Hyprland)" compositor=tide-hyprland flag= ;;
    tidewm) desktops=tidewm:tide name="tide (tidewm)" compositor=tide-tidewm flag= ;;
    # tidesway takes tidewm's config and speaks its IPC, so its session is
    # tidewm's, wrapper, target and portals, with tidesway run in its place.
    tidesway) desktops=tidewm:tidesway:tide name="tide (tidesway)" compositor=tide-tidewm flag=--tidesway ;;
    *)
        say "usage: tide-session hyprland|tidewm|tidesway, not '${1:-}'"
        exit 2
        ;;
esac

# note MESSAGE: to the journal only, at debug level, for what's expected.
note() {
    logger -t tide-session -p user.debug -- "$*" 2>/dev/null || :
}

# log MESSAGE: to the journal only, for what happened as it should: the
# session starting and ending.
log() {
    logger -t tide-session -p user.info -- "$*" 2>/dev/null || :
}


# tide's units, and hypridle, which tide's drop-in gives a start limit:
# the ones in systemd/user, and the fallback bar tide-shell-fallback runs.
units="tide.service tide-shell-fallback.service tide-bar-fallback.service
    tide-lock.service tide-lock-fallback.service tide-idle-fallback.service
    tide-clipboard.service tide-fcitx5.service tide-lid-inhibit.service
    hypridle.service"

# forget_failures: clears the failed state and the start limit's count of
# each unit, so this login starts them afresh. It never stops the login:
# what it couldn't do is said, and uwsm starts regardless. A unit the
# manager hasn't loaded has nothing to forget, which is most of them most
# times, and no user manager to ask is as it should be where the session
# starts one, so neither is said beyond the journal's debug level.
forget_failures() {
    if ! command -v systemctl >/dev/null 2>&1; then
        note "no systemctl, so failures from an earlier session aren't cleared"
        return 0
    fi
    # Unquoted: one argument a unit. It's cut off after 5 s, where there's
    # a timeout to do it, as a manager that doesn't answer mustn't hold up
    # the login.
    if command -v timeout >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        out=$(timeout 5 systemctl --user reset-failed $units 2>&1)
    else
        # shellcheck disable=SC2086
        out=$(systemctl --user reset-failed $units 2>&1)
    fi
    status=$?
    test "$status" -ne 0 || return 0
    rest=$(printf '%s\n' "$out" | grep -v ' not loaded\.$')
    case $rest in
        '') test -n "$out" || say "couldn't clear failures from an earlier session (systemctl --user reset-failed exited $status), so a shell that failed for good then may not start now" ;;
        *'Failed to connect to bus'*) note "no user manager to clear failures from an earlier session in ($(printf '%s\n' "$rest" | tail -n 1))" ;;
        *) say "couldn't clear failures from an earlier session (systemctl --user reset-failed exited $status: $(printf '%s\n' "$rest" | tail -n 1)), so a shell that failed for good then may not start now" ;;
    esac
}

if ! command -v uwsm >/dev/null 2>&1; then
    say "uwsm isn't installed, so the tide ($1) session can't start: run tide's installer"
    exit 1
fi

# A text console, as greetd gives a session, shows what it last held, and
# a cursor, until the compositor draws. Once the session can start, it's
# cleared, with the cursor hidden, so the login goes from the greeter to
# black to the desktop; the cursor comes back however this ends.
if test -t 2; then
    trap 'printf "\033[?25h" >&2' EXIT
    printf '\033[?25l\033[H\033[2J' >&2
fi

forget_failures
log "starting the tide ($1) session: uwsm start -e -D $desktops -N '$name' -- $compositor${flag:+ $flag}"
# uwsm's own output goes to the journal under this name as well, through
# systemd-cat where there is one, and the session ends when uwsm returns.
if command -v systemd-cat >/dev/null 2>&1; then
    systemd-cat -t tide-session -- uwsm start -e -D "$desktops" -N "$name" -- "$compositor" ${flag:+"$flag"}
else
    uwsm start -e -D "$desktops" -N "$name" -- "$compositor" ${flag:+"$flag"}
fi
status=$?
if test "$status" -eq 0; then
    log "the tide ($1) session ended"
else
    say "the tide ($1) session ended with uwsm exiting $status: the lines above say why"
fi
exit "$status"
