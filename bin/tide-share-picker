#!/bin/sh
#
# tide-share-picker: xdg-desktop-portal-hyprland's custom_picker_binary
# (SPEC.md §12). xdph runs it when an app asks to share the screen, with
# the windows it can share in XDPH_WINDOW_SHARING_LIST and --allow-token
# when its allow_token_by_default is on. It asks the running shell to show
# the dialog, waits for the answer, and prints it for xdph:
# `[SELECTION]<flags>/screen:<output>`, `.../window:<id>` or
# `.../region:<output>@<x>,<y>,<w>,<h>`. Printing nothing cancels the share.
#
# The shell answers on a pipe this makes in $XDG_RUNTIME_DIR, since an IPC
# call returns before the dialog does. With no shell running, xdph's own
# hyprland-share-picker is run instead, if it's installed, so a share
# still works.
#
# TIDE_SHARE_PICKER_TIMEOUT, 300 seconds by default, is how long it waits
# for an answer before it closes the dialog and cancels.

prog=${0##*/}
timeout_s=${TIDE_SHARE_PICKER_TIMEOUT:-300}

allow=false
for arg in "$@"; do
    case "$arg" in
        --allow-token) allow=true ;;
        # A later xdph may pass more; unknown ones change nothing here.
        *) echo "$prog: ignoring unknown argument $arg" >&2 ;;
    esac
done

dir=${XDG_RUNTIME_DIR:-}
if test -z "$dir" || ! test -d "$dir"; then
    echo "$prog: no XDG_RUNTIME_DIR for the shell to answer in, so nothing is shared" >&2
    exit 1
fi
# The runtime directory is the user's alone, so a name mkfifo then claims
# can't be taken in between by anyone else.
if ! reply=$(mktemp -u "$dir/tide-share-picker.XXXXXXXX"); then
    echo "$prog: couldn't name a pipe in $dir, so nothing is shared" >&2
    exit 1
fi
if ! err=$(mkfifo -m 600 "$reply" 2>&1); then
    echo "$prog: couldn't make $reply, so nothing is shared: $err" >&2
    exit 1
fi
trap 'rm -f "$reply" "$reply.answer"' EXIT
trap 'exit 1' HUP INT TERM

# Closes the dialog with no, for when this stops waiting on it.
cancel() {
    if ! err=$(qs -c tide ipc call sharepicker cancel "$reply" 2>&1); then
        echo "$prog: couldn't close the picker: $err" >&2
    fi
}

if ! shown=$(qs -c tide ipc call sharepicker pick "$reply" "$allow" "${XDPH_WINDOW_SHARING_LIST:-}" 2>&1); then
    err=$shown
    case "$err" in
        "No running instances"* | "No instances"*)
            if command -v hyprland-share-picker >/dev/null 2>&1; then
                rm -f "$reply"
                trap - EXIT
                exec hyprland-share-picker "$@"
            fi
            echo "$prog: tide's shell isn't running, and there's no hyprland-share-picker, so nothing is shared" >&2
            ;;
        *)
            echo "$prog: tide's shell couldn't show the picker, so nothing is shared: $err" >&2
            ;;
    esac
    exit 1
fi
if test "$shown" != shown; then
    echo "$prog: tide's shell didn't show the picker, so nothing is shared: $shown" >&2
    exit 1
fi

# The shell opens the pipe, writes one line and closes it, so cat ends once
# it has the answer. It runs in the background so a signal, xdph stopping
# say, interrupts the wait at once and closes the dialog, rather than
# waiting out the timeout and leaving the dialog holding the keyboard.
timeout "$timeout_s" cat "$reply" >"$reply.answer" &
reader=$!
# The reader may already be gone; either way it's not waited on again.
trap 'kill "$reader" 2>/dev/null; echo "$prog: stopped, so nothing is shared" >&2; cancel; exit 1' HUP INT TERM
wait "$reader"
status=$?
trap 'exit 1' HUP INT TERM
if test "$status" -eq 124; then
    echo "$prog: no answer from the picker in $timeout_s seconds, so nothing is shared" >&2
    cancel
    exit 1
fi
if test "$status" -ne 0; then
    echo "$prog: couldn't read the picker's answer from $reply (exit $status), so nothing is shared" >&2
    exit 1
fi
answer=$(cat "$reply.answer")

case "$answer" in
    '[SELECTION]'*)
        # xdph drops the last character of a screen: answer, so the newline
        # is part of it.
        printf '%s\n' "$answer"
        ;;
    '') ;;
    *)
        echo "$prog: the picker answered something xdph can't read, so nothing is shared: $answer" >&2
        exit 1
        ;;
esac
