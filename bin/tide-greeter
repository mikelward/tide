#!/bin/sh
#
# The tide greeter (SPEC.md §11), as greetd's default session runs it, as
# greetd's greeter user: Hyprland with tide's greeter config
# (share/tide/greeter/hyprland.lua), which shows the greeter
# (share/tide/shell/greeter.qml) on every monitor and exits when the greeter
# does, so greetd can start the session it chose. The greeter talks to
# greetd through tide-greetd, beside this command. `make install-session`
# puts all four under the same PREFIX, which is how this finds the other
# three.
#
# The keyboard is the system's X11 keymap as localed has it (`localectl
# set-x11-keymap`; /etc/default/keyboard on Debian), which `setup` sets to
# the session's layout, so a password is typed at the greeter as in the
# session. Without localed, Hyprland's default (US) stands, and the journal
# says so.
#
# A greeter that can't run still lets you log in: without its files,
# Hyprland or qs, or when Hyprland or qs fails, it says why and runs
# agreety, greetd's own text login, where that's installed. Without
# agreety it waits a few seconds and fails, and greetd starts it again.
#
# Usage: tide-greeter

prog=tide-greeter

if test $# -gt 0; then
    case $1 in
        -h | --help)
            sed -n '3,23p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
    esac
    echo "$prog: takes no arguments" >&2
    exit 2
fi

# text_login WHY: says why the greeter can't run, then runs agreety, greetd's
# own text login, so the machine can still be logged in to and fixed. It's
# looked for on the PATH and where the distros put it. Without it, fails,
# and greetd starts the greeter again: after a wait, so a greeter that
# fails at once every time doesn't flicker the screen, and leaves time to
# switch to another VT.
text_login() {
    echo "$prog: $1" >&2
    # $TIDE_GREETER_AGREETY_DIRS stands in for those directories in the tests.
    _dir=$(command -v agreety 2>/dev/null)
    for _dir in "${_dir%/agreety}" ${TIDE_GREETER_AGREETY_DIRS-/usr/sbin /usr/bin /usr/local/bin /usr/libexec}; do
        _agreety=$_dir/agreety
        if test -n "$_dir" && test -f "$_agreety" && test -x "$_agreety"; then
            echo "$prog: logging in on the console instead (agreety)" >&2
            # On the console too, which is all there is to read here.
            printf "\ntide's greeter could not start: %s\n\n" "$1"
            exec "$_agreety" --cmd /bin/sh
        fi
    done
    echo "$prog: and there's no agreety to log in with instead; failing in $retry_delay seconds, for greetd to start the greeter again" >&2
    if ! sleep "$retry_delay"; then
        echo "$prog: couldn't wait $retry_delay seconds (sleep failed); failing now" >&2
    fi
    exit 1
}

# How long a greeter with no text login to fall back to waits before failing.
retry_delay=5

share=$(dirname -- "$0")/../share/tide
config=$share/greeter/hyprland.lua
qml=$share/shell/greeter.qml
for file in "$config" "$qml"; do
    if ! test -r "$file"; then
        text_login "can't read $file; install the greeter with \`make install-session\`"
    fi
done
greetd_client=$(dirname -- "$0")/tide-greetd
if ! test -x "$greetd_client"; then
    text_login "can't run $greetd_client; install the greeter with \`make install-session\`"
fi
for command in Hyprland qs; do
    if ! command -v "$command" >/dev/null 2>&1; then
        text_login "there's no $command on the greeter's PATH ($PATH); rerun setup"
    fi
done

# unquote LINE: a string property's value from busctl's `s "VALUE"`, or
# fails for any other line.
unquote() {
    case $1 in
        's "'*'"') _v=${1#s \"}; printf '%s\n' "${_v%\"}" ;;
        *) return 1 ;;
    esac
}

# localed's X11 keymap, one property per line in the order asked.
if keymap=$(busctl get-property org.freedesktop.locale1 /org/freedesktop/locale1 \
    org.freedesktop.locale1 X11Layout X11Model X11Variant X11Options 2>&1); then
    {
        read -r layout
        read -r model
        read -r variant
        read -r options
    } <<EOF
$keymap
EOF
    if layout=$(unquote "$layout") && model=$(unquote "$model") &&
        variant=$(unquote "$variant") && options=$(unquote "$options"); then
        export TIDE_GREETER_KB_LAYOUT="$layout" TIDE_GREETER_KB_MODEL="$model"
        export TIDE_GREETER_KB_VARIANT="$variant" TIDE_GREETER_KB_OPTIONS="$options"
    else
        echo "$prog: localed's keymap isn't four strings ($(printf '%s' "$keymap" | tr '\n' ' ')); the greeter types in Hyprland's default layout" >&2
    fi
else
    echo "$prog: couldn't read the system keymap from localed: $keymap; the greeter types in Hyprland's default layout" >&2
fi

# Where the greeter's command (greeter/hyprland.lua) leaves qs's exit
# status: Hyprland exits 0 however qs ended, so this is the only word of a
# greeter that failed. It's cleared first, so a status here is this run's.
# Hyprland needs the runtime directory too, so one that's missing costs
# nothing more.
unset TIDE_GREETER_QS_STATUS
qs_status_file=
if test -n "${XDG_RUNTIME_DIR-}" && test -d "$XDG_RUNTIME_DIR" && test -w "$XDG_RUNTIME_DIR"; then
    qs_status_file=$XDG_RUNTIME_DIR/tide-greeter-qs
    if rm -f "$qs_status_file"; then
        export TIDE_GREETER_QS_STATUS="$qs_status_file"
    else
        echo "$prog: can't clear $qs_status_file, so a greeter (qs) that fails won't leave the text login" >&2
        qs_status_file=
    fi
else
    echo "$prog: no runtime directory to write to (XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR-}), so a greeter (qs) that fails won't leave the text login" >&2
fi

export TIDE_GREETER_QML="$qml" TIDE_GREETER_GREETD="$greetd_client"
# Not exec'd: a Hyprland that fails, as one too old for the greeter's
# config, leaves the text login. It exits 0 once the greeter has.
Hyprland --config "$config"
status=$?
if test "$status" -ne 0; then
    text_login "Hyprland exited $status"
fi

# Hyprland exited 0, as it does whenever qs ends. qs exits 0 once greetd
# has the session to start (shell/GreetdClient.qml); any other end is a
# greeter that failed, and starting it again would only fail again. A
# status that can't be told is taken as a normal end, and said.
if test -z "$qs_status_file"; then
    exit 0
fi
if ! test -e "$qs_status_file"; then
    echo "$prog: Hyprland exited 0 and left no exit status for the greeter (qs) in $qs_status_file; taking it as a normal end" >&2
    exit 0
fi
if ! read -r qs_status <"$qs_status_file"; then
    echo "$prog: can't read the greeter's (qs) exit status from $qs_status_file; taking it as a normal end" >&2
    exit 0
fi
case $qs_status in
    0) exit 0 ;;
    [0-9] | [0-9][0-9] | [0-9][0-9][0-9]) ;;
    *)
        echo "$prog: the greeter's (qs) exit status in $qs_status_file isn't a number; taking it as a normal end" >&2
        exit 0
        ;;
esac
if test "$qs_status" -gt 128; then
    text_login "the greeter (qs) was killed by signal $((qs_status - 128))"
fi
text_login "the greeter (qs) exited $qs_status"
