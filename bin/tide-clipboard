#!/bin/sh
#
# tide clipboard: the clipboard history behind the picker on Super+V
# (SPEC.md §8.4), kept by cliphist.
#
#   tide clipboard store [--max-items N]
#
#     The Settings panel's Clipboard page writes
#     ~/.config/hypr/tide-clipboard.conf (history=on or off, max_items=N
#     and max_age_days=N), which store reads at each copy: off, it stores
#     nothing, and its max_items replaces --max-items.
#
#     Run by tide-clipboard.service as `wl-paste --watch tide clipboard
#     store`, with each new copy on stdin, and stores it with `cliphist
#     store`, keeping the newest N (default 100). It then forgets entries
#     last copied more than max_age_days ago (default 7), by the times it
#     keeps in $XDG_STATE_HOME/tide/clipboard-times. A copy a password manager
#     marks is never stored: one whose CLIPBOARD_STATE is `sensitive` (a
#     wl-clipboard newer than 2.2.1 says so), or whose types, as
#     `wl-paste --list-types` lists them, include x-kde-passwordManagerHint.
#     If the types can't be read, the copy isn't stored, and it says why.
#
#   tide clipboard list
#
#     Forgets entries past max_age_days, as store does, then prints the
#     history, newest first, one `ID<TAB>preview` per line, as
#     `cliphist list` does, each preview up to 1,000 characters where
#     cliphist can (0.6.0 and later; 100 before). The picker reads it.
#     Before anything is stored, it prints nothing, or, with
#     tide-clipboard.service not running, says so and exits 1.
#
#   tide clipboard copy ID
#
#     Puts entry ID back on the clipboard (`cliphist decode | wl-copy`),
#     and exits once it's there, though wl-copy's child stays to serve it.
#
#   tide clipboard put TEXT
#
#     Puts TEXT on the clipboard, as copy does: the picker's Characters
#     tab.
#
#   tide clipboard delete ID
#
#     Removes entry ID from the history.
#
#   tide clipboard wipe [--notify]
#
#     Removes the whole history (`cliphist wipe`), and its times. With
#     --notify, as the
#     launcher's Clear clipboard history runs it, a failure is a
#     notification too.
#
# Exits 1, saying why, when cliphist or wl-clipboard fails or is missing,
# and 2 for a bad argument.

prog="tide clipboard"
HINT=x-kde-passwordManagerHint

usage() {
    echo "usage: $prog store [--max-items N]" >&2
    echo "       $prog list" >&2
    echo "       $prog copy ID" >&2
    echo "       $prog put TEXT" >&2
    echo "       $prog delete ID" >&2
    echo "       $prog wipe [--notify]" >&2
    exit 2
}

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "$prog: $1 isn't installed, so there's no clipboard history; install the $2 package" >&2
        exit 1
    fi
}

entry_id() {
    case "$1" in
        '' | *[!0-9]*)
            echo "$prog: not an entry ID: $1" >&2
            exit 2
            ;;
    esac
}

# The Clipboard page's settings, from the file the shell writes (SPEC.md
# §16): sets history (on or off), max and age (days), if the file sets
# them. A line it can't read is said on stderr and passed over, so a bad
# file never stops the history.
settings() {
    history=on
    age=7
    conf=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/tide-clipboard.conf
    test -e "$conf" || return 0
    if ! test -r "$conf"; then
        echo "$prog store: can't read $conf, so keeping history with the newest $max" >&2
        return 0
    fi
    while IFS='=' read -r key value || test -n "$key"; do
        case "$key" in
            '' | '#'*) ;;
            history)
                case "$value" in
                    on | off) history=$value ;;
                    *) echo "$prog store: $conf: history is on or off, not '$value'" >&2 ;;
                esac
                ;;
            max_items)
                case "$value" in
                    '' | *[!0-9]* | 0) echo "$prog store: $conf: max_items is a whole number above 0, not '$value'" >&2 ;;
                    *) max=$value ;;
                esac
                ;;
            max_age_days)
                case "$value" in
                    '' | *[!0-9]* | 0) echo "$prog store: $conf: max_age_days is a whole number above 0, not '$value'" >&2 ;;
                    *) age=$value ;;
                esac
                ;;
            *) echo "$prog store: $conf: $key isn't a setting (history, max_items, max_age_days)" >&2 ;;
        esac
    done <"$conf"
}

# When each entry was last copied, as "ID SECONDS" lines, for forgetting
# those older than $age days (SPEC.md §8.4). cliphist keeps no times of its
# own. In $XDG_STATE_HOME, readable by you alone.
times=${XDG_STATE_HOME:-$HOME/.local/state}/tide/clipboard-times

# Holds the times' lock, on descriptor 9, until this exits: store and list
# each read the history, then rewrite the times, and two at once would lose
# one's update. Waits up to $TIDE_CLIPBOARD_LOCK_WAIT seconds (10), then
# says why and returns 1.
lock_times() {
    if ! mkdir -p "${times%/*}" || ! exec 9>>"$times.lock"; then
        echo "$prog: couldn't open $times.lock, so old copies aren't forgotten" >&2
        return 1
    fi
    # flock is util-linux's, on every distro tide runs on. Without it, the
    # history goes on unlocked, saying so.
    if ! command -v flock >/dev/null 2>&1; then
        echo "$prog: flock isn't installed (util-linux), so a list and a copy at once may lose a copy's time" >&2
        return 0
    fi
    if ! flock -w "${TIDE_CLIPBOARD_LOCK_WAIT:-10}" 9; then
        echo "$prog: another tide clipboard held $times.lock, so old copies aren't forgotten this time" >&2
        return 1
    fi
}

# Forgets entries last copied before $age days ago, newest's time being
# now if given; one with no time yet starts its days now. The times file
# is rewritten to hold just the entries kept, and any whose delete failed,
# to try again. Each is deleted on its own: cliphist 0.4.0's delete reads
# only the first ID it's given. Says why on stderr and returns 1 if it
# can't.
expire() {
    _newest=${1:-}
    _now=${TIDE_CLIPBOARD_NOW:-$(date +%s)}
    _cutoff=$((_now - age * 86400))
    if ! _ids=$(cliphist list 2>&1); then
        case "$_ids" in
            *'please store something first'*) return 0 ;;
        esac
        echo "$prog: couldn't list the history to forget old copies: $_ids" >&2
        return 1
    fi
    if ! mkdir -p "${times%/*}" || ! _new=$(mktemp "$times.XXXXXX"); then
        echo "$prog: couldn't write $times, so old copies aren't forgotten" >&2
        return 1
    fi
    test -e "$times" || : >"$times"
    # The kept entries' times go to $_new; the old ones' IDs, one a line,
    # to be deleted.
    _old=$(printf '%s\n' "$_ids" | awk -F '\t' -v now="$_now" -v cutoff="$_cutoff" -v newest="$_newest" \
        -v keep="$_new" -v kept="$times" '
        BEGIN { while ((getline line < kept) > 0) { split(line, f, " "); t[f[1]] = f[2] } }
        $1 == "" { next }
        {
            at = ($1 == newest) ? now : (($1 in t) ? t[$1] : now)
            if (at + 0 < cutoff + 0) print $1
            else print $1 " " at > keep
        }')
    _failed=0
    for _id in $_old; do
        if ! _err=$(printf '%s\t\n' "$_id" | cliphist delete 2>&1); then
            echo "$prog: couldn't forget entry $_id, older than $age days: $_err" >&2
            # Kept as old as it was, so the next try deletes it.
            echo "$_id $_cutoff" >>"$_new"
            _failed=1
        fi
    done
    chmod 600 "$_new" && mv "$_new" "$times" || return 1
    return "$_failed"
}

store() {
    max=100
    while test $# -gt 0; do
        case "$1" in
            --max-items) test $# -ge 2 || usage; max=$2; shift 2 ;;
            --max-items=*) max=${1#*=}; shift ;;
            *) usage ;;
        esac
    done
    case "$max" in
        '' | *[!0-9]* | 0)
            echo "$prog store: --max-items must be a whole number above 0, not '$max'" >&2
            exit 2
            ;;
    esac
    # The Settings panel's Clipboard page (SPEC.md §16), as the shell writes
    # it: history off stores nothing, and its cap is the one kept.
    settings
    test "$history" = off && exit 0
    # wl-clipboard sets CLIPBOARD_STATE for a --watch command: nil when the
    # clipboard empties, which leaves nothing to store, and, on versions
    # newer than 2.2.1, sensitive for a password manager's copy.
    case "${CLIPBOARD_STATE:-data}" in
        sensitive | nil | clear) exit 0 ;;
    esac
    need wl-paste wl-clipboard
    need cliphist cliphist
    # Read just after the copy arrived, so a copy replaced within that
    # moment is judged by its replacement's types (SPEC.md §8.4).
    if ! types=$(wl-paste --list-types 2>&1); then
        echo "$prog store: couldn't list the copy's types, so it isn't stored, in case it's a password: $types" >&2
        exit 1
    fi
    if printf '%s\n' "$types" | grep -qx "$HINT"; then
        exit 0
    fi
    # Kept in a file on the runtime directory's tmpfs, readable by you
    # alone, to tell whether cliphist stored it: it stores nothing, and
    # still succeeds, for a copy that's only whitespace or too big.
    temporaries store
    cat >"$tmp"
    # From storing to rewriting the times, as one: a list meanwhile would
    # rewrite them from before the copy, losing its time. Without the lock
    # the copy is still stored, and old ones go next time.
    locked=no
    lock_times && locked=yes
    cliphist -max-items "$max" store <"$tmp" || exit 1
    test "$locked" = yes || exit 1
    # The copy just stored is the newest: its days start now, even when it
    # was in the history already. If the newest isn't the copy, cliphist
    # skipped it, and no entry's days start again.
    newest=$(cliphist list 2>/dev/null | head -n 1)
    newest=${newest%%	*}
    # $errs, temporaries' second file, holds the newest entry to compare.
    if test -n "$newest" && printf '%s\t\n' "$newest" | cliphist decode 2>/dev/null >"$errs" &&
        cmp -s "$tmp" "$errs"; then
        expire "$newest" || exit 1
    else
        expire || exit 1
    fi
}

list() {
    test $# -eq 0 || usage
    need cliphist cliphist
    # Old copies go even if nothing's been copied since they aged. A
    # failure is said, and the history listed as it is.
    age=7
    settings 2>/dev/null
    { lock_times && expire; } >&2 || true
    # Each preview is what the picker searches, and cliphist cuts it at 100
    # characters. 0.6.0 added -preview-width, which `version` lists among
    # its flags; older ones refuse the flag (0.4.0 has no `version` either),
    # and list at 100.
    if cliphist version 2>&1 | grep -q '^preview-width'; then
        set -- -preview-width 1000
    fi
    # Newer cliphists refuse to list before the first store makes
    # the database: "opening db: please store something first". That's an
    # empty history, unless the unit that stores isn't running (§8.4).
    if err=$(cliphist "$@" list 2>&1 >&3); then
        return 0
    fi 3>&1
    case "$err" in
        *'please store something first'*)
            state=$(systemctl --user is-active tide-clipboard.service 2>/dev/null)
            case "$state" in
                active | activating | reloading) return 0 ;;
            esac
            echo "$prog: tide-clipboard.service is ${state:-not running}, so nothing you copy is kept: systemctl --user enable --now tide-clipboard.service" >&2
            exit 1
            ;;
    esac
    printf '%s\n' "$err" >&2
    exit 1
}

# Two files on the runtime directory's tmpfs, $tmp and $errs, removed at
# exit, for `sub`.
temporaries() {
    if ! tmp=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/tide-clipboard.XXXXXX") ||
        ! errs=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/tide-clipboard.XXXXXX"); then
        echo "$prog $1: couldn't make a temporary file" >&2
        rm -f "${tmp:-}"
        exit 1
    fi
    trap 'rm -f "$tmp" "$errs"' EXIT
}

# wl-copy with its arguments, its stdin this one's, its stderr in $errs:
# exits 1, saying why, for `sub`, when it fails. Its stderr goes to a file,
# not $(...): once it owns the clipboard it forks, and the child keeps
# stderr open until the clipboard is replaced (wl-copy.c's
# did_set_selection_callback, 2.2.1), so a pipe would wait until then, and
# so would the picker's paste, which waits for this to exit.
wl_copy() {
    _sub=$1
    shift
    if ! wl-copy "$@" 2>"$errs"; then
        echo "$prog $_sub: wl-copy failed: $(cat "$errs")" >&2
        exit 1
    fi
}

copy() {
    test $# -eq 1 || usage
    entry_id "$1"
    need cliphist cliphist
    need wl-copy wl-clipboard
    # Through a file, so both halves' failures are seen: plain sh has no
    # pipefail.
    temporaries copy
    # The ID on stdin, as `list` printed it: cliphist 0.4.0's decode takes
    # no argument, and later ones read stdin when given none.
    if ! err=$(printf '%s\t\n' "$1" | cliphist decode 2>&1 >"$tmp"); then
        echo "$prog copy: cliphist couldn't find entry $1: $err" >&2
        exit 1
    fi
    wl_copy copy <"$tmp"
}

# TEXT onto the clipboard, as the picker's Characters tab copies one.
put() {
    test $# -eq 1 || usage
    need wl-copy wl-clipboard
    temporaries put
    wl_copy put -- "$1"
}

delete() {
    test $# -eq 1 || usage
    entry_id "$1"
    need cliphist cliphist
    # cliphist delete reads the lines `list` printed; the ID is all it uses.
    if ! err=$(printf '%s\t\n' "$1" | cliphist delete 2>&1); then
        echo "$prog delete: cliphist couldn't delete entry $1: $err" >&2
        exit 1
    fi
}

wipe() {
    notify=no
    case "${1:-}" in
        '') ;;
        --notify) notify=yes; test $# -eq 1 || usage ;;
        *) usage ;;
    esac
    if ! command -v cliphist >/dev/null 2>&1; then
        err="cliphist isn't installed, so there's no clipboard history to clear"
    elif err=$(cliphist wipe 2>&1); then
        rm -f "$times"
        exit 0
    else
        err="cliphist wipe failed: $err"
    fi
    echo "$prog wipe: $err" >&2
    if test "$notify" = yes; then
        # Best effort: the message is on stderr, which the shell logs, either way.
        if ! notify-send -a tide "Clipboard history not cleared" "$err"; then
            echo "$prog wipe: notify-send failed too" >&2
        fi
    fi
    exit 1
}

case "${1:-}" in
    store) shift; store "$@" ;;
    list) shift; list "$@" ;;
    copy) shift; copy "$@" ;;
    put) shift; put "$@" ;;
    delete) shift; delete "$@" ;;
    wipe) shift; wipe "$@" ;;
    *) usage ;;
esac
