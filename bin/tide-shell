#!/bin/sh
#
# tide-shell: what tide.service runs until the Quickshell shell
# exists (SPEC.md §5.2, §5.4; TODO.md "Transitional shell").
#
# For M2 the owners are the ones already in daily use, with the bar moving
# to Quickshell (M3):
#   - the bar, and with it the tray's org.kde.StatusNotifierWatcher: the
#     Quickshell shell (`qs -c tide`) when it's installed, in a Quickshell
#     that can load it, else waybar;
#   - swaync owns org.freedesktop.Notifications. conf's theme daemon starts
#     it, and waybar when that's the bar, with the light/dark style and
#     restarts them at each theme boundary, so it runs here rather than from
#     Hyprland's autostart. It's told which bar it is in $TIDE_BAR, so
#     it doesn't start waybar beside the Quickshell bar. Without conf there's
#     no theme daemon, and this starts swaync and waybar itself, in their
#     default style; the Quickshell shell still switches light and dark
#     (SPEC.md §15). With TIDE_NOTIFICATIONS=1 the Quickshell shell is the
#     notification server instead, and no swaync is started;
#   - the first polkit agent found on this system, unless the Quickshell
#     shell is the agent (TIDE_POLKIT=1, SPEC.md §5.2).
#
# A bar that falls back to waybar because qs is too old says so in a
# notification once swaync is up, as well as in the journal.
#
# All of them run in this unit's cgroup, so they stop with the session. The
# unit is Type=notify: this reports ready once both D-Bus names are owned, so
# no app starts before them, and only by processes in this unit, so a stale
# daemon from outside the session doesn't count. It waits
# $TIDE_SHELL_WAIT seconds at most (12, inside the unit's 15 s timeout).
# A tray that never appears fails the start, naming the missing owner: the
# bar didn't come up. A notification server that's late doesn't, once the
# tray is there: failing would take a working bar down with it. The shell
# reports ready, says what's missing, and looks for it for
# $TIDE_SHELL_LATE_WAIT seconds more, to say when it appears, or that it
# hasn't. Either report lists what the unit was running, each process with
# its age and command line, so one that was stuck is named. The polkit
# agent's registration can't be observed from here, so it isn't waited for,
# and its exit doesn't end the unit: an agent exits at once when another
# already holds the session, and restarting the shell for that only looped
# the bar at login. The agent alone is started again instead, backing off to
# once a minute while it keeps exiting, so it takes over once the other
# agent goes, and comes back after a crash. `tide doctor` names a
# missing agent or the other one.
#
#   $TIDE_SHELL_WAIT    seconds (1-3600) the owners get to appear (12)
#   $TIDE_SHELL_LATE_WAIT  seconds (1-3600) a late notification server is
#                             looked for after that (60)
#   $TIDE_SHELL_CGROUP  the cgroup directory whose processes those reports
#                             list (default: this unit's)
#   $TIDE_BAR           quickshell or waybar (default: quickshell when
#                             `qs` and the shell's config are installed, and
#                             qs is Quickshell 0.3 or newer)
#   $TIDE_THEME_DAEMON  the theme daemon (default: conf's, when there is
#                             one)
#   $TIDE_POLKIT        1 to have the Quickshell shell be the polkit
#                             agent, so none is started here; it needs the
#                             Quickshell bar (default: 0)
#   $TIDE_POLKIT_AGENT  a polkit agent to use instead of searching
#   $TIDE_POLKIT_AGENTS the paths searched, in order (default below)
#   $TIDE_AGENT_RETRY   seconds (1-60) before the agent's first restart (5),
#                             doubling to at most 60
#   $TIDE_WALLPAPER     the wallpaper swww or swaybg shows with waybar's
#                             bar, or the Quickshell shell's fallback
#                             (default: ~/.config/hypr/wallpaper.jpg, as the shell's)
#   $TIDE_INPUT_SETUP   a one-shot input setup (default: tide's
#                             apply-input.sh), run once the compositor is up
#   $TIDE_INPUT_WATCH   what sets up a device plugged in later, run for
#                             the session (default: tide's watch-input.sh)

prog=${0##*/}
# KDE's agent is always installed, since tide runs beside Plasma
# (SPEC.md §5.5), so the legacy desktops' agents that `make install` keeps out
# of the session (the autostart allowlist) aren't needed as fallbacks.
default_agents="
    /usr/libexec/hyprpolkitagent
    /usr/lib/hyprpolkitagent/hyprpolkitagent
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    /usr/libexec/polkit-gnome-authentication-agent-1
    /usr/lib/polkit-kde-authentication-agent-1
    /usr/libexec/polkit-kde-authentication-agent-1
    /usr/lib/*-linux-*/libexec/polkit-kde-authentication-agent-1
    /usr/libexec/kf6/polkit-kde-authentication-agent-1
"
default_theme_daemon=$HOME/.config/hypr/scripts/theme-daemon.sh
theme_daemon=${TIDE_THEME_DAEMON:-$default_theme_daemon}
# Where `make install` puts the shell, and where `qs -c tide` finds it.
shell_config=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/tide/shell.qml
# The oldest Quickshell the shell loads in: 0.3.0 added IdleInhibitor,
# IdleMonitor and Quickshell.Networking, and an older qs (Debian's 0.2.1)
# fails the whole bar on the first one. tide-doctor and scripts'
# setup-tide check the same.
min_quickshell=0.3
wallpaper=${TIDE_WALLPAPER:-$HOME/.config/hypr/wallpaper.jpg}
input_setup=${TIDE_INPUT_SETUP:-$HOME/.config/hypr/tide/apply-input.sh}
input_watch=${TIDE_INPUT_WATCH:-$HOME/.config/hypr/tide/watch-input.sh}

log() {
    echo "$prog: $*" >&2
}

polkit_agent() {
    if test -n "${TIDE_POLKIT_AGENT:-}"; then
        echo "$TIDE_POLKIT_AGENT"
        return
    fi
    # Unquoted, so a pattern such as Debian's multiarch directory expands.
    for a in ${TIDE_POLKIT_AGENTS-$default_agents}; do
        if is_program "$a"; then
            echo "$a"
            return
        fi
    done
}

# True when version $1 is at least $2, comparing dot-separated numbers.
version_at_least() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        n = split(a, x, "."); m = split(b, y, ".")
        for (i = 1; i <= (n > m ? n : m); i++)
            if (x[i] + 0 != y[i] + 0) exit !(x[i] + 0 > y[i] + 0)
    }'
}

# quickshell_ok: false when qs is older than $min_quickshell, with what it
# is in $qs_old. 0.2 prints its version as "quickshell 0.2.1, revision ...",
# 0.3 as "Quickshell 0.3.1 (revision ...)". A version it can't read is
# logged and let through, so a new format can't cost the bar.
quickshell_ok() {
    qs_path=$(command -v qs)
    if ! out=$(qs --version 2>&1); then
        log "couldn't tell which Quickshell $qs_path is (qs --version: $(printf '%s\n' "$out" | tail -n 1)); running its bar anyway"
        return 0
    fi
    version=$(printf '%s\n' "$out" | sed -n 's/^[Qq]uickshell \([0-9][0-9]*\.[0-9][0-9.]*\).*/\1/p' | head -n 1)
    if test -z "$version"; then
        log "couldn't tell which Quickshell $qs_path is (qs --version printed '$(printf '%s\n' "$out" | head -n 1)'); running its bar anyway"
        return 0
    fi
    version_at_least "$version" "$min_quickshell" && return 0
    qs_old="qs ($qs_path) is Quickshell $version, and tide's shell needs $min_quickshell or newer"
    qs_old_version=$version
    return 1
}

unit=tide.service

# True when a process in this unit owns the name. busctl failing is the
# normal answer while nobody owns it yet, so its message isn't shown then,
# but it's kept in $busctl_err for the report if the wait runs out: a
# missing user bus or busctl shows up there, not as a missing owner. A name
# owned from outside the unit sets $elsewhere to who has it, for the report.
owned() {
    elsewhere=
    if ! out=$(busctl --user status "$1" 2>&1); then
        busctl_err=$(printf '%s\n' "$out" | tail -n 1)
        return 1
    fi
    printf '%s\n' "$out" | grep -qx "UserUnit=$unit" && return 0
    _comm=$(printf '%s\n' "$out" | sed -n 's/^Comm=//p' | head -n 1)
    _pid=$(printf '%s\n' "$out" | sed -n 's/^PID=//p' | head -n 1)
    _where=$(printf '%s\n' "$out" | sed -n 's/^UserUnit=//p' | head -n 1)
    elsewhere="held by ${_comm:-a process} (pid ${_pid:-unknown}) in ${_where:-no user unit}"
    return 1
}

# unit_processes: logs what this unit is running, from its cgroup, each
# process with its age and command line, so a start that gave up names what
# was stuck: a gsettings, a flock, a swaync that never took its name. It
# only adds to a report, so whatever it can't do it says, and returns.
# Outside the unit (a run by hand) there's no cgroup of its own to list.
unit_processes() {
    _dir=${TIDE_SHELL_CGROUP:-}
    if test -z "$_dir"; then
        if ! _line=$(grep -m 1 '^0::' /proc/self/cgroup 2>&1); then
            log "couldn't list what $unit was running: /proc/self/cgroup has no cgroup v2 entry${_line:+ ($(printf '%s\n' "$_line" | tail -n 1))}"
            return 0
        fi
        _path=${_line#0::}
        case $_path in
            */"$unit") ;;
            *)
                log "couldn't list what $unit was running: this isn't running in it, but in the cgroup $_path"
                return 0
                ;;
        esac
        _dir=/sys/fs/cgroup$_path
    fi
    if ! _pids=$(cat "$_dir/cgroup.procs" 2>&1); then
        log "couldn't list what $unit was running ($(printf '%s\n' "$_pids" | tail -n 1))"
        return 0
    fi
    # One comma-separated list, as ps takes.
    _pids=$(printf '%s\n' "$_pids" | tr -s '\n' ',' | sed 's/,$//')
    if test -z "$_pids"; then
        log "couldn't list what $unit was running: $_dir/cgroup.procs is empty"
        return 0
    fi
    if ! _ps=$(ps -o pid=,etime=,args= -p "$_pids" 2>&1); then
        log "couldn't list what $unit was running (ps: $(printf '%s\n' "$_ps" | tail -n 1))"
        return 0
    fi
    log "what $unit was running (pid, age, command):"
    printf '%s\n' "$_ps" | while IFS= read -r _process; do
        log "$_process"
    done
}

# No cleanup trap: stopping the unit kills its whole cgroup, which also
# catches waybar and swaync, when the theme daemon started them rather than
# this, and the Quickshell shell.

# A bad setting or a missing piece fails the start at once, by name, before
# anything runs. It exits EX_CONFIG (78), which the unit doesn't restart on
# (RestartPreventExitStatus=78): retrying can't fix it.
EX_CONFIG=78
is_program() {
    test -f "$1" && test -x "$1"
}

# At most 3600, which also keeps the arithmetic below in range.
wait=${TIDE_SHELL_WAIT:-12}
case "$wait" in
    '' | *[!0-9]* | 0* | ?????*) wait_ok=no ;;
    *) test "$wait" -le 3600 && wait_ok=yes || wait_ok=no ;;
esac
if test "$wait_ok" = no; then
    log "TIDE_SHELL_WAIT must be a whole number of seconds from 1 to 3600, not '$wait'"
    exit $EX_CONFIG
fi

# The unit's TimeoutStartSec=15 fits the default 12 s. A longer wait asks
# systemd for the extra time, or the unit's timeout would cut it short and
# lose the report below. If systemd refuses, the unit's timeout stands.
if test "$wait" -gt 12 && ! systemd-notify "EXTEND_TIMEOUT_USEC=$(((wait + 3) * 1000000))"; then
    log "couldn't extend the start timeout for TIDE_SHELL_WAIT=$wait; the unit's own timeout applies"
fi

late_wait=${TIDE_SHELL_LATE_WAIT:-60}
case "$late_wait" in
    '' | *[!0-9]* | 0* | ?????*) late_wait_ok=no ;;
    *) test "$late_wait" -le 3600 && late_wait_ok=yes || late_wait_ok=no ;;
esac
if test "$late_wait_ok" = no; then
    log "TIDE_SHELL_LATE_WAIT must be a whole number of seconds from 1 to 3600, not '$late_wait'"
    exit $EX_CONFIG
fi

# At least 1, so a failing agent can't respawn in a tight loop, and no
# leading zero, which the doubling below would read as octal.
agent_retry=${TIDE_AGENT_RETRY:-5}
case "$agent_retry" in
    '' | *[!0-9]* | 0* | ???*) agent_retry_ok=no ;;
    *) test "$agent_retry" -le 60 && agent_retry_ok=yes || agent_retry_ok=no ;;
esac
if test "$agent_retry_ok" = no; then
    log "TIDE_AGENT_RETRY must be a whole number of seconds from 1 to 60, not '$agent_retry'"
    exit $EX_CONFIG
fi

case "${TIDE_POLKIT:-0}" in
    0 | 1) ;;
    *)
        log "TIDE_POLKIT must be 1 (the shell is the polkit agent) or 0, not '$TIDE_POLKIT'"
        exit $EX_CONFIG
        ;;
esac

if test -n "${TIDE_POLKIT_AGENT:-}" && ! is_program "$TIDE_POLKIT_AGENT"; then
    log "TIDE_POLKIT_AGENT is '$TIDE_POLKIT_AGENT', which isn't an executable file"
    exit $EX_CONFIG
fi

if test -n "${TIDE_INPUT_SETUP:-}" && ! is_program "$TIDE_INPUT_SETUP"; then
    log "TIDE_INPUT_SETUP is '$TIDE_INPUT_SETUP', which isn't an executable file"
    exit $EX_CONFIG
fi
if test -n "${TIDE_INPUT_WATCH:-}" && ! is_program "$TIDE_INPUT_WATCH"; then
    log "TIDE_INPUT_WATCH is '$TIDE_INPUT_WATCH', which isn't an executable file"
    exit $EX_CONFIG
fi
if test -n "${TIDE_WALLPAPER:-}" && ! test -f "$TIDE_WALLPAPER"; then
    log "TIDE_WALLPAPER is '$TIDE_WALLPAPER', which isn't a file"
    exit $EX_CONFIG
fi
# The Quickshell shell draws it from a file: URL, which can't be relative,
# so one found from here is passed on as from here.
case ${TIDE_WALLPAPER:-} in
'' | /*) ;;
*)
    TIDE_WALLPAPER=$PWD/$TIDE_WALLPAPER
    export TIDE_WALLPAPER
    wallpaper=$TIDE_WALLPAPER
    ;;
esac

case "${TIDE_BAR:-}" in
    '')
        if ! command -v qs >/dev/null 2>&1 || ! test -f "$shell_config"; then
            bar=waybar
        elif ! quickshell_ok; then
            log "$qs_old, so the bar is waybar; \`tide doctor\` says how to fix it"
            bar=waybar
            bar_notice="qs is Quickshell $qs_old_version, and tide needs $min_quickshell or newer. Run tide's installer (install/tide-setup), then log in again; \`tide doctor\` says more."
        else
            bar=quickshell
        fi
        ;;
    quickshell | waybar) bar=$TIDE_BAR ;;
    *)
        log "TIDE_BAR must be quickshell or waybar, not '$TIDE_BAR'"
        exit $EX_CONFIG
        ;;
esac
if test "$bar" = quickshell && ! command -v qs >/dev/null 2>&1; then
    log "TIDE_BAR is quickshell, but qs (Quickshell) isn't installed"
    exit $EX_CONFIG
fi
if test "$bar" = quickshell && ! test -f "$shell_config"; then
    log "TIDE_BAR is quickshell, but there's no shell at $shell_config; run \`make install\` in tide"
    exit $EX_CONFIG
fi
if test "${TIDE_BAR:-}" = quickshell && ! quickshell_ok; then
    log "TIDE_BAR is quickshell, but $qs_old"
    exit $EX_CONFIG
fi
export TIDE_BAR="$bar"

# conf's theme daemon is optional: without conf, this starts swaync, and
# waybar when that's the bar, itself. One that's set but missing is still
# an error.
if test -n "${TIDE_THEME_DAEMON:-}" && ! is_program "$theme_daemon"; then
    log "TIDE_THEME_DAEMON is '$theme_daemon', which isn't an executable file"
    exit $EX_CONFIG
fi
# Who serves notifications doesn't depend on the theme daemon: with
# TIDE_NOTIFICATIONS=1 the Quickshell shell does, and swaync isn't needed.
if test "${TIDE_NOTIFICATIONS:-}" = 1 && test "$bar" = quickshell; then
    notifications_owner="the Quickshell shell"
else
    notifications_owner=swaync
fi
if is_program "$theme_daemon"; then
    start_swaync=no
    start_waybar=no
else
    theme_daemon=
    if test "$notifications_owner" = swaync; then start_swaync=yes; else start_swaync=no; fi
    if test "$bar" = waybar; then start_waybar=yes; else start_waybar=no; fi
fi
# Wherever swaync is to serve notifications, it has to be installed: the
# theme daemon starts it as this would, and without it the name would be
# waited for, in vain, at every start.
if test "$notifications_owner" = swaync && ! command -v swaync >/dev/null 2>&1; then
    if test -n "$theme_daemon"; then
        log "swaync, which the theme daemon ($theme_daemon) starts to serve notifications, isn't installed"
    else
        log "no theme daemon at $default_theme_daemon, and swaync, which serves notifications without one, isn't installed"
    fi
    exit $EX_CONFIG
fi
if test -z "$theme_daemon"; then
    if test "$start_waybar" = yes && ! command -v waybar >/dev/null 2>&1; then
        log "the bar is waybar, but waybar isn't installed"
        exit $EX_CONFIG
    fi
    # Fine without conf: the Quickshell shell sets light and dark itself
    # (SPEC.md §15); only conf's styles for swaync and waybar are missed.
    case $start_swaync$start_waybar in
        yesyes) own="swaync and waybar start in their default style, with no light and dark" ;;
        yesno) own="swaync starts in its default style" ;;
        *) own="the Quickshell shell is the notification server (TIDE_NOTIFICATIONS=1)" ;;
    esac
    log "no theme daemon at $default_theme_daemon (conf's), so $own"
fi
# The theme daemon runs under a subshell that records its exit status, so an
# exit during startup is reported as itself rather than as missing owners.
theme_status=$(mktemp) || {
    log "couldn't create a temporary file for the theme daemon's status"
    exit 1
}
# The agent's restart loop ends with the shell; systemd stopping the unit
# would catch it anyway, but the shell can exit without that. A loop that
# has given up says so in $agent_done first, and isn't signaled: the shell
# may have reaped it already, and its pid may belong to another process.
# It's still waited for, since it says so just before it exits: wait only
# ever waits on this shell's own child, and returns at once for one already
# reaped. The same goes for the loop that looks for a late notification
# server.
agent_loop=
agent_done=
late_loop=
late_done=
# shellcheck disable=SC2317,SC2329  # run from the exit trap
on_exit() {
    if test -n "$agent_loop"; then
        test -s "$agent_done" || kill "$agent_loop"
        wait "$agent_loop"
    fi
    if test -n "$late_loop"; then
        test -s "$late_done" || kill "$late_loop"
        wait "$late_loop"
    fi
    rm -f "$theme_status" "$agent_done" "$late_done"
}
trap on_exit EXIT
theme_pid=
if test -n "$theme_daemon"; then
    (
        "$theme_daemon"
        echo $? > "$theme_status"
    ) &
    theme_pid=$!
fi

# Runs a long-lived owner under a watcher subshell, so its exit ends this
# script too and systemd restarts the unit.
trap 'exit 1' USR1
supervise() {
    _what=$1
    shift
    (
        "$@"
        log "$_what exited ($?)"
        kill -USR1 $$
    ) &
}


# The Quickshell shell is the agent only where it runs: under waybar the
# agent found here stands in, so privileged actions can still ask.
agent=
if test "${TIDE_POLKIT:-0}" = 1 && test "$bar" = quickshell; then
    log "the Quickshell shell is the polkit agent (TIDE_POLKIT=1), so no other is started"
else
    if test "${TIDE_POLKIT:-0}" = 1; then
        log "TIDE_POLKIT=1 makes the Quickshell shell the polkit agent, but the bar is waybar, so the shell isn't running; starting another agent instead"
    fi
    agent=$(polkit_agent)
    if test -z "$agent"; then
        # Not fatal: the session works, but privileged actions can't prompt.
        log "no polkit agent found; install hyprpolkitagent or polkit-gnome"
    fi
fi
if test -n "$agent"; then
    agent_done=$(mktemp) || {
        log "couldn't create a temporary file for the polkit agent's restart loop"
        exit 1
    }
    (
        # The agent and the backoff sleep run in the background and are
        # waited for, so a TERM from the shell's exit trap is handled at
        # once: it stops whichever is running and waits for it, so nothing
        # outlives the shell, registered with polkit or holding the journal.
        # It's stopped with KILL, not TERM: until a child dash forked has
        # exec'd, it still has this trap's handler, so a TERM sent then is
        # caught and dropped, and the agent runs on with the trap waiting
        # on it. A unit stop still TERMs the agent itself, from systemd.
        child=
        trap 'test -z "$child" || kill -KILL "$child"; test -z "$child" || wait "$child"; exit 0' TERM
        delay=$agent_retry
        while :; do
            started=$(date +%s)
            "$agent" &
            child=$!
            wait "$child"
            agent_status=$?
            child=
            # One that ran a minute had registered, so this is a new
            # failure: back to the short delay.
            if test "$(($(date +%s) - started))" -ge 60; then
                delay=$agent_retry
            fi
            log "the polkit agent exited ($agent_status); the shell keeps running and starts it again in $delay s (\`tide doctor\` names any other agent registered for this session)"
            sleep "$delay" &
            child=$!
            # Without a working sleep there's no backoff, so stop rather
            # than respawn the agent in a tight loop.
            if ! wait "$child"; then
                log "sleep $delay failed; not starting the polkit agent again"
                echo gave-up > "$agent_done"
                exit 1
            fi
            child=
            delay=$((delay * 2))
            test "$delay" -le 60 || delay=60
        done
    ) &
    agent_loop=$!
fi

# The Quickshell bar is an owner: it holds the tray watcher. It starts
# after the agent's restart loop is recorded, so if it exits at once, the
# exit trap still finds the loop to stop.
if test "$bar" = quickshell; then
    supervise "the Quickshell shell (qs -c tide)" qs -c tide
    tray_owner="the Quickshell shell's tray"
else
    tray_owner="waybar's tray"
fi
# What the theme daemon would start, when there's none.
test "$start_swaync" = no || supervise swaync swaync
# tide-waybar, beside this script, gives it tide's config where you have none.
test "$start_waybar" = no || supervise waybar "$(dirname -- "$0")/tide-waybar"

# The wallpaper (§5.2 puts it in the shell). The Quickshell shell draws its
# own (§15); with waybar's bar, a daemon does. Not an owner apps wait for,
# so it isn't part of the ready check, but its daemon is supervised like
# one. swaybg stands in where swww isn't packaged (Ubuntu 26.04): it shows
# one image and needs no client, so there's nothing to wait for.
wallpaper_pending=no
if test "$bar" = quickshell; then
    : # the shell's Wallpaper.qml, which takes $TIDE_WALLPAPER too
elif command -v swww-daemon >/dev/null 2>&1 && command -v swww >/dev/null 2>&1; then
    supervise "the wallpaper daemon (swww-daemon)" swww-daemon
    wallpaper_pending=yes
elif command -v swaybg >/dev/null 2>&1; then
    if test -r "$wallpaper"; then
        supervise "the wallpaper daemon (swaybg)" swaybg -m fill -i "$wallpaper"
    else
        log "no wallpaper at $wallpaper"
    fi
elif command -v swww-daemon >/dev/null 2>&1; then
    log "swww-daemon is installed but its client, swww, isn't, and swaybg isn't installed either; no wallpaper"
else
    log "neither swww nor swaybg is installed; no wallpaper"
fi

# Sets the wallpaper once swww-daemon answers. Returns false while it
# doesn't, so the wait loops below retry. `swww query` failing is the normal
# answer while the daemon starts, so its message isn't shown then, but the
# last one is kept in $swww_err for the report if the wait runs out.
swww_err=
set_wallpaper() {
    if ! out=$(swww query 2>&1); then
        swww_err=$(printf '%s\n' "$out" | tail -n 1)
        return 1
    fi
    if ! test -r "$wallpaper"; then
        log "no wallpaper at $wallpaper"
    elif ! swww img "$wallpaper"; then
        log "swww img $wallpaper failed"
    fi
    return 0
}

# Input devices, once (the compositor is up: this unit starts after uwsm
# finalize). A failure is reported and the session goes on with defaults.
# Without the setting, tide's script is optional: not installed, no input setup.
# It's said, though, as one that should be there and isn't leaves devices
# with their defaults and no other sign of why.
if is_program "$input_setup"; then
    "$input_setup" || log "$input_setup failed ($?); input devices keep their defaults"
else
    log "no $input_setup, so input devices keep their defaults"
fi
# And a device plugged in later, such as a mouse a KVM switch hands back:
# Hyprland has no event for one, so tide's watcher runs for the session, in
# this unit's cgroup, which stopping the unit ends; on tidewm it follows
# tidewm's input event. It logs its own failures.
if is_program "$input_watch"; then
    "$input_watch" &
else
    log "no $input_watch, so a mouse, touchpad or keyboard plugged in after login, such as through a KVM switch, keeps its defaults"
fi

# $late is the notification server while it has no owner, and $missing the
# tray: only the tray's absence fails the start once the wait runs out.
late=
missing=
busctl_err=
i=0
while :; do
    if test "$wallpaper_pending" = yes && set_wallpaper; then
        wallpaper_pending=no
    fi
    # Whether the daemon had exited is read before the names, so names it
    # claimed just before exiting still count.
    exited=no
    test -s "$theme_status" && exited=yes
    late=
    missing=
    # Only this round's busctl errors, so the report can't give a stale one.
    busctl_err=
    owned org.freedesktop.Notifications ||
        late=" org.freedesktop.Notifications ($notifications_owner${elsewhere:+; $elsewhere})"
    owned org.kde.StatusNotifierWatcher ||
        missing=" org.kde.StatusNotifierWatcher ($tray_owner${elsewhere:+; $elsewhere})"
    # The wallpaper doesn't hold up ready; it keeps trying below.
    test -z "$late$missing" && break
    if test "$exited" = yes; then
        log "the theme daemon exited ($(cat "$theme_status")) before its owners were up; no owner in $unit for:$late$missing"
        unit_processes
        exit 1
    fi
    if test "$i" -ge "$((wait * 10))"; then
        if test -z "$missing"; then
            # The bar is up. Failing now would have systemd kill it, three
            # times over, for a server that may only be slow.
            log "no owner in $unit for:$late after ${wait} s${busctl_err:+ (last busctl error: $busctl_err)}; the bar is up, so the shell goes on without notifications for now, and says here when $notifications_owner has the name"
            unit_processes
            break
        fi
        log "not ready after ${wait} s; no owner in $unit for:$late$missing${busctl_err:+ (last busctl error: $busctl_err)}"
        unit_processes
        exit 1
    fi
    sleep 0.1
    i=$((i + 1))
done

if ! systemd-notify --ready; then
    log "systemd-notify --ready failed"
    exit 1
fi

# A bar that fell back says so where it's seen, not only in this log
# (SPEC.md §1, principle 6). It's sent once swaync owns the notification
# name (the wait above, or the loop below for a late one), so there's a
# server to show it. It's critical, so it stays until it's dismissed.
# Failing to show it doesn't stop the session, but is logged.
show_bar_notice() {
    test -n "${bar_notice:-}" || return 0
    if ! command -v notify-send >/dev/null 2>&1; then
        log "notify-send isn't installed, so only this log says the bar is waybar"
    elif ! out=$(notify-send --urgency=critical --app-name=tide "tide's bar couldn't start" "$bar_notice" 2>&1); then
        log "couldn't show that the bar is waybar (notify-send: $(printf '%s\n' "$out" | tail -n 1))"
    fi
}

# A late notification server is looked for in the background, so the log
# says when notifications started working, or that they haven't after
# $late_wait s. It only reports: it never ends the shell, and the shell's
# exit stops it (the exit trap), as it does the agent's loop, whose way of
# stopping its sleep this follows. Once it has finished it says so in
# $late_done, and isn't signaled.
if test -z "$late"; then
    show_bar_notice
elif ! late_done=$(mktemp); then
    late_done=
    log "couldn't create a temporary file for the notification server's check, so this log won't say when $notifications_owner has the name; \`tide doctor\` does"
else
    (
        child=
        trap 'test -z "$child" || kill -KILL "$child"; test -z "$child" || wait "$child"; exit 0' TERM
        began=$(date +%s)
        while :; do
            busctl_err=
            if owned org.freedesktop.Notifications; then
                log "org.freedesktop.Notifications has its owner now ($notifications_owner), $(($(date +%s) - began)) s after the shell went on without it; notifications work"
                show_bar_notice
                break
            fi
            if test "$(($(date +%s) - began))" -ge "$late_wait"; then
                log "still no owner in $unit for org.freedesktop.Notifications ($notifications_owner${elsewhere:+; $elsewhere}) $late_wait s later${busctl_err:+ (last busctl error: $busctl_err)}; the shell stays up without notifications and stops looking: run \`tide doctor\`"
                test -z "${bar_notice:-}" || log "so only this log says the bar is waybar"
                break
            fi
            sleep 0.1 &
            child=$!
            if ! wait "$child"; then
                log "sleep 0.1 failed; no longer looking for the owner of org.freedesktop.Notifications"
                break
            fi
            child=
        done
        echo finished > "$late_done"
    ) &
    late_loop=$!
fi

if test "$wallpaper_pending" = yes; then
    j=0
    until set_wallpaper; do
        # The theme daemon exiting ends the unit (below), wallpaper or not.
        test -s "$theme_status" && break
        if test "$j" -ge "$((wait * 10))"; then
            log "swww-daemon never answered; no wallpaper${swww_err:+ (last swww query error: $swww_err)}"
            break
        fi
        sleep 0.1
        j=$((j + 1))
    done
fi

# Runs for the session. Without a theme daemon, the first owner to exit
# ends it, through supervise's signal, which interrupts the wait.
if test -z "$theme_pid"; then
    wait
    log "every process the shell started has exited"
    exit 1
fi
# The theme daemon never exits on its own, so its end is this unit's end,
# and systemd restarts it (Restart=on-failure).
wait "$theme_pid"
status=$(cat "$theme_status")
log "the theme daemon exited ($status)"
exit $((status == 0 ? 1 : status))
