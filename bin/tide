#!/bin/sh
#
# tide: the session's command-line helpers.
#
#   tide launch [--workspace NAME] [--app ID]... [--] COMMAND [ARG...]
#   tide launch --background [--unless-running] [--] COMMAND [ARG...]
#
#     Starts an app the way the key bindings and the launcher do
#     (SPEC.md §5.4, §14.3):
#       1. records a one-shot focus grant for the app with the focus guard,
#          so its first window may take focus. ID defaults to COMMAND's
#          basename, plus the desktop ID and StartupWMClass of each desktop
#          entry whose Exec runs it. Repeat --app for an app whose window class isn't known
#          for sure: a window of any ID uses the one grant (the launcher
#          passes a desktop entry's ID and program name). '*' grants the
#          first window of any app, for a
#          wrapper script whose app isn't known in advance. xdg-open
#          and gio open grant the default app for the target's type
#          (xdg-mime), or '*' when it can't be found. It comes
#          first but for reading the focused workspace (one hyprctl call,
#          below), so a key press or focus change while the shell is still
#          starting cancels it, and its 10 s run from the key press that
#          launched it;
#       2. waits for the shell, so no app starts before the notification,
#          tray and polkit owners exist. The wait is bounded (15 s, or
#          $TIDE_LAUNCH_WAIT), and the app starts anyway after it,
#          because a terminal is how you'd fix a stuck start;
#       3. runs it with `uwsm app`, in app-graphical.slice, so the app
#          outlives a shell restart.
#     --workspace NAME asks for the app's first window on the workspace
#     named NAME, made if it's new (SPEC.md §6.5): the guard takes it there
#     as it opens, and focus follows (the name prompt). If you move on
#     first, the grant is canceled and the window opens where you are,
#     unfocused, like any other.
#     Without --workspace, a launch from the home workspace (the one
#     ~/.config/hypr/tide-workspaces.lua names) asks the shell's name prompt
#     for a workspace first, and waits for its answer on a FIFO in
#     $XDG_RUNTIME_DIR, then launches there as --workspace does, still from
#     here, in its caller's environment. One of home's apps is answered
#     home at once; Esc launches nothing. With no shell to ask, it launches
#     where you are, and says why.
#     The app gets TIDE_WORKSPACE (§6.5): NAME, or else the focused
#     workspace's name, with only its letters and digits (any script,
#     NFC-normalized) kept, so a shpool or tmux session can be named after
#     it. If the focused workspace can't be read, or tide-grant can't keep
#     its letters and digits, it's empty, and the launch says why.
#     Outside a tide session it just runs COMMAND.
#     --background starts it as the session's Start at login does (SPEC.md
#     §16): with no focus grant and no name prompt, so nothing it opens
#     takes focus, and its windows go where Hyprland's rules put them. It
#     still waits for the shell, and still runs in app-graphical.slice.
#     It takes no --workspace or --app, which only a grant carries. Just
#     before it starts the command, it prints "tide launch: starting" on
#     stdout, so a caller starting several can start them in order.
#     --unless-running exits 0 without starting it when a process of yours
#     already runs its program, past wrappers, as `pgrep -x` matches it on
#     its first 15 characters (a process's name is no longer). Without
#     pgrep, or if it fails, it starts it anyway, and says why.
#
#   tide workspace
#
#     Prints the focused workspace's name as TIDE_WORKSPACE holds it, for
#     a script that wants the workspace it's on now rather than the one it
#     started on (SPEC.md §6.5). Exits 1, saying why, if it can't be read.
#
#   tide grant ID...
#
#     Records only the focus grant, for an app that something other than
#     a launch is about to bring up: the shell grants the app a clicked
#     notification came from (SPEC.md §9). Several IDs share one grant: a
#     Chrome site open as an `--app` window in two profiles is two classes. If nothing uses the grant
#     before it runs out, and you haven't moved on, the guard focuses the
#     app's most recently focused window instead. Exits 1 if the grant
#     couldn't be recorded. Outside a tide session there's no guard, and it
#     does nothing.
#
#   tide focus ID...
#
#     Focuses the most recently focused window of any ID now, switching to its
#     workspace: what a click on a notification center entry does when its
#     notification is gone (SPEC.md §9). Exits 1 if the guard couldn't be
#     asked. Outside a tide session it does nothing.
#
#   tide autostart-allowed UNIT
#
#     The condition on every XDG autostart unit in the tide session
#     (systemd/user/app-.service.d/tide-autostart.conf, SPEC.md §5.4):
#     exits 0 if UNIT's desktop entry is on the autostart allowlist, 1,
#     which skips the unit, if it isn't, and 3 if it can't tell (an
#     unreadable list), which the drop-in turns into a failed unit. The
#     file holds one desktop ID per line; lines starting with # are comments,
#     so an ID that itself starts with # is written escaped, as \x23ID. The allowlist is the tray applets the
#     bar still relies on, plus the desktop IDs, one per line, in
#     ${XDG_CONFIG_HOME:-~/.config}/tide/autostart.
#
#   tide brightness STEP
#
#     Changes the backlight with `brightnessctl set STEP` (5%+, 5%-, 40%)
#     and shows the new level on the shell's OSD (SPEC.md §9). The
#     brightness keys run it; hypridle dims with brightnessctl itself, so
#     dimming never flashes the OSD. Exits 1 if brightnessctl fails. The
#     OSD is extra: with no shell to show it (waybar's fallback, or
#     outside tide), the level changes and nothing else happens; a
#     shell that fails to show it is reported, and still exits 0.
#
#   tide idle-lock
#
#     Locks the session for idleness: hypridle's lock step runs it in
#     place of `loginctl lock-session`. It writes the time to
#     $XDG_RUNTIME_DIR/tide-lock-idle, then runs `loginctl lock-session`,
#     and tide-lock opens in its screensaver face when it finds the flag
#     fresh (SPEC.md §10). Every lock still goes through logind; the flag
#     only picks the face. Without XDG_RUNTIME_DIR, or if the flag can't
#     be written, it still locks, on the password face, and says why.
#
#   tide idle-suspend [--unplugged | --cancel]
#
#     Suspends for idleness: hypridle's 30-minute step runs it in place of
#     `systemctl suspend` (SPEC.md §10). It suspends only on battery, as
#     UPower reports it; on AC the displays just stay off, unless the Idle
#     page's Suspend on AC is on, as the shell writes it to
#     ~/.config/hypr/tide-idle-suspend.conf. If it can't tell, it says so
#     and exits 1 without suspending. A failed suspend exits with its
#     status: polkit refuses one from a session in the background ("Access
#     denied").
#     On AC, it leaves a flag, $XDG_RUNTIME_DIR/tide-idle-suspend, so
#     unplugging later still suspends. The shell runs it with --unplugged
#     when UPower reports the switch to battery: if the flag is there, it
#     removes it and suspends as above. hypridle's suspend step runs it
#     with --cancel on the first input after the step, which removes the
#     flag: someone is back.
#
#   tide prompt-focus
#
#     Asks the focus guard whether a polkit prompt opening now may take
#     the keyboard (SPEC.md §14.1): exits 0 if you pressed a key in the last
#     2 s, so the prompt follows your pkexec or button, and 1 if not. The
#     shell's polkit agent asks it, and otherwise offers the prompt through
#     a notification. Exits 2, saying why, if it can't tell: outside a tide
#     session, or when the guard can't be asked.
#
#   tide clipboard store | list | copy ID | delete ID | wipe
#
#     The clipboard history behind the picker on Super+C (SPEC.md §8.4);
#     see tide-clipboard.
#
#   tide doctor
#
#     Checks the running session and prints one line per problem, with
#     its fix (SPEC.md §5.4); see tide-doctor.

prog=${0##*/}
nl='
'

usage() {
    echo "usage: $prog launch [--workspace NAME] [--app ID]... [--] COMMAND [ARG...]" >&2
    echo "       $prog launch --background [--unless-running] [--] COMMAND [ARG...]" >&2
    echo "       $prog workspace" >&2
    echo "       $prog grant ID..." >&2
    echo "       $prog focus ID..." >&2
    echo "       $prog autostart-allowed UNIT" >&2
    echo "       $prog brightness STEP" >&2
    echo "       $prog idle-lock" >&2
    echo "       $prog idle-suspend [--unplugged | --cancel]" >&2
    echo "       $prog prompt-focus" >&2
    echo "       $prog clipboard store | list | copy ID | delete ID | wipe" >&2
    echo "       $prog doctor" >&2
    exit 2
}

in_tide() {
    case ":${XDG_CURRENT_DESKTOP:-}:" in
        *:tide:*) return 0 ;;
    esac
    return 1
}

# `systemctl start` blocks until the shell reports ready, and returns at once
# when it already has. The bound is our own: the units' timeouts chain (the
# shell's starts only after hypridle's), so they don't bound this.
wait_for_shell() {
    bound=${TIDE_LAUNCH_WAIT:-15}
    # A whole number of seconds from 1 to 3600: `timeout 0` never times out.
    case "$bound" in
        '' | *[!0-9]* | 0* | ?????*) bound_ok=no ;;
        *) test "$bound" -le 3600 && bound_ok=yes || bound_ok=no ;;
    esac
    if test "$bound_ok" = no; then
        echo "$prog launch: TIDE_LAUNCH_WAIT must be a whole number of seconds from 1 to 3600, not '$bound'; waiting 15 s" >&2
        bound=15
    fi
    if ! err=$(timeout "$bound" systemctl --user start tide.service 2>&1); then
        echo "$prog launch: the shell isn't ready (${err:-no answer in $bound s}); starting $1 anyway" >&2
    fi
}

# The guard lives in Hyprland's Lua config (hypr/tide/focus.lua), so the
# grant goes in through `hyprctl eval`, with the ID escaped for a Lua string.
# Returns 1, having said why, when the guard didn't take it; $2 names the
# subcommand for the message, $3 the guard's function (grant by default),
# and $4 what the call does, for the messages (a focus grant by default).
# $5, if given, is the call's argument already written as Lua, for a list
# of IDs; $1 then only names them in the messages.
grant() {
    what=${4:-record a focus grant}
    if ! command -v hyprctl >/dev/null 2>&1; then
        echo "$prog $2: no hyprctl, so couldn't $what for $1" >&2
        return 1
    fi
    reply=$(hyprctl eval "tide_focus.${3:-grant}(${5:-$(lua_string "$1")})" 2>&1)
    if test "$reply" != ok; then
        echo "$prog $2: couldn't $what for $1: $reply" >&2
        return 1
    fi
}

# $1 as a Lua string literal.
lua_string() {
    printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"
}

grant_only() {
    ids_arg "$@"
    if ! in_tide; then
        exit 0
    fi
    grant "$ids_names" grant grant_or_recent "" "$ids_lua" || exit 1
}

# The IDs given to grant or focus, as $ids_names for the messages and
# $ids_lua for the guard: a Lua string for one, a list for several.
ids_arg() {
    if test $# -eq 0; then
        usage
    fi
    ids_names=""
    ids_lua=""
    for id do
        if test -z "$id"; then
            usage
        fi
        ids_names="${ids_names:+$ids_names, }$id"
        ids_lua="${ids_lua:+$ids_lua, }$(lua_string "$id")"
    done
    if test $# -gt 1; then
        ids_lua="{ $ids_lua }"
    fi
}

# The notification center's click on a past notification (SPEC.md §9):
# the guard focuses the app's most recently focused window, switching
# workspace, at once rather than waiting on a grant.
focus_app() {
    ids_arg "$@"
    if ! in_tide; then
        exit 0
    fi
    grant "$ids_names" focus focus_recent "focus its window" "$ids_lua" || exit 1
}

# The program a command runs, as written, past wrappers (`env VAR=x editor`
# runs editor), from tide-grant, which reads wrappers the way it reads a
# terminal's. Without tide-grant it's the first word, and desktop_classes
# says so; if tide-grant fails, that's said here.
command_program() {
    if ! command -v tide-grant >/dev/null 2>&1; then
        printf '%s\n' "$1"
        return 0
    fi
    if ! runs=$(tide-grant --program -- "$@"); then
        echo "$prog launch: tide-grant couldn't read the program $1 runs; granting $1" >&2
        runs=$1
    fi
    # A command that runs no program (`env --help`) is granted its first word.
    printf '%s\n' "${runs:-$1}"
}

# The window classes the desktop entries for a command say its window may
# have (SPEC.md §14.3), one per line, from tide-grant. $1 is the program's
# name and the rest is the command: a path (/opt/vendor/editor) matches only
# the entries that run that file, and settings before the program (`env
# MODE=writer suite`) only the entries run with the same. Without
# tide-grant, or if it fails, the grant names the program alone, and says
# why.
desktop_classes() {
    name=$1
    shift
    if ! command -v tide-grant >/dev/null 2>&1; then
        echo "$prog launch: no tide-grant, so $name's desktop entries weren't read; granting $name alone (make install builds it)" >&2
        return 0
    fi
    if ! tide-grant --classes -- "$@"; then
        echo "$prog launch: tide-grant couldn't read $name's desktop entries; granting $name alone" >&2
    fi
}

# The window classes of the app an opener command (xdg-open or gio open
# TARGET) hands its target to, one per line, from tide-grant --opener: the
# default app for the target's type and what its desktop entry names. It
# prints nothing for a target it can't type, several targets, a command
# run with settings of its own (`env XDG_DATA_HOME=… xdg-open URL`, which
# may open another app), or a type with no default app, and the launch
# then grants any app's window; tide-grant says why where there's
# something to say, and a failed lookup is reported here too. It returns
# 3 for a command that runs no opener after all (`gio trash`), which the
# launch grants its program instead.
opener_classes() {
    if ! command -v tide-grant >/dev/null 2>&1; then
        # Without it, `gio open` is told from the rest by its first words.
        case "${1##*/}" in
            gio) test "${2:-}" = open || return 3 ;;
        esac
        echo "$prog launch: no tide-grant, so the app $1 opens with wasn't found; granting any app's window (make install builds it)" >&2
        return 0
    fi
    status=0
    tide-grant --opener -- "$@" || status=$?
    case $status in
        0) ;;
        3) return 3 ;;
        *) echo "$prog launch: tide-grant couldn't find the app $1 opens with; granting any app's window" >&2 ;;
    esac
}

# A workspace's name as TIDE_WORKSPACE holds it (SPEC.md §6.5): only its
# letters and digits, in any script, NFC-normalized, so `PR-12 login` is
# PR12login and `Café` stays Café. tide-grant does it with Go's Unicode
# tables: tr works on bytes, and [[:alnum:]] means what the locale says.
# Fails, having said why, without it; $2 names the subcommand.
sanitized() {
    if ! command -v tide-grant >/dev/null 2>&1; then
        echo "$prog $2: no tide-grant, so the workspace's name couldn't be kept to its letters and digits (make install builds it)" >&2
        return 1
    fi
    if ! tide-grant --workspace-name -- "$1"; then
        echo "$prog $2: tide-grant couldn't keep the workspace's name to its letters and digits" >&2
        return 1
    fi
}

# The focused workspace's name, from `hyprctl -j activeworkspace`, or 1,
# having said why, when it can't be read; $1 names the subcommand for the
# message. Hyprland prints each field on a line of its own, escaping only
# `"`, `\` and control characters; those escapes are undone, so a name made
# outside tide (`hyprctl`) with a quote in it compares as it is.
focused_workspace() {
    if ! command -v hyprctl >/dev/null 2>&1; then
        echo "$prog $1: no hyprctl, so couldn't read the focused workspace" >&2
        return 1
    fi
    if ! out=$(hyprctl -j activeworkspace 2>&1); then
        echo "$prog $1: couldn't read the focused workspace: $out" >&2
        return 1
    fi
    name=$(printf '%s\n' "$out" | sed -n 's/^[[:space:]]*"name":[[:space:]]*"\(.*\)",\{0,1\}[[:space:]]*$/\1/p' | head -n 1 |
        sed 's/\\\(.\)/\1/g')
    if test -z "$name"; then
        echo "$prog $1: couldn't read the focused workspace's name from: $out" >&2
        return 1
    fi
    printf '%s\n' "$name"
}

# The window classes the command's app may have, as JSON strings, for the
# name prompt to tell whether it's one of home's apps (SPEC.md §6.5): its
# --app IDs, or else what the grant below would find, the program past
# wrappers and its desktop entries' classes, or the opener's app's.
launch_apps_json() {
    test "$count" -eq 0 || {
        printf '%s' "$app_json"
        return 0
    }
    runs=$(command_program "$@")
    case "${runs##*/}" in
        xdg-open | gio) classes=$(opener_classes "$@") ;;
        *)
            classes=${runs##*/}
            classes="$classes
$(desktop_classes "${runs##*/}" "$@")"
            ;;
    esac
    out=
    while IFS= read -r class; do
        test -n "$class" && out="${out:+$out, }$(json_string "$class")"
    done <<EOF2
$classes
EOF2
    printf '%s' "$out"
}

# A launch from home (SPEC.md §6.5): asks the shell's name prompt for a
# workspace, and waits for its answer on a FIFO, so the app still starts
# from here, with this caller's environment. Sets ws to the workspace
# chosen, or exits on Esc. With no shell to ask, or no answer, it says
# why and returns with ws empty, and the app starts where you are.
ask_workspace() {
    dir=${XDG_RUNTIME_DIR:-}
    if test -z "$dir" || ! test -d "$dir"; then
        echo "$prog launch: no XDG_RUNTIME_DIR to hear the name prompt's answer in, so launching on $focused" >&2
        tell "No name prompt" "tide launch had nowhere to hear the name prompt's answer, so $1 opens on $focused."
        return 0
    fi
    if ! answer_fifo=$(mktemp -u "$dir/tide-prompt.XXXXXX") || ! mkfifo -m 600 "$answer_fifo"; then
        echo "$prog launch: couldn't make a FIFO in $dir for the name prompt's answer, so launching on $focused" >&2
        tell "No name prompt" "tide launch couldn't wait for the name prompt, so $1 opens on $focused."
        return 0
    fi
    apps=$(launch_apps_json "$@")
    if ! reply=$(qs -c tide ipc call prompt launch "{\"apps\": [$apps], \"answer\": $(json_string "$answer_fifo")}" 2>&1) ||
        test "$reply" != asked; then
        rm -f "$answer_fifo"
        echo "$prog launch: the shell's name prompt couldn't be asked for a workspace (${reply:-no answer}), so launching on $focused" >&2
        tell "No name prompt" "tide launch couldn't ask the shell for a workspace, so $1 opens on $focused. Is the shell running?"
        return 0
    fi
    # The prompt waits for you, so the wait is long; an hour bounds it
    # should the shell die with the prompt open.
    answer=$(timeout 3600 head -n 1 "$answer_fifo")
    rm -f "$answer_fifo"
    case "$answer" in
        "workspace "?*)
            ws=${answer#workspace }
            opts=", { workspace = $(lua_string "$ws") }"
            ;;
        cancel) exit 0 ;;
        *)
            echo "$prog launch: no answer from the name prompt${answer:+ ($answer)}, so not launching $1" >&2
            tell "No name prompt" "The name prompt never answered, so $1 didn't open."
            exit 1
            ;;
    esac
}

# Home's name, as the shell wrote it to tide-workspaces.lua (SPEC.md
# §6.5), or nothing when there's no file, which `tide doctor` reports.
home_workspace() {
    file=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/tide-workspaces.lua
    test -r "$file" || return 0
    line=$(grep -m 1 '^    home = ".*",$' "$file") || return 0
    line=${line#    home = \"}
    printf '%s' "${line%\",}" | sed 's/\\\(.\)/\1/g'
}

# $1 as a JSON string, for the shell's IPC: backslashes, quotes, tabs,
# carriage returns and newlines escaped. Any other control character is
# left as it is, which the shell refuses, so the launch goes ahead where
# you are and says why.
json_string() {
    tab=$(printf '\t')
    cr=$(printf '\r')
    printf '%s\n' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$tab/\\\\t/g" -e "s/$cr/\\\\r/g" |
        awk 'BEGIN { printf "\"" } NR > 1 { printf "\\n" } { printf "%s", $0 } END { printf "\"" }'
}

# Says what failed on stderr and, since a key binding's stderr goes only to
# the journal, in a notification too. $1 is the notification's summary.
tell() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a tide "$1" "$2" ||
            echo "$prog: couldn't send the notification \"$1\" either" >&2
    fi
}

workspace() {
    test $# -eq 0 || usage
    name=$(focused_workspace workspace) || exit 1
    sanitized "$name" workspace || exit 1
}

# Adds ID to the grant's list, unless it's empty or already there in any
# case (the guard compares IDs without case).
add_app() {
    test -n "$1" || return 0
    key=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$seen_ids" in
        *"|$key|"*) return 0 ;;
    esac
    seen_ids="$seen_ids$key|"
    count=$((count + 1))
    app_json="${app_json:+$app_json, }$(json_string "$1")"
    if test "$count" -eq 1; then
        names=$1
        apps=$(lua_string "$1")
    else
        names="$names, $1"
        apps="$apps, $(lua_string "$1")"
    fi
}

launch() {
    # app is the first --app; names all of them, for the messages; apps
    # the Lua list of all, and count how many (add_app). An empty ID means
    # none given, as it always has.
    app=
    names=
    apps=
    count=0
    wildcard=no
    lookup=no
    seen_ids='|'
    # The grant's options, as Lua, after its pid and key.
    opts=
    # The workspace --workspace names, or empty.
    ws=
    # The IDs it grants, as JSON (add_app), which tell the name prompt
    # whether this is one of home's apps.
    app_json=
    background=no
    unless_running=no
    while test $# -gt 0; do
        case "$1" in
            --workspace | --workspace=*)
                if test "$1" = --workspace; then
                    test $# -ge 2 || usage
                    ws=$2
                    shift 2
                else
                    ws=${1#--workspace=}
                    shift
                fi
                # One line, with something on it: the name prompt's names
                # are, and Hyprland's dispatches can't carry another.
                case "$ws" in
                    *"$nl"* | '')
                        echo "$prog launch: --workspace takes a workspace's name, one line of text" >&2
                        exit 2
                        ;;
                esac
                if test -z "$(printf '%s' "$ws" | tr -d '[:space:]')"; then
                    echo "$prog launch: --workspace takes a workspace's name, one line of text" >&2
                    exit 2
                fi
                # As the shell's names are (workspacenames.mjs's UNSAFE):
                # with no quotes, backslashes or control characters, a name
                # needs no quoting anywhere it goes.
                case "$ws" in
                    *[\"\'\`\\]*) unsafe=yes ;;
                    *) unsafe=no ;;
                esac
                if test "$unsafe" = yes || test "$(printf '%s' "$ws" | LC_ALL=C tr -d '\001-\037\177')" != "$ws"; then
                    echo "$prog launch: --workspace's name can't have quotes, backslashes or control characters: $ws" >&2
                    exit 2
                fi
                # As the shell's names are (workspacenames.mjs's UNSAFE):
                # with no quotes, backslashes or control characters, a name
                # needs no quoting anywhere it goes.
                case "$ws" in
                    *[\"\'\`\\]*) unsafe=yes ;;
                    *) unsafe=no ;;
                esac
                if test "$unsafe" = yes || test "$(printf '%s' "$ws" | LC_ALL=C tr -d '\001-\037\177')" != "$ws"; then
                    echo "$prog launch: --workspace's name can't have quotes, backslashes or control characters: $ws" >&2
                    exit 2
                fi
                opts=", { workspace = $(lua_string "$ws") }"
                ;;
            --app | --app=*)
                if test "$1" = --app; then
                    test $# -ge 2 || usage
                    id=$2
                    shift 2
                else
                    id=${1#--app=}
                    shift
                fi
                test "$id" != '*' || wildcard=yes
                add_app "$id"
                app=${app:-$id}
                ;;
            --background) background=yes; shift ;;
            --unless-running) unless_running=yes; shift ;;
            --) shift; break ;;
            -*) usage ;;
            *) break ;;
        esac
    done
    test $# -gt 0 || usage
    if test "$background" = yes && { test -n "$ws" || test "$count" -gt 0; }; then
        echo "$prog launch: --background records no focus grant, so it takes no --workspace or --app" >&2
        exit 2
    fi
    if test "$unless_running" = yes && running "$@"; then
        echo "$prog launch: $runs is running already, so not starting it again" >&2
        exit 0
    fi
    # '*' stands alone: beside a name it would make the name meaningless,
    # and the guard refuses the pair, which would start the app ungranted.
    if test "$wildcard" = yes && test "$count" -gt 1; then
        echo "$prog launch: --app '*' grants any app's window, so it can't be given with other IDs ($names)" >&2
        exit 2
    fi
    if ! in_tide; then
        exec "$@"
    fi
    if test "$background" = yes; then
        launch_background "$@"
    fi
    # The focused workspace, read once: home asks for a name, and the app
    # gets it as TIDE_WORKSPACE otherwise.
    focused=
    focused_ok=no
    if test -z "$ws" && focused=$(focused_workspace launch); then
        focused_ok=yes
    fi
    if test "$focused_ok" = yes && test "$focused" = "$(home_workspace)"; then
        ask_workspace "$@"
    fi
    if test -z "$app"; then
        runs=$(command_program "$@")
        opener=no
        case "${runs##*/}" in
            # They open whatever handles the file: the default app for its
            # type, which tide-grant reads past wrappers.
            xdg-open) opener=yes ;;
            # Only `gio open` opens an app; `gio trash` and the rest don't,
            # which tide-grant tells apart at the program's own position.
            gio) opener=yes ;;
            *)
                app=${runs##*/}
                add_app "$app"
                lookup=yes
                ;;
        esac
        # The opener's app is found before the grant goes in, since its
        # name isn't known until then; xdg-mime takes some tens of ms.
        if test "$opener" = yes; then
            status=0
            classes=$(opener_classes "$@") || status=$?
            if test "$status" -eq 3; then
                # No opener after all (`gio trash`): grant the program.
                app=${runs##*/}
            else
                while IFS= read -r class; do
                    add_app "$class"
                    app=${app:-$class}
                done <<EOF2
$classes
EOF2
                app=${app:-*}
            fi
        fi
    fi
    # A grant that fails is reported; the app starts anyway. One ID goes
    # in as a string, several as a list.
    if test "$count" -gt 1; then
        grant "$names" launch grant "" "{ $apps }${opts:+, nil, nil$opts}"
    elif test "$lookup" != yes; then
        grant "$app" launch grant "" "$(lua_string "$app")${opts:+, nil, nil$opts}"
    elif grant "$app" launch grant "" "$(lua_string "$app"), nil, $$$opts"; then
        # The program's desktop entries may name the class its window has
        # (Exec=foo, StartupWMClass=org.example.Foo). They're read after
        # the grant is in, so a key press or focus change meanwhile still
        # cancels it, and added to it only if it still holds. The grant is
        # keyed by this process's pid, so a lookup for a launch that was
        # canceled can't widen a later launch's grant for the same program.
        classes=$(desktop_classes "$app" "$@")
        count=0
        names=
        apps=
        seen_ids="|$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')|"
        while IFS= read -r class; do
            add_app "$class"
        done <<EOF2
$classes
EOF2
        if test "$count" -gt 0; then
            grant "$app (adding $names)" launch extend "add classes to the focus grant" "$(lua_string "$app"), { $apps }, nil, $$"
        fi
    fi
    # uwsm app keeps the caller's environment: it starts a scope with
    # systemd-run --scope, which runs the command here (SPEC.md §6.5).
    why=
    if test -z "$ws" && test "$focused_ok" != yes; then
        why="Couldn't read the focused workspace"
    elif ! TIDE_WORKSPACE=$(sanitized "${ws:-$focused}" launch); then
        why="Couldn't keep the workspace's name to its letters and digits"
    fi
    if test -n "$why"; then
        echo "$prog launch: starting ${app:-$1} with an empty TIDE_WORKSPACE" >&2
        TIDE_WORKSPACE=
        tell "TIDE_WORKSPACE not set" \
            "$why, so ${app:-$1}'s shell sessions won't be named after it. tide doctor may say why."
    fi
    export TIDE_WORKSPACE
    wait_for_shell "$app"
    exec uwsm app -- "$@"
}

# `tide launch --background`: no grant and no name prompt, so nothing it
# opens takes focus (SPEC.md §16). The app still gets the focused
# workspace's name as TIDE_WORKSPACE, as any launch does.
launch_background() {
    why=
    if ! focused=$(focused_workspace launch); then
        why="Couldn't read the focused workspace"
    elif ! TIDE_WORKSPACE=$(sanitized "$focused" launch); then
        why="Couldn't keep the workspace's name to its letters and digits"
    fi
    if test -n "$why"; then
        echo "$prog launch: starting $1 with an empty TIDE_WORKSPACE" >&2
        TIDE_WORKSPACE=
        tell "TIDE_WORKSPACE not set" \
            "$why, so $1's shell sessions won't be named after it. tide doctor may say why."
    fi
    export TIDE_WORKSPACE
    wait_for_shell "$1"
    # On stdout, the line Start at login waits for before starting the next
    # command, so they start in the list's order (SPEC.md §16).
    echo "tide launch: starting"
    exec uwsm app -- "$@"
}

# Whether a process of this user already runs the command's program, past
# wrappers, for --unless-running; sets runs to the program's name. A
# process's name (comm) is its first 15 bytes, so that's what's matched,
# and pgrep -x takes a regular expression, so the name's own punctuation is
# escaped. Returns 1, having said why, when it can't tell, so the command
# starts anyway: skipping it is the surprise.
running() {
    runs=$(command_program "$@")
    runs=${runs##*/}
    # A path ending in / names no program to match.
    if test -z "$runs"; then
        runs=$1
        echo "$prog launch: $1 names no program to look for, so starting it without checking whether it's running" >&2
        return 1
    fi
    if ! command -v pgrep >/dev/null 2>&1; then
        echo "$prog launch: no pgrep, so starting $runs without checking whether it's running" >&2
        return 1
    fi
    name=$(printf '%s' "$runs" | LC_ALL=C cut -b 1-15 | sed 's/[][\\.*^$+?(){}|]/\\&/g')
    status=0
    out=$(pgrep -u "$(id -u)" -x -- "$name" 2>&1) || status=$?
    case "$status" in
        0) return 0 ;;
        1) return 1 ;;
    esac
    echo "$prog launch: pgrep couldn't say whether $runs is running (${out:-exit $status}), so starting it" >&2
    return 1
}

# Until the shell draws them itself (M3), the network and Bluetooth tray
# icons come from these applets' own autostart entries.
autostart_default="nm-applet blueman"

autostart_allowed() {
    test $# -eq 1 || usage
    case "$1" in
        app-*@autostart.service) ;;
        *)
            echo "$prog autostart-allowed: $1 isn't an XDG autostart unit (app-*@autostart.service)" >&2
            exit 2
            ;;
    esac
    # The generator names the unit with the desktop ID escaped as a unit
    # name (dashes and other unusual characters as \xNN), which
    # systemd-escape undoes. Exit 3 for anything that stops the check: the
    # drop-in turns it into a failed unit, rather than a quiet skip.
    escaped=${1#app-}
    escaped=${escaped%@autostart.service}
    if ! id=$(systemd-escape --unescape -- "$escaped" 2>&1); then
        echo "$prog autostart-allowed: couldn't unescape $1 ($id)" >&2
        exit 3
    fi
    # One desktop ID per line, matched whole, so an ID with a space or a #
    # still works; a line that starts with # is a comment. A line may also
    # give the ID as the unit name escapes it (\x23foo for #foo), which is
    # how an ID that starts with # is written. A broken file,
    # a dangling symlink included, fails the check whatever the unit, so
    # the setting is never silently ignored.
    file=${XDG_CONFIG_HOME:-$HOME/.config}/tide/autostart
    if test -e "$file" || test -L "$file"; then
        if ! lines=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file" 2>&1); then
            echo "$prog autostart-allowed: couldn't read $file ($lines)" >&2
            exit 3
        fi
        if printf '%s\n' "$lines" | grep -v '^#' | grep -Fxq -e "$id" -e "$escaped"; then
            exit 0
        fi
    fi
    for a in $autostart_default; do
        if test "$a" = "$id"; then
            exit 0
        fi
    done
    echo "$prog: not starting $id in tide; add $id to $file to allow it" >&2
    exit 1
}

brightness() {
    if test $# -ne 1 || test -z "$1"; then
        usage
    fi
    # -m prints the device afterwards as device,class,current,percent%,max.
    if ! out=$(brightnessctl -m set "$1" 2>&1); then
        echo "$prog brightness: brightnessctl set $1 failed: $out" >&2
        exit 1
    fi
    percent=$(printf '%s\n' "$out" | tail -n 1 | cut -d, -f4)
    percent=${percent%\%}
    case "$percent" in
        '' | *[!0-9]*)
            echo "$prog brightness: set $1, but couldn't read the new level from brightnessctl ($out), so no OSD" >&2
            exit 0
            ;;
    esac
    if ! in_tide || ! command -v qs >/dev/null 2>&1; then
        exit 0
    fi
    # No shell running (TIDE_BAR=waybar) is expected, and qs says so
    # with "No running instances" or "No instances". Anything else is the
    # OSD broken, which is reported; the backlight has changed either way,
    # so it exits 0, and the keys' brightnessctl fallback doesn't run too.
    if ! err=$(qs -c tide ipc call osd brightness "$percent" 2>&1); then
        case "$err" in
            "No running instances"* | "No instances"*) ;;
            *) echo "$prog brightness: set $1, but the shell's OSD didn't take it: $err" >&2 ;;
        esac
    fi
}

idle_lock() {
    test $# -eq 0 || usage
    dir=${XDG_RUNTIME_DIR:-}
    if test -z "$dir" || ! test -d "$dir"; then
        echo "$prog idle-lock: no XDG_RUNTIME_DIR, so the lock opens on its password face" >&2
    else
        # Written whole, then renamed, so the lock never reads half a time.
        flag=$dir/tide-lock-idle
        if ! date +%s > "$flag.tmp" || ! mv -f "$flag.tmp" "$flag"; then
            echo "$prog idle-lock: couldn't write $flag, so the lock opens on its password face" >&2
            # A partial file goes. Whatever else is there (a directory, say)
            # would fail every idle lock, so name it rather than hide it.
            if ! err=$(rm -f "$flag.tmp" 2>&1); then
                echo "$prog idle-lock: couldn't remove $flag.tmp, which blocks the flag: $err" >&2
            fi
        fi
    fi
    if loginctl lock-session; then
        return 0
    else
        status=$?
    fi
    # No lock came of it, so the flag mustn't turn the next one, a
    # Super+L say, into the screensaver.
    if test -n "${flag:-}" && test -e "$flag" && ! err=$(rm -f "$flag" 2>&1); then
        echo "$prog idle-lock: couldn't remove $flag after the lock failed: $err" >&2
    fi
    echo "$prog idle-lock: loginctl lock-session failed (exit $status)" >&2
    return "$status"
}

# Leaves the time this idle suspend was skipped for being on AC, for
# `idle-suspend --unplugged`. Written whole, then renamed, so it's never
# read half written.
idle_suspend_flag() {
    dir=${XDG_RUNTIME_DIR:-}
    if test -z "$dir" || ! test -d "$dir"; then
        echo "$prog idle-suspend: on AC, and no XDG_RUNTIME_DIR to note it in, so unplugging won't suspend" >&2
        return 1
    fi
    flag=$dir/tide-idle-suspend
    if date +%s > "$flag.tmp" && mv -f "$flag.tmp" "$flag"; then
        return 0
    fi
    echo "$prog idle-suspend: on AC, and couldn't write $flag, so unplugging won't suspend" >&2
    if ! err=$(rm -f "$flag.tmp" 2>&1); then
        echo "$prog idle-suspend: couldn't remove $flag.tmp, which blocks the flag: $err" >&2
    fi
    return 1
}

# For `idle-suspend --unplugged`: 0 if there's a flag idle_suspend_flag
# left, which it removes; 1 if there's none, since no suspend was skipped
# or someone has been back since; 2, saying why, if it can't be removed,
# since it would count again.
idle_suspend_unplugged() {
    dir=${XDG_RUNTIME_DIR:-}
    test -n "$dir" || return 1
    flag=$dir/tide-idle-suspend
    test -e "$flag" || return 1
    if ! err=$(rm -f "$flag" 2>&1); then
        echo "$prog idle-suspend: couldn't remove $flag, so not suspending: $err" >&2
        return 2
    fi
}

# For `idle-suspend --cancel`: someone is back, so an unplug no longer
# suspends.
idle_suspend_cancel() {
    dir=${XDG_RUNTIME_DIR:-}
    test -n "$dir" || return 0
    flag=$dir/tide-idle-suspend
    if ! err=$(rm -f "$flag" 2>&1); then
        echo "$prog idle-suspend: couldn't remove $flag, so unplugging may still suspend: $err" >&2
        return 1
    fi
}

idle_suspend() {
    case $# in
        0) ;;
        1)
            case "$1" in
                --unplugged)
                    idle_suspend_unplugged
                    case $? in
                        0) ;;
                        1) return 0 ;;
                        *) return 1 ;;
                    esac
                    ;;
                --cancel)
                    idle_suspend_cancel
                    return
                    ;;
                *) usage ;;
            esac
            ;;
        *) usage ;;
    esac
    # Suspend on AC, as the shell wrote it beside hypridle's timings, in a
    # file of its own so changing it doesn't restart hypridle; off with no
    # file yet, as it is by default.
    idle_conf=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/tide-idle-suspend.conf
    on_ac=no
    # In the C locale, so grep's error is strerror's own words.
    err=$(LC_ALL=C grep -qxF "\$tide_idle_suspend_on_ac = 1" "$idle_conf" 2>&1)
    case $? in
        0) on_ac=yes ;;
        1) ;;
        *)
            # No file yet is the default. Anything else that stops grep,
            # anywhere along the path, is reported: a file that can't be
            # read, a directory that can't be searched, one that's a file.
            case "$err" in
                *"No such file or directory"*) ;;
                *) echo "$prog idle-suspend: couldn't read $idle_conf, so suspending on battery only: $err" >&2 ;;
            esac
            ;;
    esac
    if test "$on_ac" = no; then
        if ! power=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower \
            org.freedesktop.UPower OnBattery 2>&1); then
            echo "$prog idle-suspend: couldn't ask UPower whether this is on battery, so not suspending: $power" >&2
            return 1
        fi
        case "$power" in
            "b true") ;;
            "b false")
                idle_suspend_flag
                return
                ;;
            *)
                echo "$prog idle-suspend: UPower answered '$power' for OnBattery, so not suspending" >&2
                return 1
                ;;
        esac
    fi
    if systemctl suspend; then
        return 0
    else
        status=$?
    fi
    echo "$prog idle-suspend: systemctl suspend failed (exit $status)" >&2
    return "$status"
}

# `hyprctl repl CODE` is the one form that returns the call's value
# (`eval` answers only ok): Hyprland 0.56's hyprctl/src/main.cpp sends it
# as a single command with output, and src/config/lua/ConfigManager.cpp
# prints each returned value.
prompt_focus() {
    test $# -eq 0 || usage
    if ! in_tide; then
        echo "$prog prompt-focus: not in a tide session, so there's no focus guard to ask" >&2
        exit 2
    fi
    if ! command -v hyprctl >/dev/null 2>&1; then
        echo "$prog prompt-focus: no hyprctl, so couldn't ask the focus guard" >&2
        exit 2
    fi
    reply=$(hyprctl repl "tide_focus.prompt_may_focus()" 2>&1)
    case "$reply" in
        true) exit 0 ;;
        false) exit 1 ;;
    esac
    echo "$prog prompt-focus: couldn't ask the focus guard: ${reply:-no answer}" >&2
    exit 2
}

case "${1:-}" in
    launch) shift; launch "$@" ;;
    workspace) shift; workspace "$@" ;;
    grant) shift; grant_only "$@" ;;
    focus) shift; focus_app "$@" ;;
    autostart-allowed) shift; autostart_allowed "$@" ;;
    brightness) shift; brightness "$@" ;;
    idle-lock) shift; idle_lock "$@" ;;
    idle-suspend) shift; idle_suspend "$@" ;;
    prompt-focus) shift; prompt_focus "$@" ;;
    # Installed beside this script.
    doctor) shift; exec sh "$(dirname "$0")/tide-doctor" "$@" ;;
    clipboard) shift; exec sh "$(dirname "$0")/tide-clipboard" "$@" ;;
    *) usage ;;
esac
