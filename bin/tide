#!/bin/sh
#
# tide: the session's command-line helpers.
#
#   tide launch [--app ID] [--] COMMAND [ARG...]
#
#     Starts an app the way the key bindings and the launcher do
#     (SPEC.md §5.4, §14.3):
#       1. records a one-shot focus grant for the app with the focus guard,
#          so its first window may take focus. ID defaults to COMMAND's
#          basename; '*' grants the first window of any app, for a
#          wrapper script whose app isn't known in advance, and the
#          default for xdg-open and gio open. It comes
#          first, so a key press or focus change while the shell is still
#          starting cancels it, and its 10 s run from the key press that
#          launched it;
#       2. waits for the shell, so no app starts before the notification,
#          tray and polkit owners exist. The wait is bounded (15 s, or
#          $TIDE_LAUNCH_WAIT), and the app starts anyway after it,
#          because a terminal is how you'd fix a stuck start;
#       3. runs it with `uwsm app`, in app-graphical.slice, so the app
#          outlives a shell restart.
#     Outside a tide session it just runs COMMAND.
#
#   tide grant ID
#
#     Records only the focus grant, for an app that something other than
#     a launch is about to bring up: the shell grants the app a clicked
#     notification came from (SPEC.md §9). If nothing uses the grant
#     before it runs out, and you haven't moved on, the guard focuses the
#     app's most recently focused window instead. Exits 1 if the grant
#     couldn't be recorded. Outside a tide session there's no guard, and it
#     does nothing.
#
#   tide focus ID
#
#     Focuses ID's most recently focused window now, switching to its
#     workspace: what a click on a notification center entry does when its
#     notification is gone (SPEC.md §9). Exits 1 if the guard couldn't be
#     asked. Outside a tide session it does nothing.
#
#   tide autostart-allowed UNIT
#
#     The condition on every XDG autostart unit in the tide session
#     (systemd/user/app-.service.d/tide-autostart.conf, SPEC.md §5.4):
#     exits 0 if UNIT's desktop entry is on the autostart allowlist, 1,
#     which skips the unit, if it isn't, and 3 if it can't tell (an
#     unreadable list), which the drop-in turns into a failed unit. The
#     file holds one desktop ID per line; lines starting with # are comments,
#     so an ID that itself starts with # is written escaped, as \x23ID. The allowlist is the tray applets the
#     bar still relies on, plus the desktop IDs, one per line, in
#     ${XDG_CONFIG_HOME:-~/.config}/tide/autostart.
#
#   tide brightness STEP
#
#     Changes the backlight with `brightnessctl set STEP` (5%+, 5%-, 40%)
#     and shows the new level on the shell's OSD (SPEC.md §9). The
#     brightness keys run it; hypridle dims with brightnessctl itself, so
#     dimming never flashes the OSD. Exits 1 if brightnessctl fails. The
#     OSD is extra: with no shell to show it (waybar's fallback, or
#     outside tide), the level changes and nothing else happens; a
#     shell that fails to show it is reported, and still exits 0.
#
#   tide doctor
#
#     Checks the running session and prints one line per problem, with
#     its fix (SPEC.md §5.4); see tide-doctor.

prog=${0##*/}

usage() {
    echo "usage: $prog launch [--app ID] [--] COMMAND [ARG...]" >&2
    echo "       $prog grant ID" >&2
    echo "       $prog focus ID" >&2
    echo "       $prog autostart-allowed UNIT" >&2
    echo "       $prog brightness STEP" >&2
    echo "       $prog doctor" >&2
    exit 2
}

in_tide() {
    case ":${XDG_CURRENT_DESKTOP:-}:" in
        *:tide:*) return 0 ;;
    esac
    return 1
}

# `systemctl start` blocks until the shell reports ready, and returns at once
# when it already has. The bound is our own: the units' timeouts chain (the
# shell's starts only after hypridle's), so they don't bound this.
wait_for_shell() {
    bound=${TIDE_LAUNCH_WAIT:-15}
    # A whole number of seconds from 1 to 3600: `timeout 0` never times out.
    case "$bound" in
        '' | *[!0-9]* | 0* | ?????*) bound_ok=no ;;
        *) test "$bound" -le 3600 && bound_ok=yes || bound_ok=no ;;
    esac
    if test "$bound_ok" = no; then
        echo "$prog launch: TIDE_LAUNCH_WAIT must be a whole number of seconds from 1 to 3600, not '$bound'; waiting 15 s" >&2
        bound=15
    fi
    if ! err=$(timeout "$bound" systemctl --user start tide.service 2>&1); then
        echo "$prog launch: the shell isn't ready (${err:-no answer in $bound s}); starting $1 anyway" >&2
    fi
}

# The guard lives in Hyprland's Lua config (hypr/tide/focus.lua), so the
# grant goes in through `hyprctl eval`, with the ID escaped for a Lua string.
# Returns 1, having said why, when the guard didn't take it; $2 names the
# subcommand for the message, $3 the guard's function (grant by default),
# and $4 what the call does, for the messages (a focus grant by default).
grant() {
    what=${4:-record a focus grant}
    if ! command -v hyprctl >/dev/null 2>&1; then
        echo "$prog $2: no hyprctl, so couldn't $what for $1" >&2
        return 1
    fi
    lua_id=$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')
    reply=$(hyprctl eval "tide_focus.${3:-grant}(\"$lua_id\")" 2>&1)
    if test "$reply" != ok; then
        echo "$prog $2: couldn't $what for $1: $reply" >&2
        return 1
    fi
}

grant_only() {
    if test $# -ne 1 || test -z "$1"; then
        usage
    fi
    if ! in_tide; then
        exit 0
    fi
    grant "$1" grant grant_or_recent || exit 1
}

# The notification center's click on a past notification (SPEC.md §9):
# the guard focuses the app's most recently focused window, switching
# workspace, at once rather than waiting on a grant.
focus_app() {
    if test $# -ne 1 || test -z "$1"; then
        usage
    fi
    if ! in_tide; then
        exit 0
    fi
    grant "$1" focus focus_recent "focus its window" || exit 1
}

launch() {
    app=
    while test $# -gt 0; do
        case "$1" in
            --app) test $# -ge 2 || usage; app=$2; shift 2 ;;
            --app=*) app=${1#--app=}; shift ;;
            --) shift; break ;;
            -*) usage ;;
            *) break ;;
        esac
    done
    test $# -gt 0 || usage
    if ! in_tide; then
        exec "$@"
    fi
    if test -z "$app"; then
        case "${1##*/}" in
            # They open whatever handles the file, whose app isn't known here
            # (TODO.md: grants through desktop entries).
            xdg-open) app='*' ;;
            # Only `gio open` opens an app; `gio trash` and the rest don't.
            gio) if test "${2:-}" = open; then app='*'; else app=gio; fi ;;
            *) app=${1##*/} ;;
        esac
    fi
    # A grant that fails is reported; the app starts anyway.
    grant "$app" launch
    wait_for_shell "$app"
    exec uwsm app -- "$@"
}

# Until the shell draws them itself (M3), the network and Bluetooth tray
# icons come from these applets' own autostart entries.
autostart_default="nm-applet blueman"

autostart_allowed() {
    test $# -eq 1 || usage
    case "$1" in
        app-*@autostart.service) ;;
        *)
            echo "$prog autostart-allowed: $1 isn't an XDG autostart unit (app-*@autostart.service)" >&2
            exit 2
            ;;
    esac
    # The generator names the unit with the desktop ID escaped as a unit
    # name (dashes and other unusual characters as \xNN), which
    # systemd-escape undoes. Exit 3 for anything that stops the check: the
    # drop-in turns it into a failed unit, rather than a quiet skip.
    escaped=${1#app-}
    escaped=${escaped%@autostart.service}
    if ! id=$(systemd-escape --unescape -- "$escaped" 2>&1); then
        echo "$prog autostart-allowed: couldn't unescape $1 ($id)" >&2
        exit 3
    fi
    # One desktop ID per line, matched whole, so an ID with a space or a #
    # still works; a line that starts with # is a comment. A line may also
    # give the ID as the unit name escapes it (\x23foo for #foo), which is
    # how an ID that starts with # is written. A broken file,
    # a dangling symlink included, fails the check whatever the unit, so
    # the setting is never silently ignored.
    file=${XDG_CONFIG_HOME:-$HOME/.config}/tide/autostart
    if test -e "$file" || test -L "$file"; then
        if ! lines=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file" 2>&1); then
            echo "$prog autostart-allowed: couldn't read $file ($lines)" >&2
            exit 3
        fi
        if printf '%s\n' "$lines" | grep -v '^#' | grep -Fxq -e "$id" -e "$escaped"; then
            exit 0
        fi
    fi
    for a in $autostart_default; do
        if test "$a" = "$id"; then
            exit 0
        fi
    done
    echo "$prog: not starting $id in tide; add $id to $file to allow it" >&2
    exit 1
}

brightness() {
    if test $# -ne 1 || test -z "$1"; then
        usage
    fi
    # -m prints the device afterwards as device,class,current,percent%,max.
    if ! out=$(brightnessctl -m set "$1" 2>&1); then
        echo "$prog brightness: brightnessctl set $1 failed: $out" >&2
        exit 1
    fi
    percent=$(printf '%s\n' "$out" | tail -n 1 | cut -d, -f4)
    percent=${percent%\%}
    case "$percent" in
        '' | *[!0-9]*)
            echo "$prog brightness: set $1, but couldn't read the new level from brightnessctl ($out), so no OSD" >&2
            exit 0
            ;;
    esac
    if ! in_tide || ! command -v qs >/dev/null 2>&1; then
        exit 0
    fi
    # No shell running (TIDE_BAR=waybar) is expected, and qs says so
    # with "No running instances" or "No instances". Anything else is the
    # OSD broken, which is reported; the backlight has changed either way,
    # so it exits 0, and the keys' brightnessctl fallback doesn't run too.
    if ! err=$(qs -c tide ipc call osd brightness "$percent" 2>&1); then
        case "$err" in
            "No running instances"* | "No instances"*) ;;
            *) echo "$prog brightness: set $1, but the shell's OSD didn't take it: $err" >&2 ;;
        esac
    fi
}

case "${1:-}" in
    launch) shift; launch "$@" ;;
    grant) shift; grant_only "$@" ;;
    focus) shift; focus_app "$@" ;;
    autostart-allowed) shift; autostart_allowed "$@" ;;
    brightness) shift; brightness "$@" ;;
    # Installed beside this script.
    doctor) shift; exec sh "$(dirname "$0")/tide-doctor" "$@" ;;
    *) usage ;;
esac
