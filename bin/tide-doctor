#!/bin/sh
#
# tide-doctor: what `tide doctor` runs. Checks the running
# session for the problems SPEC.md §5.4 lists, and prints one line per
# problem with its fix. Exits 1 if it found any, 0 if none, and 2 outside a
# tide session, where there's nothing to check.
#
# This is the M2 subset, for the transitional shell (TODO.md "tide
# doctor"):
#   - the session's units are running;
#   - qs, where it's installed, is a Quickshell that loads tide's shell;
#   - each D-Bus name in §5.2 is owned by the unit that should own it;
#   - no daemon runs twice, and no rival to an owner runs at all;
#   - tide-portals.conf is installed and XDG_CURRENT_DESKTOP selects it;
#   - Hyprland reports no config errors;
#   - no monitor has more than one bar, by shape or by space reserved
#     beyond tide's own bar;
#   - no XDG autostart unit off the allowlist ran in tide.

prog=${0##*/}
problems=0

problem() {
    printf '%s\n' "$*"
    problems=$((problems + 1))
}

case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:tide:*) ;;
    *)
        echo "$prog: not in a tide session (XDG_CURRENT_DESKTOP is '${XDG_CURRENT_DESKTOP:-}'); run it from inside one" >&2
        exit 2
        ;;
esac

# Units.
for unit in tide.service hypridle.service; do
    state=$(systemctl --user is-active "$unit" 2>&1)
    if test "$state" != active; then
        problem "$unit is ${state:-not active}: see \`systemctl --user status $unit\` and \`journalctl --user -u $unit\`"
    fi
done

# Quickshell. tide-shell runs waybar when qs is too old for tide's shell,
# and says so only in its log. Without qs, waybar is M2's bar and no
# problem. 0.3.0 added IdleInhibitor, IdleMonitor and
# Quickshell.Networking; tide-shell and scripts' setup-tide check the same.
min_quickshell=0.3
# True when version $1 is at least $2, comparing dot-separated numbers.
version_at_least() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        n = split(a, x, "."); m = split(b, y, ".")
        for (i = 1; i <= (n > m ? n : m); i++)
            if (x[i] + 0 != y[i] + 0) exit !(x[i] + 0 > y[i] + 0)
    }'
}
if qs_path=$(command -v qs); then
    # 0.2 prints "quickshell 0.2.1, revision ...", 0.3 "Quickshell 0.3.1
    # (revision ...)".
    if ! qs_out=$(qs --version 2>&1); then
        problem "couldn't tell which Quickshell $qs_path is (qs --version: $(printf '%s\n' "$qs_out" | tail -n 1)), so the version check is skipped"
    else
        qs_version=$(printf '%s\n' "$qs_out" | sed -n 's/^[Qq]uickshell \([0-9][0-9]*\.[0-9][0-9.]*\).*/\1/p' | head -n 1)
        if test -z "$qs_version"; then
            problem "couldn't tell which Quickshell $qs_path is (qs --version printed '$(printf '%s\n' "$qs_out" | head -n 1)'), so the version check is skipped"
        elif ! version_at_least "$qs_version" "$min_quickshell"; then
            problem "qs ($qs_path) is Quickshell $qs_version, and tide's shell needs $min_quickshell or newer, so the bar is waybar: install a newer Quickshell (on Debian and Ubuntu, \`setup --tide\` builds one), then \`systemctl --user restart tide.service\`"
        fi
    fi
fi

# D-Bus names and the unit that should own each (§5.2). In M2 the
# transitional shell's swaync and waybar own the first two, in
# tide.service's cgroup.
for pair in \
    org.freedesktop.Notifications=tide.service \
    org.kde.StatusNotifierWatcher=tide.service \
    org.freedesktop.ScreenSaver=hypridle.service; do
    name=${pair%%=*}
    want=${pair#*=}
    if ! out=$(busctl --user status "$name" 2>&1); then
        problem "$name has no owner ($(printf '%s\n' "$out" | tail -n 1)): $want should own it; see \`systemctl --user status $want\`"
        continue
    fi
    unit=$(printf '%s\n' "$out" | sed -n 's/^UserUnit=//p')
    if test "$unit" != "$want"; then
        comm=$(printf '%s\n' "$out" | sed -n 's/^Comm=//p')
        problem "$name is owned by ${comm:-an unknown process} in ${unit:-no user unit}, not $want: stop that process and keep it from starting in tide"
    fi
done

# Processes. `pgrep -x` matches the process name, which the kernel cuts to
# 15 characters, so the long polkit agent names are matched by their start.
# pgrep exits 1 for no match; anything else means it couldn't look, which is
# reported once rather than read as "none running". pgrep takes an extended
# regex, so a name's metacharacters (agent+foo) are escaped.
uid=$(id -u)
pids_of() {
    pattern=$(printf '%s\n' "$1" | sed 's/[][\.*^$+?(){}|]/\\&/g')
    pids=$(pgrep -u "$uid" -x "$pattern" 2>&1)
    pstatus=$?
    if test "$pstatus" -eq 0; then
        printf '%s\n' "$pids"
        return
    fi
    if test "$pstatus" -gt 1 && ! test -s "$pgrep_err"; then
        echo "pgrep failed ($pstatus: $pids)" > "$pgrep_err"
    fi
}
count() {
    pids_of "$1" | grep -c .
}
# The unit a process runs in, from its cgroup: the scope it ends in (an
# app-*.scope, not the user@.service above it), or else the last path part
# ending in .service. $TIDE_PROC stands in for /proc in the tests.
unit_of() {
    sed -n -e 's|^0::.*/\([^/]*\.scope\)$|\1|p' -e t \
        -e 's|^0::.*/\([^/]*\.service\)\(/.*\)\{0,1\}$|\1|p' "${TIDE_PROC:-/proc}/$1/cgroup" 2>/dev/null |
        tail -n 1 # a process that has exited has no cgroup file; that's reported as no unit
}
pgrep_err=$(mktemp) || {
    echo "$prog: couldn't create a temporary file" >&2
    exit 1
}
trap 'rm -f "$pgrep_err"' EXIT
# Each daemon runs once, in the unit that owns it: one started by hand or
# left from another session isn't supervised or stopped with this one.
for pair in hypridle=hypridle.service swaync=tide.service \
    waybar=tide.service swww-daemon=tide.service \
    swaybg=tide.service; do
    daemon=${pair%%=*}
    want=${pair#*=}
    pids=$(pids_of "$daemon")
    n=$(printf '%s' "$pids" | grep -c .)
    if test "$n" -gt 1; then
        problem "$n $daemon processes are running: only one should; stop the ones outside $want"
    elif test "$n" -eq 1; then
        unit=$(unit_of "$pids")
        if test "$unit" != "$want"; then
            problem "$daemon (pid $pids) runs in ${unit:-no user unit}, not $want: stop it and \`systemctl --user restart $want\`"
        fi
    fi
done
# The agents tide-shell looks for, plus any set with
# TIDE_POLKIT_AGENT or TIDE_POLKIT_AGENTS (a space-separated
# list), read from the running shell's own environment. pgrep sees at most
# 15 characters of a name. If that environment can't be read, a configured
# agent could be missed, so "no polkit agent" isn't concluded.
# One name per line, since a configured agent's name may hold spaces.
agent_names="hyprpolkitagent
polkit-gnome-au
polkit-kde-auth"
add_agent() {
    name=$(printf '%.15s' "${1##*/}")
    case "
$agent_names
" in
        *"
$name
"*) ;;
        *) agent_names="$agent_names
$name" ;;
    esac
}
agents_unknown=
if ! main=$(systemctl --user show -p MainPID --value tide.service 2>&1); then
    problem "couldn't read tide.service's MainPID ($main), so an agent set with TIDE_POLKIT_AGENT may be missed"
    agents_unknown=1
    main=
fi
case "$main" in
    '' | 0) ;; # the shell isn't running; the unit check above reports it
    *[!0-9]*)
        problem "tide.service's MainPID is '$main', not a pid, so an agent set with TIDE_POLKIT_AGENT may be missed"
        agents_unknown=1
        ;;
    *)
        if env=$({ tr '\0' '\n' < "${TIDE_PROC:-/proc}/$main/environ"; } 2>&1); then
            # TIDE_POLKIT_AGENT is one path, spaces and all;
            # TIDE_POLKIT_AGENTS is a space-separated list, as
            # tide-shell reads them.
            while IFS= read -r line; do
                case "$line" in
                    TIDE_POLKIT_AGENT=?*) add_agent "${line#*=}" ;;
                    TIDE_POLKIT_AGENTS=*)
                        for path in ${line#*=}; do add_agent "$path"; done
                        ;;
                esac
            done <<EOF
$env
EOF
        else
            problem "couldn't read tide.service's environment (pid $main: $env), so an agent set with TIDE_POLKIT_AGENT may be missed; if the shell just restarted, run doctor again"
            agents_unknown=1
        fi
        ;;
esac
agent_pids=
while IFS= read -r agent; do
    agent_pids="$agent_pids $(pids_of "$agent" | tr '\n' ' ')"
done <<EOF
$agent_names
EOF
# shellcheck disable=SC2086  # one pid per word
agents=$(printf '%s\n' $agent_pids | grep -c .)
# Zero is only known when pgrep could look and the configured agents are
# known; a failure of either is reported on its own.
if test "$agents" -eq 0 && ! test -s "$pgrep_err" && test -z "$agents_unknown"; then
    problem "no polkit agent is running, so apps can't ask for a password: install hyprpolkitagent or polkit-gnome, then \`systemctl --user restart tide.service\`"
elif test "$agents" -gt 1; then
    problem "$agents polkit agents are running: only tide.service's should; stop the others and remove them from autostart"
elif test "$agents" -eq 1; then
    # One agent, but it must be the shell's, not one started by hand or by
    # another session's autostart.
    # shellcheck disable=SC2086  # one pid per word
    agent_pid=$(printf '%s\n' $agent_pids | head -n 1)
    agent_unit=$(unit_of "$agent_pid")
    if test "$agent_unit" != tide.service; then
        problem "the polkit agent (pid $agent_pid) runs in ${agent_unit:-no user unit}, not tide.service: stop it and \`systemctl --user restart tide.service\`, whose shell starts its own"
    fi
fi
# The shell runs one wallpaper daemon or the other, never both.
if test "$(count swww-daemon)" -gt 0 && test "$(count swaybg)" -gt 0; then
    problem "swww-daemon and swaybg are both running: only one should draw the wallpaper; \`systemctl --user restart tide.service\` starts just one"
fi
# swaybg isn't a rival: the shell runs it where swww isn't packaged, and the
# loop above checks it runs only there.
for rival in dunst mako swaybar swayidle hyprpaper; do
    if test "$(count "$rival")" -gt 0; then
        problem "$rival is running, but tide owns its job (SPEC.md §5.2): stop it and remove it from autostart"
    fi
done
# count runs in a subshell, so its failure comes back through the file.
if test -s "$pgrep_err"; then
    problem "$(cat "$pgrep_err"), so the process checks are incomplete: is procps installed?"
fi

# Portals: xdg-desktop-portal reads tide-portals.conf for the first
# desktop in XDG_CURRENT_DESKTOP, from these directories.
case "${XDG_CURRENT_DESKTOP}" in
    tide:* | tide) ;;
    *) problem "XDG_CURRENT_DESKTOP is '$XDG_CURRENT_DESKTOP': tide must come first, or portals ignore tide-portals.conf; start the session from its tide.desktop entry" ;;
esac
found=
IFS_save=$IFS
IFS=:
for dir in "${XDG_CONFIG_HOME:-$HOME/.config}" ${XDG_CONFIG_DIRS:-/etc/xdg} \
    "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
    if test -f "$dir/xdg-desktop-portal/tide-portals.conf"; then
        found=$dir/xdg-desktop-portal/tide-portals.conf
        break
    fi
done
IFS=$IFS_save
# xdg-desktop-portal reads only the first one it finds, so that's the one
# that must select tide's backends. tide owns the file, so
# rather than parse it the way GKeyFile would, the doctor checks it is the
# one `make install` installs: this copy, which the tests keep in step with
# xdg-desktop-portal/tide-portals.conf.
shipped_portals_conf() {
    cat <<'EOF'
# Portal backends for XDG_CURRENT_DESKTOP=tide:Hyprland. xdg-desktop-portal
# reads this before hyprland-portals.conf, so the choice is explicit: never
# -kde, -gnome or -wlr, even when they're installed for other sessions.
[preferred]
default=hyprland;gtk
EOF
}
if test -z "$found"; then
    problem "tide-portals.conf isn't installed, so portals may pick the KDE or GNOME backend: run \`make install\` in the tide checkout"
elif ! installed=$(cat "$found" 2>&1); then
    problem "couldn't read $found ($installed): check its permissions, or reinstall it with \`make install\` in the tide checkout"
elif test "$installed" != "$(shipped_portals_conf)"; then
    problem "$found isn't the one tide ships (default=hyprland;gtk under [preferred]), so portals may pick the wrong backend: reinstall it with \`make install\` in the tide checkout"
fi

# One bar per monitor (§5.2): a second one stacks above or below the first.
# Two signals, one problem per monitor:
#
# - Shape. A bar is a strip near its monitor's top edge on any layer but
#   the wallpaper's background one: at least half the monitor's width
#   (margins and a set width allowed), at most an eighth of its height, and
#   starting within the top eighth. Popups and the launcher are narrower; a
#   bottom bar starts lower. Layer geometry is logical, so the monitor's
#   size is too: its pixels over its scale, swapped when it's rotated a
#   quarter turn.
# - Reserved space. `hyprctl layers` has no anchors or exclusive zones, but
#   each monitor's `reserved` is the space layers' exclusive zones (and
#   monitor rules) take from its edges, in the same logical pixels. Where
#   tide's own bar (namespace tide-bar) is on a monitor, anything reserved
#   beyond its height is something else holding an edge: a bar too narrow
#   for the shape test, a dock, or a monitor rule's reservation. The bar
#   is matched wherever it sits, since space reserved above it pushes it
#   down. Under waybar there's no tide-bar, and only the shape test runs.
#
# Prints "MONITOR<tab>bars<tab>N<tab>NAMESPACES" or
# "MONITOR<tab>reserved<tab>WHERE", one line per monitor with a problem.
bars_on_monitors() {
    # On failure it prints the error instead, and returns false.
    if ! monitors=$(hyprctl -j monitors 2>&1); then
        printf 'hyprctl monitors failed: %s' "$monitors"
        return 1
    fi
    if ! layers=$(hyprctl -j layers 2>&1); then
        printf 'hyprctl layers failed: %s' "$layers"
        return 1
    fi
    printf '%s' "$layers" | jq -r --argjson monitors "$monitors" '
        to_entries[] | .key as $name | .value as $layers
        | $monitors[] | select(.name == $name) as $m
        | (if $m.transform % 2 == 0 then [$m.width, $m.height] else [$m.height, $m.width] end) as $size
        | ($size[0] / $m.scale) as $w | ($size[1] / $m.scale) as $h
        | [($layers.levels["1"] // [])[], ($layers.levels["2"] // [])[], ($layers.levels["3"] // [])[]] as $all
        | [$all[] | select(.x >= $m.x and .x < $m.x + $w and .y >= $m.y and .y - $m.y < $h / 8
                           and .w >= $w / 2 and .h <= $h / 8)] as $bars
        | ([$all[] | select(.namespace == "tide-bar") | .h] | max) as $ours
        | ($m.reserved // [0, 0, 0, 0]) as $r
        | (if $ours == null then [] else
              [if $r[1] > $ours then "\($r[1] - $ours) px at the top" else empty end,
               if $r[3] > 0 then "\($r[3]) px at the bottom" else empty end,
               if $r[0] > 0 then "\($r[0]) px on the left" else empty end,
               if $r[2] > 0 then "\($r[2]) px on the right" else empty end]
           end) as $extra
        | if ($bars | length) > 1 then
              "\($name)\tbars\t\($bars | length)\t\($bars | map(.namespace) | join(", "))"
          elif ($extra | length) > 0 then
              "\($name)\treserved\t\($extra | join(", "))"
          else empty end' 2>&1
}
if ! command -v jq >/dev/null 2>&1; then
    problem "jq isn't installed, so the one-bar-per-monitor check is skipped: install jq (scripts' setup does)"
elif ! bars=$(bars_on_monitors); then
    problem "$bars, so the one-bar-per-monitor check is incomplete: is Hyprland running?"
else
    while IFS='	' read -r monitor kind detail namespaces; do
        case "$kind" in
            bars) problem "$detail bars on $monitor ($namespaces): only tide's should be there; stop the others and remove them from autostart" ;;
            reserved) problem "$monitor reserves $detail beyond tide's bar: another bar or dock holds that edge (or a monitor rule reserves it); stop it and remove it from autostart" ;;
        esac
    done <<EOF
$bars
EOF
fi

# Hyprland's config errors, one problem each.
if ! errors=$(hyprctl configerrors 2>&1); then
    problem "hyprctl configerrors failed ($errors): is Hyprland running?"
else
    printf '%s\n' "$errors" | while IFS= read -r line; do
        test -n "$line" && printf 'Hyprland config error: %s: fix it in ~/.config/hypr\n' "$line"
    done
    n=$(printf '%s\n' "$errors" | grep -c .)
    problems=$((problems + n))
fi

# XDG autostart. systemd's xdg-autostart generator turns each entry into an
# app-*@autostart.service and applies the spec's rules itself (OnlyShowIn,
# NotShowIn, Hidden, TryExec, Type, X-systemd-skip and the rest); an entry
# that shouldn't run here is skipped, or stopped by its ExecCondition before
# its command starts. So ask systemd which units started their command this
# session: an ExecMainStartTimestampMonotonic after the session began,
# whether the command is still running, failed, or ran and exited.
autostart_ran() {
    # On failure it prints systemctl's error instead, and returns false.
    if ! names=$(systemctl --user list-units --all --plain --no-legend 'app-*@autostart.service' 2>&1); then
        printf '%s' "$names"
        return 1
    fi
    names=$(printf '%s\n' "$names" | awk 'NF { print $1 }')
    test -n "$names" || return 0
    # The user manager can outlive a login (lingering), so a unit counts only
    # if it started after this session's graphical-session.target did.
    if ! since=$(systemctl --user show -p ActiveEnterTimestampMonotonic --value graphical-session.target 2>&1); then
        printf '%s' "$since"
        return 1
    fi
    # shellcheck disable=SC2086  # one unit name per word
    if ! shown=$(systemctl --user show -p Id -p ExecMainStartTimestampMonotonic -- $names 2>&1); then
        printf '%s' "$shown"
        return 1
    fi
    printf '%s\n' "$shown" | awk -F= -v since="${since:-0}" '
        $1 == "Id" { id = $2 }
        $1 == "ExecMainStartTimestampMonotonic" && $2 + 0 > 0 && $2 + 0 >= since + 0 { print id }
    '
}
if ! ran=$(autostart_ran); then
    problem "systemctl couldn't read the autostart units ($ran), so the autostart check is incomplete"
else
    # Installed beside this script; $TIDE_CMD is for tests.
    qs=${TIDE_CMD:-$(dirname "$0")/tide}
    for unit in $ran; do
        # Exit 1 is "not allowed", whose message is meant for the unit's
        # journal; anything else means the check itself failed.
        err=$(sh "$qs" autostart-allowed "$unit" 2>&1 >/dev/null)
        case $? in
            0) ;;
            1) problem "autostart unit $unit ran in tide but isn't on the autostart allowlist: run tide's make install, whose app-.service.d drop-in skips it, then systemctl --user daemon-reload, then systemctl --user stop '$unit' (or add its desktop ID to ~/.config/tide/autostart to allow it)" ;;
            *) problem "couldn't check autostart unit $unit against the allowlist (${err:-$qs failed}), so the autostart check is incomplete" ;;
        esac
    done
fi

if test "$problems" -gt 0; then
    exit 1
fi
echo "No problems found."
