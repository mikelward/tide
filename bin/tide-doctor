#!/bin/sh
#
# tide-doctor: what `tide doctor` runs. Checks the running
# session for the problems SPEC.md §5.4 lists, and prints one line per
# problem with its fix. Exits 1 if it found any, 0 if none, and 2 outside a
# tide session or KDE Plasma, where there's nothing to check. Under Plasma,
# it checks tide's launcher there (SPEC.md §8.5): qs, kde.qml and
# tide-kde.service.
#
# This is the M2 subset, for the transitional shell (TODO.md "tide
# doctor"):
#   - the session's units are running;
#   - the lock's unit, QML and PAM file are installed, and the last lock
#     didn't fail;
#   - tide-lock and the lock's hyprlock fallback are installed, and the
#     fallback didn't fail;
#   - secret-tool and openssl are installed and tide-clipboard.service
#     runs;
#   - the keyring is unlocked, as logging in should leave it;
#   - qs, where it's installed, is a Quickshell that loads tide's shell;
#   - each D-Bus name in §5.2 is owned by the unit that should own it, and
#     no D-Bus activation file can start a rival for it;
#   - no daemon runs twice, and no rival to an owner runs at all;
#   - the session's portal config (tide-portals.conf, or tidewm's
#     tidewm-portals.conf) is installed and XDG_CURRENT_DESKTOP selects it;
#   - in tidewm's session, xdg-desktop-portal-wlr is installed;
#   - Hyprland reports no config errors;
#   - hypridle and the lock's fallback each have a config, yours or
#     tide's, and yours isn't a link to a file that's gone;
#   - the home workspace (SPEC.md §6.5) exists and is persistent, which
#     takes the shell's tide-workspaces.lua and conf's rule for it;
#   - no monitor has more than one bar, by shape or by space reserved
#     beyond tide's own bar;
#   - no XDG autostart unit off the allowlist ran in tide.
# In tidewm's session (SPEC.md §5.3), the bars, the config errors and
# home are tidewm's, read through tide-msg; the shell, not conf, keeps
# home there.

prog=${0##*/}
problems=0

problem() {
    printf '%s\n' "$*"
    problems=$((problems + 1))
}

# The launcher on Plasma (SPEC.md §8.5), all tide runs there.
plasma() {
    if ! command -v qs >/dev/null 2>&1; then
        problem "qs (Quickshell) isn't installed, so tide's launcher can't run on Plasma: \`setup\` installs it"
    fi
    kde_qml=$HOME/.config/quickshell/tide/kde.qml
    if ! test -f "$kde_qml"; then
        problem "$kde_qml isn't installed, so tide-kde.service has nothing to run: run \`make install\` in the tide checkout"
    fi
    if ! state=$(systemctl --user show -p LoadState --value tide-kde.service 2>&1); then
        problem "couldn't tell whether tide-kde.service is installed ($state): \`systemctl --user status tide-kde.service\` says"
    elif test "$state" = not-found; then
        problem "tide-kde.service isn't installed, so Meta+Space has no launcher: run \`make install\` in the tide checkout, then \`systemctl --user daemon-reload\`"
    else
        state=$(systemctl --user is-active tide-kde.service 2>&1)
        if test "$state" != active; then
            problem "tide-kde.service is ${state:-not active}, so Meta+Space has no launcher: \`systemctl --user enable --now tide-kde.service\`, as \`setup\` does; \`journalctl --user -u tide-kde.service\` says why it stopped"
        fi
    fi
    if test "$problems" -gt 0; then
        exit 1
    fi
    echo "No problems found."
    exit 0
}

case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:tide:*) ;;
    *:KDE:*) plasma ;;
    *)
        echo "$prog: not in a tide session (XDG_CURRENT_DESKTOP is '${XDG_CURRENT_DESKTOP:-}'); run it from inside one" >&2
        exit 2
        ;;
esac
# Which compositor: tidewm's session names it, and the default one is
# Hyprland's.
case ":${XDG_CURRENT_DESKTOP}:" in
    *:tidewm:*) compositor=tidewm ;;
    *) compositor=hyprland ;;
esac

# Units.
state=$(systemctl --user is-active tide.service 2>&1)
if test "$state" != active; then
    problem "tide.service is ${state:-not active}: see \`systemctl --user status tide.service\` and \`journalctl --user -u tide.service\`"
fi
# hypridle answers logind's Lock, idle and suspend (§10), so without it none
# of them locks. A drop-in's ExecCondition= that says no skips it at login,
# with Result=exec-condition and nothing in the journal but "skipped", so
# the drop-in that did it is named. Every ExecCondition= runs, and one that
# fails is enough. tide's own allows tide's session; one left by another
# setup (an old quickspace.conf, say) may allow only its own.
#
# systemd keeps each condition's exit status, so the one that said no is
# known: one that exited non-zero, and wasn't marked to have its failure
# ignored (ExecCondition=-...), which systemd counts as a yes. Its drop-in
# is the one with the same command. systemd shows it
# unquoted and unescaped, so both are compared without quotes, backslashes,
# a leading prefix (- @ : + !), extra spaces, or $$ for $. Operators stay,
# so a condition with = never matches one with !=.
condition_text() {
    printf '%s' "$1" | sed -e 's/^[-@:+!]*//' -e 's/\$\$/$/g' | tr -d "'\"\\\\" |
        tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//'
}
hypridle_skipped() {
    lockless=$1
    if ! conds=$(systemctl --user show -p ExecCondition --value hypridle.service 2>&1); then
        problem "hypridle.service was skipped at login by an ExecCondition=, $lockless, and which one isn't known ($conds): \`systemctl --user status hypridle.service\` shows the conditions"
        return
    fi
    failed=$(printf '%s\n' "$conds" | grep ' ; ignore_errors=no ; ' |
        grep ' ; code=exited ; status=' | grep -v ' ; status=0[ /}]' |
        sed -n 's/.*argv\[\]=\(.*\) ; ignore_errors=.*/\1/p' | head -n 1)
    if test -z "$failed"; then
        problem "hypridle.service was skipped at login by an ExecCondition=, $lockless, and systemd doesn't say which: \`systemctl --user status hypridle.service\` shows the conditions"
        return
    fi
    if ! dropins=$(systemctl --user show -p DropInPaths --value hypridle.service 2>&1); then
        problem "hypridle.service was skipped at login by its ExecCondition= \`$failed\`, $lockless, and its drop-ins couldn't be listed ($dropins), so the file isn't named: \`systemctl --user cat hypridle.service\` shows where it is"
        return
    fi
    want=$(condition_text "$failed")
    found=
    unread=
    for dropin in $dropins; do
        if ! test -e "$dropin"; then
            # systemd still runs what it read, until it's reloaded.
            problem "$dropin is gone, but systemd still has it for hypridle.service: \`systemctl --user daemon-reload\`, then \`systemctl --user start hypridle.service\`"
            unread=yes
            continue
        fi
        gstatus=0
        lines=$(grep '^[[:space:]]*ExecCondition=' "$dropin" 2>&1) || gstatus=$?
        if test "$gstatus" -gt 1; then
            problem "couldn't read $dropin ($lines), so whether its ExecCondition= skipped hypridle isn't known"
            unread=yes
            continue
        fi
        while IFS= read -r line; do
            test -n "$line" || continue
            if test "$(condition_text "${line#*ExecCondition=}")" = "$want"; then
                found="$found $dropin"
                break
            fi
        done <<LINES
$lines
LINES
    done
    found=${found# }
    case "$found" in
        "")
            test -n "$unread" ||
                problem "hypridle.service was skipped at login by its ExecCondition= \`$failed\`, $lockless, and no drop-in has it: \`systemctl --user cat hypridle.service\` shows where it is"
            ;;
        *" "*)
            # The same condition in more than one: each is a candidate.
            problem "hypridle.service was skipped at login by its ExecCondition= \`$failed\`, which each of these has: $found, $lockless: remove it from those no other session needs, then \`systemctl --user daemon-reload\` and \`systemctl --user start hypridle.service\`"
            ;;
        */hypridle.service.d/tide.conf)
            problem "hypridle.service was skipped at login by tide's own ExecCondition=, which runs it only where XDG_CURRENT_DESKTOP has tide, $lockless: \`systemctl --user start hypridle.service\` starts it"
            ;;
        *)
            problem "hypridle.service was skipped at login by the ExecCondition= in $found, $lockless: remove it if no other session needs it, then \`systemctl --user daemon-reload\` and \`systemctl --user start hypridle.service\`"
            ;;
    esac
}
state=$(systemctl --user is-active hypridle.service 2>&1)
if test "$state" != active; then
    lockless="so idle, suspend and Super+L don't lock the session"
    if ! result=$(systemctl --user show -p Result --value hypridle.service 2>&1); then
        problem "hypridle.service is ${state:-not active}, $lockless, and whether a condition skipped it isn't known ($result): see \`systemctl --user status hypridle.service\`"
    elif test "$result" = exec-condition; then
        hypridle_skipped "$lockless"
    else
        problem "hypridle.service is ${state:-not active}, $lockless: see \`systemctl --user status hypridle.service\` and \`journalctl --user -u hypridle.service\`"
    fi
fi

# The lock (§10). A broken one shows only when the session should lock, as a
# lock that never comes or one that won't take the password, so each piece is
# checked now: `loginctl lock-session` raises logind's Lock, hypridle (above)
# starts tide-lock.service, its qs loads lock.qml (the unit names it under
# %h, the home directory), and that checks the password through the tide-lock
# PAM service, reading its file as the user. Without that file PAM uses its
# `other` service, which many distributions set to refuse everyone.
# $TIDE_SYSCONFDIR stands in for /etc in the tests.
if ! state=$(systemctl --user show -p LoadState --value tide-lock.service 2>&1); then
    problem "couldn't check that tide-lock.service is installed ($state), so whether the session can lock isn't known"
else
    case "$state" in
        loaded) ;;
        not-found) problem "tide-lock.service isn't installed, so nothing locks the session: run \`make install\` in the tide checkout, then \`systemctl --user daemon-reload\`" ;;
        masked) problem "tide-lock.service is masked, so nothing locks the session: \`systemctl --user unmask tide-lock.service\`" ;;
        *) problem "tide-lock.service is ${state:-not loaded}, so the session can't lock: \`systemctl --user status tide-lock.service\` says why" ;;
    esac
fi
if test "$(systemctl --user is-active tide-lock.service 2>&1)" = failed; then
    problem "the last lock failed (tide-lock.service is failed): \`journalctl --user -u tide-lock.service\` says why, and \`systemctl --user reset-failed tide-lock.service\` clears it once that's fixed"
fi
lock_qml=$HOME/.config/quickshell/tide/lock.qml
if ! test -f "$lock_qml"; then
    problem "$lock_qml isn't installed, so tide-lock.service has nothing to run and the session can't lock: run \`make install\` in the tide checkout"
fi
lock_pam=${TIDE_SYSCONFDIR:-/etc}/pam.d/tide-lock
if ! test -e "$lock_pam"; then
    problem "$lock_pam isn't installed, so the lock checks the password with PAM's \`other\` service, which may refuse every password: run \`make build\`, then \`sudo make install-session PREFIX=/usr\`, in the tide checkout"
elif ! test -r "$lock_pam"; then
    problem "couldn't read $lock_pam, which the lock reads as you to check the password, so it may never unlock: \`sudo chmod 644 $lock_pam\`"
fi
# The unit runs tide-lock, which `make install-session` installs. When
# the lock can't run, the unit's OnFailure= starts
# tide-lock-fallback.service, which is hyprlock, so the session still
# locks; without it, a lock that fails leaves the session unlocked.
# $TIDE_LOCK_PROGRAM and $TIDE_HYPRLOCK stand in for tide-lock and hyprlock
# in the tests.
lock_program=${TIDE_LOCK_PROGRAM:-tide-lock}
if ! command -v "$lock_program" >/dev/null 2>&1; then
    problem "$lock_program isn't installed, so every lock is the fallback's, hyprlock: run \`make build\`, then \`sudo make install-session PREFIX=/usr\`, in the tide checkout"
fi
if ! state=$(systemctl --user show -p LoadState --value tide-lock-fallback.service 2>&1); then
    problem "couldn't check that tide-lock-fallback.service is installed ($state), so whether a failed lock still locks the session isn't known"
else
    case "$state" in
        loaded) ;;
        not-found) problem "tide-lock-fallback.service isn't installed, so a lock that fails leaves the session unlocked: run \`make install\` in the tide checkout, then \`systemctl --user daemon-reload\`" ;;
        masked) problem "tide-lock-fallback.service is masked, so a lock that fails leaves the session unlocked: \`systemctl --user unmask tide-lock-fallback.service\`" ;;
        *) problem "tide-lock-fallback.service is ${state:-not loaded}, so a lock that fails may leave the session unlocked: \`systemctl --user status tide-lock-fallback.service\` says why" ;;
    esac
fi
hyprlock=${TIDE_HYPRLOCK:-hyprlock}
if ! command -v "$hyprlock" >/dev/null 2>&1; then
    problem "$hyprlock isn't installed, so a lock that fails leaves the session unlocked: install the hyprlock package (scripts' \`setup\` does)"
fi
if test "$(systemctl --user is-active tide-lock-fallback.service 2>&1)" = failed; then
    problem "the fallback lock failed too (tide-lock-fallback.service is failed), so the session may not have locked: \`journalctl --user -u tide-lock-fallback.service\` says why, and \`systemctl --user reset-failed tide-lock-fallback.service\` clears it once that's fixed"
fi

# The clipboard history behind Super+V (§8.4): tide-clipboard.service
# hands each copy to `tide clipboard store`, which keeps it encrypted with
# openssl under a key secret-tool keeps in the keyring. Without either, or
# the unit, the picker's Clipboard tab says so only when it's opened.
# $TIDE_SECRET_TOOL and $TIDE_OPENSSL stand in for them in the tests.
for pair in "${TIDE_SECRET_TOOL:-secret-tool}=libsecret-tools" "${TIDE_OPENSSL:-openssl}=openssl"; do
    if ! command -v "${pair%%=*}" >/dev/null 2>&1; then
        problem "${pair%%=*} isn't installed, so Super+V keeps no clipboard history: install the ${pair#*=} package (scripts' \`setup\` does)"
    fi
done
state=$(systemctl --user is-active tide-clipboard.service 2>&1)
if test "$state" != active; then
    problem "tide-clipboard.service is ${state:-not active}, so what you copy doesn't reach Super+V's history: \`systemctl --user enable --now tide-clipboard.service\`, and \`journalctl --user -u tide-clipboard.service\` if it doesn't stay up"
fi

# The keyring (§5.2, §14): gnome-keyring's login collection, which the
# login manager's PAM stack unlocks with the password you log in with:
# pam_gnome_keyring in greetd's (scripts' `setup --greeter` adds it), or
# any other display manager's own. Locked, Chrome, the network agent and
# anything else that keeps a secret ask for the password again. Asked
# through the Secret Service, so it's whichever keyring answers there.
locked=$(busctl --user get-property org.freedesktop.secrets /org/freedesktop/secrets/aliases/default \
    org.freedesktop.Secret.Collection Locked 2>&1)
case $locked in
    "b false") ;;
    "b true")
        problem "the keyring is locked, so Chrome and saved Wi-Fi passwords ask for it again: logging in unlocks it only if the login manager's PAM stack has pam_gnome_keyring (tide's \`install/tide-setup --greeter\` adds it to greetd's) and the keyring's password is your login password; Passwords and Keys (seahorse) changes it"
        ;;
    *)
        problem "couldn't ask the keyring whether it's unlocked ($(printf '%s\n' "$locked" | tail -n 1)), so Chrome and saved Wi-Fi passwords may ask for one: is gnome-keyring running? \`systemctl --user status gnome-keyring-daemon.service\`"
        ;;
esac

# Quickshell. tide-shell runs waybar when qs is too old for tide's shell,
# and tide-lock leaves the lock to hyprlock. Without qs, waybar is M2's bar and no
# problem. 0.3.0 added IdleInhibitor, IdleMonitor and
# Quickshell.Networking; tide-shell and scripts' setup-tide check the same.
min_quickshell=0.3
# True when version $1 is at least $2, comparing dot-separated numbers.
version_at_least() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        n = split(a, x, "."); m = split(b, y, ".")
        for (i = 1; i <= (n > m ? n : m); i++)
            if (x[i] + 0 != y[i] + 0) exit !(x[i] + 0 > y[i] + 0)
    }'
}
if qs_path=$(command -v qs); then
    # 0.2 prints "quickshell 0.2.1, revision ...", 0.3 "Quickshell 0.3.1
    # (revision ...)".
    if ! qs_out=$(qs --version 2>&1); then
        problem "couldn't tell which Quickshell $qs_path is (qs --version: $(printf '%s\n' "$qs_out" | tail -n 1)), so the version check is skipped"
    else
        qs_version=$(printf '%s\n' "$qs_out" | sed -n 's/^[Qq]uickshell \([0-9][0-9]*\.[0-9][0-9.]*\).*/\1/p' | head -n 1)
        if test -z "$qs_version"; then
            problem "couldn't tell which Quickshell $qs_path is (qs --version printed '$(printf '%s\n' "$qs_out" | head -n 1)'), so the version check is skipped"
        elif ! version_at_least "$qs_version" "$min_quickshell"; then
            problem "qs ($qs_path) is Quickshell $qs_version, and tide's shell needs $min_quickshell or newer, so the bar is waybar and the lock is hyprlock: install a newer Quickshell (on Debian and Ubuntu, \`setup\` builds one), then \`systemctl --user restart tide.service\`"
        fi
    fi
fi

# D-Bus names and the unit that should own each (§5.2). In M2 the
# transitional shell's swaync and waybar own the first two, in
# tide.service's cgroup.
for pair in \
    org.freedesktop.Notifications=tide.service \
    org.kde.StatusNotifierWatcher=tide.service \
    org.freedesktop.ScreenSaver=hypridle.service; do
    name=${pair%%=*}
    want=${pair#*=}
    if ! out=$(busctl --user status "$name" 2>&1); then
        problem "$name has no owner ($(printf '%s\n' "$out" | tail -n 1)): $want should own it; see \`systemctl --user status $want\`"
        continue
    fi
    unit=$(printf '%s\n' "$out" | sed -n 's/^UserUnit=//p')
    if test "$unit" != "$want"; then
        comm=$(printf '%s\n' "$out" | sed -n 's/^Comm=//p')
        problem "$name is owned by ${comm:-an unknown process} in ${unit:-no user unit}, not $want: stop that process and keep it from starting in tide"
    fi
done

# Activatable services (§5.4). A D-Bus activation file for one of those
# names lets the bus start its daemon whenever the name has no owner, as it
# has for a moment each time the theme daemon restarts swaync, and that
# daemon then keeps the name. Every file that claims one is judged, in any
# of the session bus's service directories: which one the bus would use
# can't be told from here (it picks arbitrarily among files in one
# directory, and caches $XDG_RUNTIME_DIR's), so none is taken to shadow
# another. That's the rule scripts' `setup` applies too, masking
# each one's unit. That includes a misnamed file in $XDG_RUNTIME_DIR:
# dbus-daemon ignores one there ("strict naming", dbus-daemon(1)), but
# dbus-broker, the session bus on Fedora and Arch, loads it with a warning.
# A file that can't be read can't be judged, and is reported. A file
# starts nothing when:
#   - it activates through a systemd unit that's masked or not installed:
#     with a unit, the unit is what starts, whatever the Exec line says.
#     `setup` masks the packaged swaync's this way; the shell's own
#     swaync is run by the theme daemon, or by tide-shell without one, not
#     by its unit;
#   - with no unit, its command is false itself (an override: `false`,
#     /bin/false or /usr/bin/false, not a script of that name), or
#     plasma_waitforname, KDE's: that waits for plasmashell, which owns the
#     name itself under Plasma.
# Besides the standard directories, the bus reads any its config names
# with <servicedir>. The config is XML, so it's read with a parser,
# python3's: from session.conf, through every <include> and <includedir>
# the way dbus-daemon and dbus-broker follow them, with comments and
# entities left to the parser. An element's text is taken as is, since
# neither bus trims it: one spread over lines names no directory. A
# relative include is relative to the file naming it, in both buses; a
# relative <servicedir> is too in dbus-daemon, but dbus-broker opens it
# as given, from its working directory, the home directory, so both are
# searched. SELinux is judged as libselinux judges it for both buses: an
# <include> marked if_selinux_enabled is read only while SELinux is on,
# and one marked selinux_root_relative is relative to the policy root.
# What can't be read is reported, not passed over: a missing <include>
# is one only without ignore_missing, and a missing <includedir> never
# is. $TIDE_DATADIR, $TIDE_SYSCONFDIR and $TIDE_PROC stand in for
# /usr/share, the bus's own data directory, /etc and /proc in the tests.
datadir=${TIDE_DATADIR:-/usr/share}
bus_config=$datadir/dbus-1/session.conf
# Before dbus 1.10 the config lived under /etc.
if ! test -e "$bus_config"; then
    bus_config=${TIDE_SYSCONFDIR:-/etc}/dbus-1/session.conf
fi
# Prints "dir PATH" for each <servicedir>, and "problem WHAT" for each
# file or directory that couldn't be read.
read_bus_config() {
    python3 - "$1" "${TIDE_SYSCONFDIR:-/etc}" "${TIDE_PROC:-/proc}" <<'PY'
import os
import sys
import xml.etree.ElementTree as ET

sysconfdir, proc = sys.argv[2], sys.argv[3]
selinux_config = os.path.join(sysconfdir, "selinux", "config")
seen = set()


def resolve(base, path):
    return path if os.path.isabs(path) else os.path.join(base, path)


def problem(path, why):
    # One line per report: a newline in a path is shown, not printed.
    print("problem " + path.replace("\n", "\\n") + " (" + why + ")")


def selinux_enabled():
    # libselinux's is_selinux_enabled(): selinuxfs is mounted and its
    # config exists.
    if not os.path.exists(selinux_config):
        return False
    mounts = os.path.join(proc, "self", "mounts")
    try:
        with open(mounts) as f:
            return any(line.split()[2:3] == ["selinuxfs"] for line in f)
    except OSError as e:
        problem(mounts, e.strerror)
        return False


def selinux_policy_root():
    # libselinux's selinux_policy_root(): its config's last SELINUXTYPE,
    # or targeted.
    policy = "targeted"
    try:
        with open(selinux_config) as f:
            for line in f:
                line = line.strip()
                if line[:12].upper() == "SELINUXTYPE=":
                    policy = line[12:].strip()
    except OSError as e:
        problem(selinux_config, e.strerror)
        return None
    return os.path.join(sysconfdir, "selinux", policy)


def read(path, ignore_missing=False):
    real = os.path.realpath(path)
    if real in seen:
        return
    seen.add(real)
    try:
        root = ET.parse(path).getroot()
    except FileNotFoundError:
        if not ignore_missing:
            problem(path, "it doesn't exist")
        return
    except OSError as e:
        problem(path, e.strerror)
        return
    except ET.ParseError as e:
        problem(path, f"not valid XML: {e}")
        return
    base = os.path.dirname(path)
    for el in root:
        text = el.text or ""
        if not text:
            continue
        if el.tag == "servicedir":
            dirs = [resolve(base, text)]
            if not os.path.isabs(text):
                dirs.append(os.path.join(os.path.expanduser("~"), text))
            for d in dirs:
                # The output is one path per line. A path with a newline
                # comes from an element spread over lines, which names no
                # directory either bus finds.
                if "\n" not in d:
                    print(f"dir {d}")
        elif el.tag == "include":
            if el.get("if_selinux_enabled") == "yes" and not selinux_enabled():
                continue
            root = base
            if el.get("selinux_root_relative") == "yes":
                root = selinux_policy_root()
                if root is None:
                    continue
            read(resolve(root, text), el.get("ignore_missing") == "yes")
        elif el.tag == "includedir":
            d = resolve(base, text)
            try:
                names = sorted(n for n in os.listdir(d) if n.endswith(".conf"))
            except FileNotFoundError:
                continue
            except OSError as e:
                problem(d, e.strerror)
                continue
            for n in names:
                read(os.path.join(d, n))


read(sys.argv[1])
PY
}
configured=
if ! command -v python3 >/dev/null 2>&1; then
    problem "python3 isn't installed, so service directories the session bus's config adds aren't searched: install python3 (scripts' setup does)"
elif ! configured=$(read_bus_config "$bus_config" 2>&1); then
    problem "couldn't read the session bus's config ($(printf '%s\n' "$configured" | tail -n 1)), so service directories it adds aren't searched"
    configured=
fi
while IFS= read -r line; do
    case "$line" in
        "problem "*)
            problem "couldn't read ${line#problem } while reading the session bus's config, so the activatable-services check may miss a service directory it adds"
            ;;
    esac
done <<CONFIG
$configured
CONFIG
dbus_dirs=$(
    {
        {
            test -n "${XDG_RUNTIME_DIR:-}" && printf '%s\n' "$XDG_RUNTIME_DIR"
            printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
            IFS=:
            for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
                test -n "$d" && printf '%s\n' "$d"
            done
            printf '%s\n' "$datadir"
        } | sed 's|$|/dbus-1/services|'
        printf '%s\n' "$configured" | sed -n 's/^dir //p'
    } | awk '!seen[$0]++'
)
# Every activation file that declares name $1, one per line.
activation_files() {
    while IFS= read -r dir; do
        for f in "$dir"/*.service; do
            if ! test -f "$f" || ! test -r "$f"; then
                continue
            fi
            if sed -n '/^Name[[:space:]]*=/{ s/^Name[[:space:]]*=[[:space:]]*//; s/[[:space:]]*$//; p; }' "$f" | grep -qxF -- "$1"; then
                printf '%s\n' "$f"
            fi
        done
    done <<DIRS
$dbus_dirs
DIRS
}
# Which package ships file $1: "owned PACKAGE", "unowned", or "failed
# ERROR" when a package manager couldn't say. Every one installed is asked,
# since a foreign one (dpkg-query on Fedora, say) owns nothing and would
# take a packaged file for an unowned one; it's unowned only when none
# failed. Their messages are read, so they're asked for in English.
package_of() {
    asked=
    failure=
    for manager in dpkg-query rpm pacman; do
        command -v "$manager" >/dev/null 2>&1 || continue
        asked=yes
        case "$manager" in
            dpkg-query)
                out=$(LC_ALL=C dpkg-query -S "$1" 2>&1)
                status=$?
                pkg=$(printf '%s\n' "$out" | sed -n '/^diversion /d; s/: .*//p' | head -n 1)
                unowned='no path found matching pattern'
                ;;
            rpm)
                out=$(LC_ALL=C rpm -qf --qf '%{NAME}\n' "$1" 2>&1)
                status=$?
                pkg=$(printf '%s\n' "$out" | head -n 1)
                unowned='is not owned by any package'
                ;;
            pacman)
                out=$(LC_ALL=C pacman -Qqo "$1" 2>&1)
                status=$?
                pkg=$(printf '%s\n' "$out" | head -n 1)
                unowned='No package owns'
                ;;
        esac
        if test "$status" -eq 0 && test -n "$pkg"; then
            echo "owned $pkg"
            return
        fi
        if ! { test "$status" -eq 1 && printf '%s\n' "$out" | grep -qF -- "$unowned"; }; then
            if test -z "$failure"; then
                failure=$(printf '%s\n' "$out" | tail -n 1)
                failure=${failure:-$manager exited $status}
            fi
        fi
    done
    if test -z "$asked"; then
        echo "failed no dpkg-query, rpm or pacman to ask"
    elif test -n "$failure"; then
        echo "failed $failure"
    else
        echo unowned
    fi
}
while IFS= read -r dir; do
    # A directory that can't be listed would look empty.
    if test -d "$dir" && { ! test -r "$dir" || ! test -x "$dir"; }; then
        problem "couldn't list $dir, so the activatable-services check is incomplete: check its permissions"
        continue
    fi
    for f in "$dir"/*.service; do
        if test -f "$f" && ! test -r "$f"; then
            problem "couldn't read $f, so the activatable-services check is incomplete: check its permissions"
        fi
    done
done <<DIRS
$dbus_dirs
DIRS
# What the files miss, the bus can answer: a name it can start that no file
# claims is one whose file was removed after the bus read it (it never
# rereads $XDG_RUNTIME_DIR on its own), or one in a directory doctor
# doesn't search.
if activatable=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ListActivatableNames 2>&1); then
    activatable=$(printf '%s\n' "$activatable" | tr ' ' '\n' | sed -n 's/^"\(.*\)"$/\1/p')
else
    problem "couldn't ask the session bus which names it can start (${activatable}), so a rival with no activation file left isn't checked for"
    activatable=
fi
for name in org.freedesktop.Notifications org.kde.StatusNotifierWatcher org.freedesktop.ScreenSaver; do
    files=$(activation_files "$name")
    if test -z "$files" && printf '%s\n' "$activatable" | grep -qxF -- "$name"; then
        problem "D-Bus can start something for $name whenever it has no owner, but no activation file doctor reads names it: its file was removed after the bus read it, or is in a directory doctor doesn't search; \`busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig\` makes the bus forget a removed one"
    fi
    while IFS= read -r file; do
        test -n "$file" || continue
        unit=$(sed -n '/^SystemdService[[:space:]]*=/{ s/^SystemdService[[:space:]]*=[[:space:]]*//; s/[[:space:]]*$//; p; }' "$file" | head -n 1)
        command=$(sed -n '/^Exec[[:space:]]*=/{ s/^Exec[[:space:]]*=[[:space:]]*//; s/[[:space:]]*$//; p; }' "$file" | head -n 1)
        program=${command%%[[:space:]]*}
        if test -z "$unit"; then
            case "$program" in
                false | /bin/false | /usr/bin/false | plasma_waitforname | */plasma_waitforname) continue ;;
            esac
        fi
        found=$(package_of "$file")
        case "$found" in
            "owned "*)
                pkg=${found#owned }
                from="$file (from the $pkg package)"
                remove="remove the $pkg package"
                ;;
            unowned)
                from=$file
                remove="remove that file"
                ;;
            *)
                from="$file (which package ships it couldn't be told: ${found#failed })"
                remove="remove the package that ships it, or the file if none does"
                ;;
        esac
        if test -n "$unit"; then
            if ! state=$(systemctl --user show -p LoadState --value "$unit" 2>&1); then
                problem "couldn't check whether $unit is masked ($state), so $from may let D-Bus start it whenever $name has no owner"
                continue
            fi
            case "$state" in
                masked | not-found) continue ;;
            esac
            problem "$from lets D-Bus start $unit whenever $name has no owner, and it would then keep the name from tide: \`systemctl --user mask $unit\`"
        else
            problem "$from lets D-Bus start ${program:-its daemon} whenever $name has no owner, and it would then keep the name from tide; it has no unit to mask: $remove"
        fi
    done <<FILES
$files
FILES
done

# Processes. `pgrep -x` matches the process name, which the kernel cuts to
# 15 characters, so the long polkit agent names are matched by their start.
# pgrep exits 1 for no match; anything else means it couldn't look, which is
# reported once rather than read as "none running". pgrep takes an extended
# regex, so a name's metacharacters (agent+foo) are escaped.
uid=$(id -u)
pids_of() {
    pattern=$(printf '%s\n' "$1" | sed 's/[][\.*^$+?(){}|]/\\&/g')
    pids=$(pgrep -u "$uid" -x "$pattern" 2>&1)
    pstatus=$?
    if test "$pstatus" -eq 0; then
        printf '%s\n' "$pids"
        return
    fi
    if test "$pstatus" -gt 1 && ! test -s "$pgrep_err"; then
        echo "pgrep failed ($pstatus: $pids)" > "$pgrep_err"
    fi
}
count() {
    pids_of "$1" | grep -c .
}
# The unit a process runs in, from its cgroup: the scope it ends in (an
# app-*.scope, not the user@.service above it), or else the last path part
# ending in .service. $TIDE_PROC stands in for /proc in the tests.
unit_of() {
    sed -n -e 's|^0::.*/\([^/]*\.scope\)$|\1|p' -e t \
        -e 's|^0::.*/\([^/]*\.service\)\(/.*\)\{0,1\}$|\1|p' "${TIDE_PROC:-/proc}/$1/cgroup" 2>/dev/null |
        tail -n 1 # a process that has exited has no cgroup file; that's reported as no unit
}
pgrep_err=$(mktemp) || {
    echo "$prog: couldn't create a temporary file" >&2
    exit 1
}
trap 'rm -f "$pgrep_err"' EXIT
# Each daemon runs once, in the unit that owns it: one started by hand or
# left from another session isn't supervised or stopped with this one.
for pair in hypridle=hypridle.service swaync=tide.service \
    waybar=tide.service swww-daemon=tide.service \
    swaybg=tide.service; do
    daemon=${pair%%=*}
    want=${pair#*=}
    pids=$(pids_of "$daemon")
    n=$(printf '%s' "$pids" | grep -c .)
    if test "$n" -gt 1; then
        problem "$n $daemon processes are running: only one should; stop the ones outside $want"
    elif test "$n" -eq 1; then
        unit=$(unit_of "$pids")
        if test "$unit" != "$want"; then
            problem "$daemon (pid $pids) runs in ${unit:-no user unit}, not $want: stop it and \`systemctl --user restart $want\`"
        fi
    fi
done
# The agents tide-shell looks for, plus any set with
# TIDE_POLKIT_AGENT or TIDE_POLKIT_AGENTS (a space-separated
# list), read from the running shell's own environment. pgrep sees at most
# 15 characters of a name. If that environment can't be read, a configured
# agent could be missed, so "no polkit agent" isn't concluded.
# One name per line, since a configured agent's name may hold spaces.
agent_names="hyprpolkitagent
polkit-gnome-au
polkit-kde-auth"
add_agent() {
    name=$(printf '%.15s' "${1##*/}")
    case "
$agent_names
" in
        *"
$name
"*) ;;
        *) agent_names="$agent_names
$name" ;;
    esac
}
agents_unknown=
# With TIDE_POLKIT=1 the Quickshell shell is the agent, and no other runs.
# It counts only while the shell runs in tide.service: under waybar it
# doesn't, and tide-shell starts the agent it finds instead.
shell_agent=
if ! main=$(systemctl --user show -p MainPID --value tide.service 2>&1); then
    problem "couldn't read tide.service's MainPID ($main), so an agent set with TIDE_POLKIT_AGENT may be missed"
    agents_unknown=1
    main=
fi
case "$main" in
    '' | 0) ;; # the shell isn't running; the unit check above reports it
    *[!0-9]*)
        problem "tide.service's MainPID is '$main', not a pid, so an agent set with TIDE_POLKIT_AGENT may be missed"
        agents_unknown=1
        ;;
    *)
        if env=$({ tr '\0' '\n' < "${TIDE_PROC:-/proc}/$main/environ"; } 2>&1); then
            # TIDE_POLKIT_AGENT is one path, spaces and all;
            # TIDE_POLKIT_AGENTS is a space-separated list, as
            # tide-shell reads them.
            while IFS= read -r line; do
                case "$line" in
                    TIDE_POLKIT=1) shell_agent=1 ;;
                    TIDE_POLKIT_AGENT=?*) add_agent "${line#*=}" ;;
                    TIDE_POLKIT_AGENTS=*)
                        for path in ${line#*=}; do add_agent "$path"; done
                        ;;
                esac
            done <<EOF
$env
EOF
        else
            problem "couldn't read tide.service's environment (pid $main: $env), so an agent set with TIDE_POLKIT_AGENT may be missed; if the shell just restarted, run doctor again"
            agents_unknown=1
        fi
        ;;
esac
if test -n "$shell_agent"; then
    shell_agent=
    for pid in $(pids_of qs) $(pids_of quickshell); do
        test "$(unit_of "$pid")" = tide.service && shell_agent=1
    done
fi
agent_pids=
while IFS= read -r agent; do
    agent_pids="$agent_pids $(pids_of "$agent" | tr '\n' ' ')"
done <<EOF
$agent_names
EOF
# shellcheck disable=SC2086  # one pid per word
agents=$(printf '%s\n' $agent_pids | grep -c .)
# Zero is only known when pgrep could look and the configured agents are
# known; a failure of either is reported on its own.
if test "$agents" -eq 0 && ! test -s "$pgrep_err" && test -z "$agents_unknown" && test -z "$shell_agent"; then
    problem "no polkit agent is running, so apps can't ask for a password: install hyprpolkitagent or polkit-gnome, then \`systemctl --user restart tide.service\`"
elif test "$agents" -gt 1; then
    problem "$agents polkit agents are running: only tide.service's should; stop the others and remove them from autostart"
elif test "$agents" -eq 1; then
    # One agent, but it must be the shell's, not one started by hand or by
    # another session's autostart.
    # shellcheck disable=SC2086  # one pid per word
    agent_pid=$(printf '%s\n' $agent_pids | head -n 1)
    agent_unit=$(unit_of "$agent_pid")
    if test "$agent_unit" != tide.service && test -n "$shell_agent"; then
        problem "a polkit agent (pid $agent_pid) runs in ${agent_unit:-no user unit}, and polkit lets one agent register per session, so the shell's own (TIDE_POLKIT=1) can't: stop it and remove it from autostart"
    elif test "$agent_unit" != tide.service; then
        problem "the polkit agent (pid $agent_pid) runs in ${agent_unit:-no user unit}, not tide.service: stop it and \`systemctl --user restart tide.service\`, whose shell starts its own"
    fi
fi
# A shell that's the agent says whether its agent works: a Quickshell built
# without polkit can't make one, and with TIDE_POLKIT=1 tide-shell starts
# no other.
if test -n "$shell_agent"; then
    if ! state=$(qs -c tide ipc call polkit status 2>&1); then
        problem "couldn't ask the shell whether its polkit agent works (qs ipc: $(printf '%s\n' "$state" | tail -n 1)), so whether apps can ask for a password isn't known"
    else
        case "$state" in
            registered | off) ;;
            missing)
                problem "the shell couldn't make its polkit agent, and with TIDE_POLKIT=1 tide-shell starts no other, so apps can't ask for a password: \`journalctl --user -u tide.service\` says why; a Quickshell built without polkit can't be the agent, so unset TIDE_POLKIT or install one built with it"
                ;;
            unregistered)
                # An agent outside the unit holding the session is named above.
                if test "$agents" -eq 0; then
                    problem "the shell's polkit agent hasn't registered with polkitd, so apps can't ask for a password: \`journalctl --user -u tide.service\` says why"
                fi
                ;;
            *)
                problem "couldn't tell whether the shell's polkit agent works (qs ipc said '$state')"
                ;;
        esac
    fi
fi
# The network agent (SPEC.md §5.6): the Quickshell shell's, or nm-applet,
# by the same decision `tide autostart-allowed` makes (`tide
# network-agent`), so doctor and autostart can't disagree. Nothing asking
# for a password is reported only when neither runs.
shell_runs=
for pid in $(pids_of qs) $(pids_of quickshell); do
    test "$(unit_of "$pid")" = tide.service && shell_runs=1
done
# Installed beside this script; $TIDE_CMD is for tests.
tide_cmd=${TIDE_CMD:-$(dirname "$0")/tide}
agent_err=$(mktemp) || {
    echo "$prog: couldn't create a temporary file" >&2
    exit 2
}
if agent_state=$(sh "$tide_cmd" network-agent 2>"$agent_err"); then
    agent_on=1
else
    agent_on=
fi
test -s "$agent_err" && problem "$(cat "$agent_err")"
rm -f "$agent_err"
applet_runs=
test "$(count nm-applet)" -gt 0 && applet_runs=1
autostart_file=${XDG_CONFIG_HOME:-$HOME/.config}/tide/autostart
case "$agent_state" in
    standing-aside*)
        # Fine if you listed nm-applet to keep it.
        if ! { test -f "$autostart_file" && grep -v '^#' "$autostart_file" | grep -qx '[[:space:]]*nm-applet[[:space:]]*'; }; then
            problem "nm-applet (pid ${agent_state#standing-aside }) is running, so its dialogs ask for network passwords instead of the shell's: stop it, or list nm-applet in $autostart_file to keep it"
        fi
        ;;
    waiting)
        problem "NetworkManager isn't running, so the shell's network agent is waiting for it: \`systemctl status NetworkManager\`"
        ;;
esac
if test -z "$agent_on" && test -z "$applet_runs" && ! test -s "$pgrep_err"; then
    case "$agent_state" in
        none)
            if test -n "$shell_runs"; then
                why="the shell didn't answer whether its network agent runs (is it starting?)"
            else
                why="the Quickshell shell isn't running (the bar is waybar), so neither is its network agent"
            fi
            fix="install nm-applet (network-manager-gnome), which autostart then runs, and \`systemctl --user restart tide.service\` once the shell can run"
            ;;
        off)
            why="TIDE_AGENT=0 turns off the shell's network agent"
            fix="unset TIDE_AGENT, or list nm-applet in $autostart_file"
            ;;
        missing)
            why="tide-agent isn't running"
            fix="is it installed (\`make install-session\`)? \`journalctl --user -u tide.service\` says why; nm-applet, once installed, stands in"
            ;;
        unregistered*)
            why="NetworkManager didn't take the shell's network agent (${agent_state#unregistered })"
            fix="\`journalctl --user -u tide.service\` says more; nm-applet, once installed, stands in"
            ;;
        *)
            why="the shell's network agent says '$agent_state'"
            fix="\`journalctl --user -u tide.service\` says more"
            ;;
    esac
    problem "$why, and nm-applet isn't running, so nothing asks for a VPN's or Wi-Fi network's password: $fix"
elif test -z "$agent_on"; then
    # nm-applet holds the job. Under waybar, or with TIDE_AGENT=0, that's
    # the plan; otherwise the shell's agent should, so say why it doesn't.
    case "$agent_state" in
        missing)
            problem "tide-agent isn't running, so nm-applet asks for network passwords instead of the shell: is it installed (\`make install-session\`)? \`journalctl --user -u tide.service\` says why"
            ;;
        unregistered*)
            problem "NetworkManager didn't take the shell's network agent (${agent_state#unregistered }), so nm-applet asks for network passwords instead: \`journalctl --user -u tide.service\` says more"
            ;;
    esac
fi
# The pairing agent (SPEC.md §5.6), BlueZ's, in the same tide-agent: only
# where there's an adapter to pair with, and a Quickshell shell to run it.
# Under waybar, blueman-manager brings its own agent while it's open.
# $TIDE_SYSFS stands in for /sys in the tests.
bt_dir=${TIDE_SYSFS:-/sys}/class/bluetooth
adapters=
for hci in "$bt_dir"/hci*; do
    test -e "$hci" && adapters=1
done
if test -n "$adapters" && test -n "$shell_runs"; then
    if ! bt_state=$(qs -c tide ipc call agent bluetooth 2>&1); then
        problem "couldn't ask the shell whether its Bluetooth pairing agent works (qs ipc: $(printf '%s\n' "$bt_state" | tail -n 1)), so whether a device can pair isn't known"
    else
        case "$bt_state" in
            # standing-aside: blueman's applet runs, and is the agent.
            registered | starting | standing-aside* | off) ;;
            waiting)
                problem "bluetoothd isn't running, so no device can pair: \`systemctl status bluetooth\`"
                ;;
            unregistered*)
                problem "BlueZ didn't take the shell's pairing agent (${bt_state#unregistered }), so a device that asks to pair goes unanswered: \`journalctl --user -u tide.service\` says more"
                ;;
            missing)
                problem "tide-agent isn't running, so a device that asks to pair goes unanswered: is it installed (\`make install-session\`)? \`journalctl --user -u tide.service\` says why"
                ;;
            *)
                problem "couldn't tell whether the shell's pairing agent works (qs ipc said '$bt_state')"
                ;;
        esac
    fi
fi
# The shell runs one wallpaper daemon or the other, never both.
if test "$(count swww-daemon)" -gt 0 && test "$(count swaybg)" -gt 0; then
    problem "swww-daemon and swaybg are both running: only one should draw the wallpaper; \`systemctl --user restart tide.service\` starts just one"
fi
# swaybg isn't a rival: the shell runs it where swww isn't packaged, and the
# loop above checks it runs only there.
for rival in dunst mako swaybar swayidle hyprpaper; do
    if test "$(count "$rival")" -gt 0; then
        problem "$rival is running, but tide owns its job (SPEC.md §5.2): stop it and remove it from autostart"
    fi
done
# count runs in a subshell, so its failure comes back through the file.
if test -s "$pgrep_err"; then
    problem "$(cat "$pgrep_err"), so the process checks are incomplete: is procps installed?"
fi

# Portals: xdg-desktop-portal reads the first DESKTOP-portals.conf it
# finds, trying each desktop in XDG_CURRENT_DESKTOP, then portals.conf, in
# each of these directories before the next. The session's own file must
# be that one: tide-portals.conf in Hyprland's session, which puts tide
# first, and tidewm-portals.conf in tidewm's, which puts tidewm first.
if test "$compositor" = tidewm; then
    first=tidewm
    session_entry=tide-tidewm.desktop
else
    first=tide
    session_entry=tide.desktop
fi
want=$first-portals.conf
case "${XDG_CURRENT_DESKTOP}" in
    "$first":* | "$first") ;;
    *) problem "XDG_CURRENT_DESKTOP is '$XDG_CURRENT_DESKTOP': $first must come first, or portals ignore $want; start the session from its $session_entry entry" ;;
esac
desktops=$(printf '%s' "$XDG_CURRENT_DESKTOP" | tr '[:upper:]' '[:lower:]')
found=
IFS_save=$IFS
IFS=:
for dir in "${XDG_CONFIG_HOME:-$HOME/.config}" ${XDG_CONFIG_DIRS:-/etc/xdg} \
    "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
    for desktop in $desktops ""; do
        f=$dir/xdg-desktop-portal/${desktop:+$desktop-}portals.conf
        if test -f "$f"; then
            found=$f
            break 2
        fi
    done
done
IFS=$IFS_save
# tide owns these files, so rather than parse one the way GKeyFile would,
# the doctor checks it is the one `make install` installs: these copies,
# which the tests keep in step with xdg-desktop-portal/.
shipped_portals_conf() {
    if test "$1" = tidewm; then
        cat <<'TIDEWM_PORTALS'
# Portal backends for XDG_CURRENT_DESKTOP=tidewm:tide, tide's tidewm
# session. xdg-desktop-portal reads the first file it finds for any of the
# session's desktops, trying each one in a directory before the next
# directory, so tide-portals.conf, installed beside this, would otherwise
# win. The choice is tidewm's own: -wlr shares the screen and takes
# screenshots, and -gtk does the rest. Never -hyprland, which needs
# Hyprland.
[preferred]
default=wlr;gtk
TIDEWM_PORTALS
    else
        cat <<'TIDE_PORTALS'
# Portal backends for XDG_CURRENT_DESKTOP=tide:Hyprland. xdg-desktop-portal
# reads this before hyprland-portals.conf, so the choice is explicit: never
# -kde, -gnome or -wlr, even when they're installed for other sessions.
[preferred]
default=hyprland;gtk
TIDE_PORTALS
    fi
}
if test "$first" = tidewm; then
    backends="default=wlr;gtk"
else
    backends="default=hyprland;gtk"
fi
if test -z "$found"; then
    problem "$want isn't installed, so portals may pick the KDE or GNOME backend: run \`make install\` in the tide checkout"
elif test "${found##*/}" != "$want"; then
    problem "portals read $found, not tide's $want, so they may pick the wrong backend: run \`make install\` in the tide checkout, which installs $want"
elif ! installed=$(cat "$found" 2>&1); then
    problem "couldn't read $found ($installed): check its permissions, or reinstall it with \`make install\` in the tide checkout"
elif test "$installed" != "$(shipped_portals_conf "$first")"; then
    problem "$found isn't the one tide ships ($backends under [preferred]), so portals may pick the wrong backend: reinstall it with \`make install\` in the tide checkout"
fi

# tidewm's portal config names xdg-desktop-portal-wlr, which shares
# screens and windows there (SPEC.md §12). xdg-desktop-portal finds a
# backend by its .portal file: only in XDG_DESKTOP_PORTAL_DIR where that's
# set, otherwise in each data directory.
if test "$compositor" = tidewm; then
    if test -n "${XDG_DESKTOP_PORTAL_DIR:-}"; then
        portal_dirs=$XDG_DESKTOP_PORTAL_DIR
    else
        portal_dirs=
        IFS_save=$IFS
        IFS=:
        for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
            portal_dirs=${portal_dirs:+$portal_dirs:}$dir/xdg-desktop-portal/portals
        done
        IFS=$IFS_save
    fi
    wlr_portal=
    IFS_save=$IFS
    IFS=:
    for dir in $portal_dirs; do
        if test -f "$dir/wlr.portal"; then
            wlr_portal=$dir/wlr.portal
            break
        fi
    done
    IFS=$IFS_save
    if test -z "$wlr_portal"; then
        problem "xdg-desktop-portal-wlr isn't installed, so sharing a screen or window fails: install your distro's xdg-desktop-portal-wlr package"
    fi
fi

# In tidewm's session, the bars, the config errors and home are tidewm's
# own, read through tide-msg.
if test "$compositor" = tidewm && ! command -v tide-msg >/dev/null 2>&1; then
    problem "no tide-msg, so tidewm's bars, config errors and home aren't checked: run \`make build\`, then \`sudo make install-session PREFIX=/usr\`, in the tide checkout"
fi

# One bar per monitor (§5.2): a second one stacks above or below the first.
# Two signals, one problem per monitor:
#
# - Shape. A bar is a strip near its monitor's top edge on any layer but
#   the wallpaper's background one: at least half the monitor's width
#   (margins and a set width allowed), at most an eighth of its height, and
#   starting within the top eighth. Popups and the launcher are narrower; a
#   bottom bar starts lower. Layer geometry is logical, so the monitor's
#   size is too: its pixels over its scale, swapped when it's rotated a
#   quarter turn.
# - Reserved space. `hyprctl layers` has no anchors or exclusive zones, but
#   each monitor's `reserved` is the space layers' exclusive zones (and
#   monitor rules) take from its edges, in the same logical pixels. Where
#   tide's own bar (namespace tide-bar) is on a monitor, anything reserved
#   beyond its height, at the edge it's on (the top or bottom half, as
#   appearance.json's barPosition puts it), is something else holding an
#   edge: a bar too narrow for the shape test, a dock, or a monitor rule's
#   reservation. The bar is matched wherever it sits in that half, since
#   space reserved beyond it pushes it in. Under waybar there's no tide-bar, and only the shape test runs.
#
# Prints "MONITOR<tab>bars<tab>N<tab>NAMESPACES" or
# "MONITOR<tab>reserved<tab>WHERE", one line per monitor with a problem.
bars_on_monitors() {
    # On failure it prints the error instead, and returns false.
    if ! monitors=$(hyprctl -j monitors 2>&1); then
        printf 'hyprctl monitors failed: %s' "$monitors"
        return 1
    fi
    if ! layers=$(hyprctl -j layers 2>&1); then
        printf 'hyprctl layers failed: %s' "$layers"
        return 1
    fi
    printf '%s' "$layers" | jq -r --argjson monitors "$monitors" '
        to_entries[] | .key as $name | .value as $layers
        | $monitors[] | select(.name == $name) as $m
        | (if $m.transform % 2 == 0 then [$m.width, $m.height] else [$m.height, $m.width] end) as $size
        | ($size[0] / $m.scale) as $w | ($size[1] / $m.scale) as $h
        | [($layers.levels["1"] // [])[], ($layers.levels["2"] // [])[], ($layers.levels["3"] // [])[]] as $all
        | [$all[] | select(.x >= $m.x and .x < $m.x + $w and .y >= $m.y and .y - $m.y < $h / 8
                           and .w >= $w / 2 and .h <= $h / 8)] as $bars
        | [$all[] | select(.namespace == "tide-bar")] as $ours
        | ([$ours[] | select(.y - $m.y < $h / 2) | .h] | max // 0) as $top
        | ([$ours[] | select(.y - $m.y >= $h / 2) | .h] | max // 0) as $bottom
        | ($m.reserved // [0, 0, 0, 0]) as $r
        | (if ($ours | length) == 0 then [] else
              [if $r[1] > $top then "\($r[1] - $top) px at the top" else empty end,
               if $r[3] > $bottom then "\($r[3] - $bottom) px at the bottom" else empty end,
               if $r[0] > 0 then "\($r[0]) px on the left" else empty end,
               if $r[2] > 0 then "\($r[2]) px on the right" else empty end]
           end) as $extra
        | if ($bars | length) > 1 then
              "\($name)\tbars\t\($bars | length)\t\($bars | map(.namespace) | join(", "))"
          elif ($extra | length) > 0 then
              "\($name)\treserved\t\($extra | join(", "))"
          else empty end' 2>&1
}
# tidewm's GET_OUTPUTS gives the same two signals: each output's layer
# surfaces, in the layout's logical pixels, and its window_area, the rect
# less what exclusive zones take, which is the reserved space. A tidewm
# too old to list them prints "MONITOR<tab>old".
bars_on_tidewm() {
    # On failure it prints the error instead, and returns false.
    if ! outputs=$(tide-msg --type get_outputs 2>&1); then
        printf '%s' "$outputs"
        return 1
    fi
    printf '%s' "$outputs" | jq -r '
        .[] | select(.active) | .name as $name | .rect as $m
        | if .layers == null or .window_area == null then "\($name)\told" else
          [.layers[] | select(.layer != "background")] as $all
          | [$all[] | .rect as $b | select($b.x >= $m.x and $b.x < $m.x + $m.width
                     and $b.y >= $m.y and $b.y - $m.y < $m.height / 8
                     and $b.width >= $m.width / 2 and $b.height <= $m.height / 8)] as $bars
          | [$all[] | select(.namespace == "tide-bar") | .rect] as $ours
          | ([$ours[] | select(.y - $m.y < $m.height / 2) | .height] | max // 0) as $top
          | ([$ours[] | select(.y - $m.y >= $m.height / 2) | .height] | max // 0) as $bottom
          | .window_area as $w
          | {top: ($w.y - $m.y), bottom: (($m.y + $m.height) - ($w.y + $w.height)),
             left: ($w.x - $m.x), right: (($m.x + $m.width) - ($w.x + $w.width))} as $r
          | (if ($ours | length) == 0 then [] else
                [if $r.top > $top then "\($r.top - $top) px at the top" else empty end,
                 if $r.bottom > $bottom then "\($r.bottom - $bottom) px at the bottom" else empty end,
                 if $r.left > 0 then "\($r.left) px on the left" else empty end,
                 if $r.right > 0 then "\($r.right) px on the right" else empty end]
             end) as $extra
          | if ($bars | length) > 1 then
                "\($name)\tbars\t\($bars | length)\t\($bars | map(.namespace) | join(", "))"
            elif ($extra | length) > 0 then
                "\($name)\treserved\t\($extra | join(", "))"
            else empty end
          end' 2>&1
}

# tidewm's config errors (GET_CONFIG's errors), one problem each, each
# naming the file and line.
tidewm_config_errors() {
    command -v tide-msg >/dev/null 2>&1 || return 0
    if ! command -v jq >/dev/null 2>&1; then
        problem "jq isn't installed, so tidewm's config errors aren't checked: install jq (scripts' setup does)"
    elif ! config=$(tide-msg --type get_config 2>&1); then
        problem "$config, so tidewm's config errors aren't checked: is tidewm running?"
    elif ! errors=$(printf '%s' "$config" | jq -r '(.errors // [])[]' 2>&1); then
        problem "couldn't read tidewm's config errors from its reply ($errors)"
    else
        while IFS= read -r line; do
            test -n "$line" && problem "tidewm config error: $line: fix it, then reload tidewm's config"
        done <<EOF
$errors
EOF
    fi
}
if test "$compositor" = tidewm && ! command -v tide-msg >/dev/null 2>&1; then
    :
elif ! command -v jq >/dev/null 2>&1; then
    problem "jq isn't installed, so the one-bar-per-monitor check is skipped: install jq (scripts' setup does)"
elif test "$compositor" = tidewm && ! bars=$(bars_on_tidewm); then
    problem "$bars, so the one-bar-per-monitor check is incomplete: is tidewm running?"
elif test "$compositor" != tidewm && ! bars=$(bars_on_monitors); then
    problem "$bars, so the one-bar-per-monitor check is incomplete: is Hyprland running?"
else
    while IFS='	' read -r monitor kind detail namespaces; do
        case "$kind" in
            bars) problem "$detail bars on $monitor ($namespaces): only tide's should be there; stop the others and remove them from autostart" ;;
            reserved) problem "$monitor reserves $detail beyond tide's bar: another bar or dock holds that edge (or a monitor rule reserves it); stop it and remove it from autostart" ;;
            old) problem "tidewm doesn't list $monitor's layer surfaces, so its bars weren't counted: update tidewm" ;;
        esac
    done <<EOF
$bars
EOF
fi

# Hyprland's config errors, one problem each.
if test "$compositor" = tidewm; then
    tidewm_config_errors
elif ! errors=$(hyprctl configerrors 2>&1); then
    problem "hyprctl configerrors failed ($errors): is Hyprland running?"
else
    printf '%s\n' "$errors" | while IFS= read -r line; do
        test -n "$line" && printf 'Hyprland config error: %s: fix it in ~/.config/hypr\n' "$line"
    done
    n=$(printf '%s\n' "$errors" | grep -c .)
    problems=$((problems + n))
fi

# The configs tide starts hypridle and the lock's fallback with (SPEC.md
# §10): yours, or tide's beside it, which `make install` puts there. Both
# programs abort without one. A link to a file that's gone, as a config
# repo leaves when it drops one, is reported, though tide's is used.
config_check() { # PROGRAM YOURS TIDES
    if test -L "$2" && ! test -e "$2"; then
        problem "$2 is a link to $(readlink "$2"), which is gone, so $1 uses tide's config: remove the link, or put the file back"
    fi
    if ! test -e "$2" && ! test -e "$3"; then
        problem "$1 has no config, neither $2 nor tide's $3, so it can't start: run \`make install\` in tide, as its installer does"
    fi
}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
config_check hypridle "$config_home/hypr/hypridle.conf" "$config_home/hypr/tide-hypridle.conf"
config_check "the lock's fallback, hyprlock," "$config_home/hypr/hyprlock.conf" "$config_home/hypr/tide-hyprlock.conf"

# The home workspace (SPEC.md §6.5): the shell writes its name to
# tide-workspaces.lua, and conf's hyprland.lua makes it persistent; on
# tidewm, which reads no such file, the shell keeps it itself, with
# `persist workspace`. Without either, home can vanish when left empty and
# its apps open where you are. The name is read as the shell writes it
# (`    home = "NAME",`), and compared with Hyprland's after undoing each
# one's escapes of " and \.
workspaces_lua=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/tide-workspaces.lua
unescape() {
    printf '%s' "$1" | sed 's/\\\(.\)/\1/g'
}
# Whether tidewm keeps home, $1, as a problem if it doesn't.
home_on_tidewm() {
    if ! command -v tide-msg >/dev/null 2>&1; then
        return 0
    elif ! command -v jq >/dev/null 2>&1; then
        problem "jq isn't installed, so whether home ($1) is kept isn't checked: install jq (scripts' setup does)"
    elif ! workspaces=$(tide-msg --type get_workspaces 2>&1); then
        problem "$workspaces, so whether home ($1) is kept isn't known: is tidewm running?"
    elif ! persistent=$(printf '%s' "$workspaces" | jq -r --arg home "$1" \
            'map(select(.name == $home)) | if length == 0 then "missing" else (.[0].persistent | tostring) end' 2>&1); then
        problem "couldn't read tidewm's workspaces ($persistent), so whether home ($1) is kept isn't known"
    else
        case "$persistent" in
            true) ;;
            missing) problem "there's no home workspace ($1), so its apps open where you are: \`systemctl --user restart tide.service\`, whose shell makes it" ;;
            *) problem "home ($1) isn't persistent, so it goes when it's left empty: \`systemctl --user restart tide.service\`, whose shell keeps it" ;;
        esac
    fi
}
if ! test -e "$workspaces_lua"; then
    problem "no $workspaces_lua, so conf doesn't know which workspace is home: is tide's shell running? It writes the file as it starts"
elif ! home_line=$(grep -m 1 '^    home = ".*",$' "$workspaces_lua" 2>&1) || test -z "$home_line"; then
    problem "couldn't read home's name from $workspaces_lua${home_line:+ ($home_line)}: restart tide's shell, which writes it"
else
    home_ws=${home_line#    home = \"}
    home_ws=$(unescape "${home_ws%\",}")
    if test "$compositor" = tidewm; then
        home_on_tidewm "$home_ws"
    elif ! workspaces=$(hyprctl -j workspaces 2>&1); then
        problem "hyprctl workspaces failed ($workspaces), so whether home ($home_ws) is kept isn't known"
    else
        # Each workspace's name, then whether it's persistent, as one line.
        persistent=$(printf '%s\n' "$workspaces" | awk '
            /^[[:space:]]*"name": "/ { name = $0; sub(/^[[:space:]]*"name": "/, "", name); sub(/",[[:space:]]*$/, "", name) }
            /^[[:space:]]*"ispersistent": / { p = $0; sub(/^[[:space:]]*"ispersistent": /, "", p); sub(/,.*/, "", p); print p "\t" name }
        ' | while IFS="$(printf '\t')" read -r p name; do
            if test "$(unescape "$name")" = "$home_ws"; then
                echo "$p"
            fi
        done)
        case "$persistent" in
            true*) ;;
            false*) problem "home ($home_ws) isn't persistent, so it goes when it's left empty and its apps' rules may be missing: update conf, whose hyprland.lua keeps it, then hyprctl reload" ;;
            *) problem "there's no home workspace ($home_ws), so its apps open where you are: update conf, whose hyprland.lua makes it, then hyprctl reload" ;;
        esac
    fi
fi

# XDG autostart. systemd's xdg-autostart generator turns each entry into an
# app-*@autostart.service and applies the spec's rules itself (OnlyShowIn,
# NotShowIn, Hidden, TryExec, Type, X-systemd-skip and the rest); an entry
# that shouldn't run here is skipped, or stopped by its ExecCondition before
# its command starts. So ask systemd which units started their command this
# session: an ExecMainStartTimestampMonotonic after the session began,
# whether the command is still running, failed, or ran and exited.
autostart_ran() {
    # On failure it prints systemctl's error instead, and returns false.
    if ! names=$(systemctl --user list-units --all --plain --no-legend 'app-*@autostart.service' 2>&1); then
        printf '%s' "$names"
        return 1
    fi
    names=$(printf '%s\n' "$names" | awk 'NF { print $1 }')
    test -n "$names" || return 0
    # The user manager can outlive a login (lingering), so a unit counts only
    # if it started after this session's graphical-session.target did.
    if ! since=$(systemctl --user show -p ActiveEnterTimestampMonotonic --value graphical-session.target 2>&1); then
        printf '%s' "$since"
        return 1
    fi
    # shellcheck disable=SC2086  # one unit name per word
    if ! shown=$(systemctl --user show -p Id -p ExecMainStartTimestampMonotonic -- $names 2>&1); then
        printf '%s' "$shown"
        return 1
    fi
    # One blank-line-separated record per unit, its properties in whatever
    # order systemctl gives them, as `tide autostart-sweep` reads them.
    printf '%s\n' "$shown" | awk -v since="${since:-0}" '
        BEGIN { RS = ""; FS = "\n" }
        {
            id = ""; start = 0
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^Id=/) id = substr($i, 4)
                if ($i ~ /^ExecMainStartTimestampMonotonic=/) start = substr($i, 33) + 0
            }
            if (id != "" && start > 0 && start >= since + 0) print id
        }
    '
}
if ! ran=$(autostart_ran); then
    problem "systemctl couldn't read the autostart units ($ran), so the autostart check is incomplete"
else
    # Installed beside this script; $TIDE_CMD is for tests.
    qs=${TIDE_CMD:-$(dirname "$0")/tide}
    for unit in $ran; do
        # Exit 1 is "not allowed", whose message is meant for the unit's
        # journal; anything else means the check itself failed.
        err=$(sh "$qs" autostart-allowed "$unit" 2>&1 >/dev/null)
        case $? in
            0) ;;
            1) problem "autostart unit $unit ran in tide but isn't on the autostart allowlist: run tide's make install, whose app-.service.d drop-in skips it, then systemctl --user daemon-reload, then systemctl --user stop '$unit' (or add its desktop ID to ~/.config/tide/autostart to allow it)" ;;
            *) problem "couldn't check autostart unit $unit against the allowlist (${err:-$qs failed}), so the autostart check is incomplete" ;;
        esac
    done
fi

if test "$problems" -gt 0; then
    exit 1
fi
echo "No problems found."
