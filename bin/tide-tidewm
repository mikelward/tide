#!/bin/sh
# The compositor command for tide's tidewm session (SPEC.md §5.3), an
# option beside tide-hyprland, which stays the default.
# uwsm names a session after its compositor command, so starting tidewm
# through this wrapper gives the session its own target,
# wayland-session@tide-tidewm.target, which tide's units hang off as they
# do the Hyprland session's.
# tidewm runs its -s command once its Wayland socket and its IPC are up,
# so that's where `uwsm finalize` goes, as Hyprland's one exec-once: it
# hands WAYLAND_DISPLAY, DISPLAY and tidewm's IPC socket, SWAYSOCK, to
# the session's units, and tells uwsm the compositor is ready.
# Before that, it goes to home (§6.5) and keeps it, as Hyprland's session
# starts there: tidewm itself starts on workspace 1, which goes once it's
# left empty. Home's name is the one tide's shell last wrote for conf's
# hyprland.lua, or `in` before the shell has run, and the shell keeps home
# from then on (shell/WorkspacesData.qml). A name can't hold a quote
# (§6.5), so it goes inside single quotes whole, and one with a `;`, which
# would end tidewm's command, inside double quotes there too, as tidewm
# reads a quoted name. One that does hold a quote is left to the shell,
# which says why.
# The input method's variables (SPEC.md §8.6) go to the compositor, so
# every app it starts has them, not only those started after
# tide-fcitx5.service. Where fcitx5 isn't installed, or TIDE_IME=0, they're
# left as they were.
# Each step says what it does, to stderr and to the journal (`journalctl
# -b -t tide-tidewm`), so a login that never shows a desktop says how far
# it got: started, tidewm up, then uwsm told.
say() {
    echo "tide-tidewm: $*" >&2
    # The journal is the log: a logger that fails has nowhere to say so.
    logger -t tide-tidewm -- "$*" 2>/dev/null || :
}
say "starting the tide (tidewm) session"
if test "${TIDE_IME:-}" != 0 && command -v fcitx5 >/dev/null 2>&1; then
    export QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
fi
home=in
lua=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/tide-workspaces.lua
if line=$(grep -m 1 '^    home = ".*",$' "$lua" 2>/dev/null); then
    line=${line#    home = \"}
    home=${line%\",}
fi
start='exec uwsm finalize SWAYSOCK'
case $home in
    *\"* | *\'* | '') ;;
    *)
        word=$home
        case $home in
            *\;*) word="\"$home\"" ;;
        esac
        start="tide-msg 'workspace number $word; persist workspace $word'; $start"
        ;;
esac
# Without a config of your own, tide's, which `make install` puts beside
# where yours would be (tidewm/tide.conf). A -c given here wins.
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/tidewm
given=no
for arg; do
    case $arg in -c) given=yes ;; esac
done
if test "$given" = no && ! test -e "$config_dir/config" && ! test -e "$HOME/.config/tidewm/config" \
    && test -f "$config_dir/tide.conf"; then
    set -- -c "$config_dir/tide.conf" "$@"
fi
# The startup command logs first, as that's the first sign tidewm is up.
start="logger -t tide-tidewm -- 'tidewm is up; going home and telling uwsm the session is ready' 2>/dev/null; $start"
say "starting tidewm, home $home: $*"
exec tidewm -s "$start" "$@"
