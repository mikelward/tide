#!/bin/sh
#
# The compositor command for the tide session (SPEC.md §5.3).
#
# uwsm names a session after its compositor command, so starting Hyprland
# through this wrapper gives the session its own target,
# wayland-session@tide\x2dhyprland.target (uwsm escapes the - in a unit
# name). tide's units hang off that target, so a plain Hyprland login, or
# Plasma, never starts them.
#
# Hyprland 0.53 and later start through start-hyprland, a watchdog that
# restarts a crashed Hyprland in safe mode; without it, Hyprland warns at
# every login. An older install without it still gets Hyprland directly.
# The input method's variables (SPEC.md §8.6) go to the compositor, so
# every app it starts has them, not only those started after
# tide-fcitx5.service. Where fcitx5 isn't installed, or TIDE_IME=0, they're
# left as they were.
# Each step says what it does, to stderr and to the journal (`journalctl
# -b -t tide-hyprland`), so a login that never shows a desktop says how far
# it got.
say() {
    echo "tide-hyprland: $*" >&2
    # The journal is the log: a logger that fails has nowhere to say so.
    logger -t tide-hyprland -- "$*" 2>/dev/null || :
}
say "starting the tide session"
if test "${TIDE_IME:-}" != 0 && command -v fcitx5 >/dev/null 2>&1; then
    export QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
fi
# tide's session config, session.lua, which `make install` puts beside
# tide's hyprland.lua (SPEC.md §6.8): tide's, with your hyprland.lua's
# options over its defaults, then the settings pages', then
# hyprland.local.lua. So a hyprland.lua of yours that's missing, broken or
# never loads tide's still leaves tide's keys and the pages' settings.
# TIDE_HYPRLAND_CONFIG names another; a --config given here wins over
# both. An install from before session.lua runs as it did: yours, or
# tide's hyprland.lua without one.
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
given=no
for arg in "$@"; do
    case $arg in -c | --config | --config=*) given=yes ;; esac
done
if test "$given" = yes; then
    :
elif test -n "${TIDE_HYPRLAND_CONFIG:-}"; then
    set -- --config "$TIDE_HYPRLAND_CONFIG" "$@"
elif test -f "$HOME/.config/hypr/tide/session.lua"; then
    set -- --config "$HOME/.config/hypr/tide/session.lua" "$@"
    # Hyprland's hyprland.conf, an old one left behind, isn't Lua, so the
    # session can't take options from it.
    if ! test -e "$config_home/hypr/hyprland.lua" && test -e "$config_home/hypr/hyprland.conf"; then
        say "$config_home/hypr/hyprland.conf isn't read in tide's session: give your options in a hyprland.lua, or move it away"
    fi
elif ! test -e "$config_home/hypr/hyprland.lua" && ! test -e "$config_home/hypr/hyprland.conf" \
    && test -f "$HOME/.config/hypr/tide/hyprland.lua"; then
    say "no $HOME/.config/hypr/tide/session.lua: run tide's make install"
    set -- --config "$HOME/.config/hypr/tide/hyprland.lua" "$@"
else
    say "no $HOME/.config/hypr/tide/session.lua: run tide's make install"
    # A config of your own is Hyprland's, and tide's keys and layout come
    # only if it loads tide's. One that never names tide, as an old
    # hyprland.conf left behind does, gives a session without them, so the
    # journal says which file it was.
    for own in "$config_home/hypr/hyprland.lua" "$config_home/hypr/hyprland.conf"; do
        test -e "$own" || continue
        if ! grep -q tide "$own" 2>/dev/null; then
            say "$own is your own Hyprland config and doesn't load tide's, so this session has no tide keys or layout: load ~/.config/hypr/tide/hyprland.lua from it, or move it away"
        fi
        break
    done
fi
# tide's config needs Hyprland 0.56.2 or later. An older one starts without
# it, with Hyprland's own banner and no tide keys or bar, which is no way to
# leave someone (SPEC.md §5.3). So the session refuses, saying why, and the
# login screen comes back. A Hyprland whose version can't be read is
# started as before.
min_hyprland=0.56.2
version=$(Hyprland --version 2>/dev/null | sed -n 's/^Hyprland \([0-9][0-9.]*\).*/\1/p' | head -n 1)
if test -n "$version" \
    && test "$(printf '%s\n%s\n' "$min_hyprland" "$version" | sort -V | head -n 1)" != "$min_hyprland"; then
    say "tide needs Hyprland $min_hyprland or later, and this is $version: run tide-setup again, or log in to tide (tidewm) or another session"
    exit 1
fi
if command -v start-hyprland >/dev/null 2>&1; then
    say "starting Hyprland ${version:-of unknown version} through start-hyprland: $*"
    exec start-hyprland -- "$@"
fi
say "starting Hyprland ${version:-of unknown version}: $*"
exec Hyprland "$@"
