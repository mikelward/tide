#!/bin/sh
#
# The compositor command for the tide session (SPEC.md §5.3).
#
# uwsm names a session after its compositor command, so starting Hyprland
# through this wrapper gives the session its own target,
# wayland-session@tide-hyprland.target. tide's units hang off that
# target, so a plain Hyprland login, or Plasma, never starts them.
#
# Hyprland 0.53 and later start through start-hyprland, a watchdog that
# restarts a crashed Hyprland in safe mode; without it, Hyprland warns at
# every login. An older install without it still gets Hyprland directly.
# The input method's variables (SPEC.md §8.6) go to the compositor, so
# every app it starts has them, not only those started after
# tide-fcitx5.service. Where fcitx5 isn't installed, or TIDE_IME=0, they're
# left as they were.
if test "${TIDE_IME:-}" != 0 && command -v fcitx5 >/dev/null 2>&1; then
    export QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
fi
# Without a Hyprland config of your own, tide's default, which `make
# install` puts beside the layout (SPEC.md §6). TIDE_HYPRLAND_CONFIG names
# another; a --config given here wins over both.
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
given=no
for arg in "$@"; do
    case $arg in -c | --config | --config=*) given=yes ;; esac
done
if test "$given" = yes; then
    :
elif test -n "${TIDE_HYPRLAND_CONFIG:-}"; then
    set -- --config "$TIDE_HYPRLAND_CONFIG" "$@"
elif ! test -e "$config_home/hypr/hyprland.lua" && ! test -e "$config_home/hypr/hyprland.conf" \
    && test -f "$HOME/.config/hypr/tide/hyprland.lua"; then
    set -- --config "$HOME/.config/hypr/tide/hyprland.lua" "$@"
fi
if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland -- "$@"
fi
exec Hyprland "$@"
