{
  "manifest_version": 3,
  "name": "tide connector",
  "version": "1",
  "description": "Lists your browser tabs in the window switcher of tide, a Linux desktop, so you can find and switch to any tab.",
  "minimum_chrome_version": "105",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/tide-16.png",
    "32": "icons/tide-32.png",
    "48": "icons/tide-48.png",
    "128": "icons/tide-128.png"
  },
  "action": {
    "default_title": "tide connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tide-16.png",
      "32": "icons/tide-32.png"
    }
  }
}
