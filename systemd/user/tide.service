# The tide shell: bar, launcher, notifications, tray watcher and polkit
# agent (SPEC.md §5.2-§5.4). Until the Quickshell shell exists, tide-shell
# runs the transitional owners (the bar, swaync, a polkit agent); see TODO.md.
[Unit]
Description=tide shell
Documentation=https://github.com/mikelward/tide
# Scoped to the tide session. Plasma reaches graphical-session.target
# too, so this is never WantedBy= that.
PartOf=graphical-session.target
After=wayland-session@tide-hyprland.target wayland-session@tide-tidewm.target graphical-session.target
# hypridle owns org.freedesktop.ScreenSaver, which apps must find already
# owned. Wants=, not Requires=: without hypridle the shell still starts, and
# `tide doctor` reports it.
Wants=hypridle.service
After=hypridle.service
# The owners the shell hosts exist before any autostarted app.
Before=xdg-desktop-autostart.target
# A shell that can't run leaves a session with nothing on it, so once it has
# failed for good a terminal says why and how to log out (SPEC.md §5.2).
OnFailure=tide-shell-fallback.service
# For good is three failed starts in two minutes. A start that hangs fails
# at TimeoutStartSec and is restarted; with systemd's default limit, five
# in ten seconds, 15-second hangs would restart forever and never fall back.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
# Ready only once the shell reports that every owner it hosts is up
# (notifications, tray watcher), not when qs merely starts. The polkit agent
# isn't waited for: another may hold the session, and the shell retries it
# alone (SPEC.md §5.2, §5.4).
Type=notify
NotifyAccess=all
ExecStart=tide-shell
# Once the shell is up to show it, a notification says if idle and suspend
# won't lock, as when hypridle was skipped (SPEC.md §10). It never fails
# the shell.
ExecStartPost=-tide lock-check
# Autostart units left running from an earlier login, when the user
# manager outlived it, never met the allowlist; those it skips stop now
# (SPEC.md §5.4). It never fails the shell either.
ExecStartPost=-tide autostart-sweep
TimeoutStartSec=15
# A stop is a kill of the unit's cgroup: tide-shell has nothing to tidy up.
# graphical-session.target stays active until this has stopped, and uwsm
# won't start a session while it is, so a process slow to die, at systemd's
# 90 s default, bounced a login straight after a logout back to the login
# screen. After 5 s what's left is killed.
TimeoutStopSec=5
Restart=on-failure
RestartSec=1
# A restart skips the failed state, so OnFailure= opens the fallback only
# once the start limit gives up, not for a failure the next start recovers
# from (systemd 254).
RestartMode=direct
# tide-shell exits 78 (EX_CONFIG) for a bad setting or a missing piece,
# which a restart can't fix.
RestartPreventExitStatus=78
Slice=session-graphical.slice

[Install]
# Either tide session: Hyprland's, or tidewm's (SPEC.md §5.3).
WantedBy=wayland-session@tide-hyprland.target wayland-session@tide-tidewm.target
