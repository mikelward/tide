# fcitx5, the input method behind accents on a held letter (SPEC.md §8.6):
# tide-accents, tide's own add-on (fcitx5/), which `setup-tide` builds. Once fcitx5 owns
# its bus name, units and autostarted apps get the variables that point Qt
# and X11 apps at it; the compositor's wrapper sets them for the apps it
# starts. GTK apps and Wayland Qt apps reach it without them, through the
# compositor's text-input protocol.
[Unit]
Description=tide input method (fcitx5)
Documentation=https://github.com/mikelward/tide
# Scoped to the tide session. Plasma reaches graphical-session.target too,
# and runs its own input method, so this is never WantedBy= that.
PartOf=graphical-session.target
After=wayland-session@tide-hyprland.target wayland-session@tide-tidewm.target graphical-session.target
# Before autostarted apps, so they start with its variables: the target
# here, and each app's service through tide-autostart.conf's After=.
Before=xdg-desktop-autostart.target
# TIDE_IME=0 in the session's environment turns it off.
ConditionEnvironment=!TIDE_IME=0

[Service]
# Ready once it owns its name on the session bus.
Type=dbus
BusName=org.fcitx.Fcitx5
# Skipped, not failed, where fcitx5 isn't installed.
ExecCondition=/bin/sh -c 'command -v fcitx5 >/dev/null'
ExecStart=fcitx5 --replace
ExecStartPost=systemctl --user set-environment QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
ExecStopPost=systemctl --user unset-environment QT_IM_MODULE XMODIFIERS
Restart=on-failure
RestartSec=1
Slice=session-graphical.slice

[Install]
# Either tide session: Hyprland's, or tidewm's (SPEC.md §5.3).
WantedBy=wayland-session@tide-hyprland.target wayland-session@tide-tidewm.target
