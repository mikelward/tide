# The clipboard history behind the picker on Super+V (SPEC.md §8.4): each
# new copy goes to `tide clipboard store`, which keeps it encrypted, and
# skips one a password manager marks.
[Unit]
Description=tide clipboard history
Documentation=https://github.com/mikelward/tide
# Scoped to the tide session. Plasma reaches graphical-session.target
# too, so this is never WantedBy= that.
PartOf=graphical-session.target
After=wayland-session@tide\x2dhyprland.target wayland-session@tide\x2dtidewm.target graphical-session.target

[Service]
# The clipboard only, not the primary selection (middle-click).
ExecStart=wl-paste --watch tide clipboard store --max-items 100
# Anything it writes is yours alone.
UMask=0077
Restart=on-failure
RestartSec=1
# As tide.service: graphical-session.target stays active until this has
# stopped, and the next login waits on that, so it gets 5 s, not 90.
TimeoutStopSec=5
Slice=background-graphical.slice

[Install]
# Either tide session: Hyprland's, or tidewm's (SPEC.md §5.3).
WantedBy=wayland-session@tide\x2dhyprland.target wayland-session@tide\x2dtidewm.target
